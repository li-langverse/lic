def echem_neb_max_image_energy_ev() -> float
  requires true
  ensures result >= echem_neb_image_energy_ev_at(0)
  decreases 0
=
  var e_max: float = echem_neb_image_energy_ev_at(0)
  var i: int = 1
  while i < echem_neb_image_count()
    var e_i: float = echem_neb_image_energy_ev_at(i)
    if e_i > e_max:
      e_max = e_i
    i = i + 1
  return e_max

def echem_neb_endpoint_min_ev() -> float
  requires true
