type CsvRow = object
  public field_count: int

type CsvTable = object
  public row_count: int
  public col_count: int

def csv_tag() -> int
  requires true
  ensures result == 6
  decreases 0
=
  return 6

def csv_parse_row_stub(line: str) raises Alloc -> CsvRow
  requires true
  ensures result.field_count == 0
  decreases 0
=
  var r: CsvRow
  r.field_count = 0
  return r

# PH-IO-4 — fixed-width row witness for ingest composables (closed VC).
def csv_parse_row_three_col() raises Alloc -> CsvRow
  requires true
  ensures result.field_count == 3
  decreases 0
=
  var r: CsvRow
  r.field_count = 3
  return r

# PH-IO-4 — field-count stub for benchmark CSV ingest (fixed witness).
