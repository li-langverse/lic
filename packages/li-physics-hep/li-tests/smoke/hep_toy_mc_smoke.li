import physics.hep

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_physics_hep_version() < 2:
    return 1
  if hep_toy_cross_section_smoke() != 1:
    return 2
  var br: float = decay_branching(1, 2)
  if br <= 0.0:
    return 3
  if br > 1.0:
    return 4
  return 0
