def ui_snapshot_role_from_widget_kind(kind: int) -> int
  requires kind >= widget_kind_none()
  requires kind <= widget_kind_text_input()
  ensures result >= ui_snapshot_role_none()
  ensures result <= ui_snapshot_role_input()
  decreases kind
=
  if kind == widget_kind_button():
    return ui_snapshot_role_button()
  if kind == widget_kind_label():
    return ui_snapshot_role_label()
  if kind == widget_kind_panel():
    return ui_snapshot_role_panel()
  if kind == widget_kind_text_input():
    return ui_snapshot_role_input()
  return ui_snapshot_role_none()

def ui_element_make(id_tag: int, role: int, bounds: Rect, enabled: int, focused: int, child_count: int) -> UiElement
  requires role >= ui_snapshot_role_none()
  requires role <= ui_snapshot_role_input()
  requires enabled >= 0
  requires enabled <= 1
  requires focused >= 0
  requires focused <= 1
  requires child_count >= 0
  ensures result.id_tag == id_tag
  ensures result.role == role
  ensures result.bounds == bounds
  decreases child_count
=
  var out: UiElement
  out.id_tag = id_tag
  out.role = role
  out.bounds = bounds
  out.enabled = enabled
  out.focused = focused
  out.child_count = child_count
  return out

def ui_snapshot_empty(frame_id: int, profile_id: int, width: int, height: int) -> UiSnapshot
  requires frame_id >= 0
  requires width >= 0
  requires height >= 0
  ensures result.element_count == 0
  ensures result.frame_id == frame_id
  ensures result.profile_id == profile_id
  decreases frame_id
=
  var out: UiSnapshot
  out.frame_id = frame_id
  out.profile_id = profile_id
  out.width = width
  out.height = height
  out.element_count = 0
  return out

def ui_snapshot_element_tag_at(snap: UiSnapshot, at: int) -> int
  requires at >= 0
  requires at < ui_snapshot_max_elements()
  ensures result >= 0
  decreases at
=
  if at == 0:
    return snap.tag0
  if at == 1:
    return snap.tag1
  if at == 2:
    return snap.tag2
  if at == 3:
    return snap.tag3
  if at == 4:
    return snap.tag4
  if at == 5:
    return snap.tag5
  if at == 6:
    return snap.tag6
  if at == 7:
    return snap.tag7
  if at == 8:
    return snap.tag8
  if at == 9:
    return snap.tag9
  if at == 10:
    return snap.tag10
  if at == 11:
    return snap.tag11
  if at == 12:
    return snap.tag12
  if at == 13:
    return snap.tag13
  if at == 14:
    return snap.tag14
  if at == 15:
    return snap.tag15
  if at == 16:
    return snap.tag16
  if at == 17:
    return snap.tag17
  if at == 18:
    return snap.tag18
  if at == 19:
    return snap.tag19
  if at == 20:
    return snap.tag20
  if at == 21:
    return snap.tag21
  if at == 22:
    return snap.tag22
  if at == 23:
    return snap.tag23
  return 0

def ui_snapshot_element_bounds_at(snap: UiSnapshot, at: int) -> Rect
  requires at >= 0
  requires at < snap.element_count
  ensures result.w >= 0.0
  decreases at
=
  if at == 0:
    return snap.bounds0
