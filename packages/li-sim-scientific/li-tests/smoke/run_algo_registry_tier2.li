import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  # WP-SCI-03 CFD/FEA/QM tier-2 rows — verify immediately after each run (host oracle isolation).
  var cfd206: SimRunResult = run_algo(206, 1)
  if run_result_ok(cfd206) != 1:
    return 1
  if cfd206.algo_id != 206:
    return 2
  if cfd206.checksum != sim_scientific_oracle_checksum_cfd():
    return 3
  if cfd206.checksum == 1.001:
    return 4
  var fea214: SimRunResult = run_algo(214, 0)
  if run_result_ok(fea214) != 1:
    return 5
  if fea214.algo_id != 214:
    return 6
  if fea214.checksum != sim_scientific_oracle_checksum_fea():
    return 7
  if fea214.checksum == 1.001:
    return 8
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 9
  if qm418.checksum != sim_scientific_oracle_checksum_qm():
    return 10
  if qm418.checksum == 1.001:
    return 11
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 12
  if md105.algo_id != 105:
    return 13
  if md105.checksum == 1.001:
    return 14
  var heat202: SimRunResult = run_algo(202, 2)
  if run_result_ok(heat202) != 1:
    return 15
  if heat202.algo_id != 202:
    return 16
  if heat202.checksum == 1.001:
    return 17
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 18
  if rigid302.algo_id != 302:
    return 19
  if rigid302.checksum == 1.001:
    return 20
  var drug501: SimRunResult = run_algo(501, 0)
  if run_result_ok(drug501) != 1:
    return 21
  if drug501.checksum != 1.001:
    return 22
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 23
  if aimd433.algo_id != 433:
    return 24
  if aimd433.checksum != sim_scientific_oracle_checksum_echem_aimd():
    return 25
  if aimd433.checksum == 1.001:
    return 26
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 27
  if gc434.algo_id != 434:
    return 28
  if gc434.checksum != sim_scientific_oracle_checksum_echem_gc_aimd():
    return 29
  if gc434.checksum == 1.001:
    return 30
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 31
  if sei435.algo_id != 435:
    return 32
  if sei435.checksum != sim_scientific_oracle_checksum_echem_sei_kmc():
    return 33
  if sei435.checksum == 1.001:
    return 34
  return 0
