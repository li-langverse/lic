# PH-SCI-GPU-01: @gpu numerics vertical — MD oracle via sim.scientific until math.numerics lib build unblocks.
import sim.scientific

@gpu
def numerics_gpu_three_body_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var md: float = sim_scientific_oracle_checksum_md()
  if md <= 0.0:
    return 0
  if md >= 1.0e-3:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if numerics_gpu_three_body_smoke() != 1:
    return 1
  return 0
