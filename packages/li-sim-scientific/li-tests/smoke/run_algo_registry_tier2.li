import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  var md_chk: float = sim_scientific_oracle_checksum_md()
  if md105.ok != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != md_chk:
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat201: SimRunResult = run_algo(201, 2)
  var heat_chk: float = sim_scientific_oracle_checksum_heat()
  if heat201.ok != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat201.checksum != heat_chk:
    return 7
  if heat201.checksum == 1.001:
    return 8
  var rigid302: SimRunResult = run_algo(302, 0)
  if rigid302.ok != 1:
    return 9
  if rigid302.algo_id != 302:
    return 10
  if rigid302.checksum == 1.001:
    return 11
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if qm418.ok != 1:
    return 12
  if qm418.checksum != 1.001:
    return 13
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  var echem_chk: float = sim_scientific_oracle_checksum_echem_aimd()
  if echem_chk <= 0.0:
    return 14
  if echem_chk >= 1.0e-2:
    return 15
  if aimd433.ok != 1:
    return 16
  if aimd433.algo_id != 433:
    return 17
  if aimd433.checksum != echem_chk:
    return 18
  if aimd433.checksum == 1.001:
    return 19
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  var gc_chk: float = sim_scientific_oracle_checksum_echem_gc_aimd()
  if gc_chk <= 0.0:
    return 20
  if gc_chk >= 0.05:
    return 21
  if gc434.ok != 1:
    return 22
  if gc434.algo_id != 434:
    return 23
  if gc434.checksum != gc_chk:
    return 24
  if gc434.checksum == 1.001:
    return 25
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  var sei_chk: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  if sei_chk <= 0.0:
    return 26
  if sei_chk >= 0.35:
    return 27
  if sei435.ok != 1:
    return 28
  if sei435.algo_id != 435:
    return 29
  if sei435.checksum != sei_chk:
    return 30
  if sei435.checksum == 1.001:
    return 31
  return 0
