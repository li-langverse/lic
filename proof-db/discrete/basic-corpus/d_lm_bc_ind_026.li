# D-LM-BC-IND-026: Induction on divisibility: 3 divides 4^n - 1 for all n >= 1.

def induction_step(n: int, step: int) -> int
  requires n >= 0 and step >= 0
  ensures result == n + step
  decreases 0
=
  return n + step

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
