import physics.quantum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_physics_quantum_version() != 3:
    return 1
  if qm_scf_h2_bond_length_ang() != 0.74:
    return 2
  if qm_scf_h2_stub_smoke() != 1:
    return 3
  var stub: QmScfH2StubResult = qm_scf_h2_stub_energy()
  if stub.energy_hartree >= 0.0:
    return 4
  if stub.scf_iterations < 1:
    return 5
  return 0
