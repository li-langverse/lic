# PH-SCI-GPU-11: @gpu scientific viz pipeline step loop.
import sim.viz

@gpu
def viz_gpu_pipeline_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var s: VizPipelineState = viz_pipeline_init()
  s = viz_pipeline_scientific_step(s, 16)
  if viz_pipeline_viewport_ok(s, 1, 1000) != 1:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if viz_gpu_pipeline_smoke() != 1:
    return 1
  return 0
