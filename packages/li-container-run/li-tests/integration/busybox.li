# WP-CTN-090 — busybox OCI integration (gated on LI_CONTAINER_INTEGRATION=1 + Linux).

import container
import container.seam

def integration_enabled() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return container_env_is_i("LI_CONTAINER_INTEGRATION", "1")

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if integration_enabled() != 1:
    return 0
  if container_is_linux_i() != 1:
    return 0
  # Full busybox OCI cycle: scripts/test-lirun-integration.sh (requires built lirun + CAP_SYS_ADMIN).
  return 0
