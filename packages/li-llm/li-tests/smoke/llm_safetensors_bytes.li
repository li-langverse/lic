import llm

def main() -> int raises IO, Alloc
  requires true
  ensures result == 0
  decreases 0
=
  var p0: str = "fixtures/model.safetensors"
  var b0: int = llm_safetensors_tensor_bytes_scaffold(p0, 0)
  var p1: str = "fixtures/model.safetensors"
  var b1: int = llm_safetensors_tensor_bytes_scaffold(p1, 1)
  if b0 <= 0 or b1 <= 0:
    return 1
  var p2: str = "fixtures/model.safetensors"
  var hdr: LlmSafetensorsHeader = llm_safetensors_load_tensors_scaffold(p2)
  if hdr.tensor_bytes_read != 128:
    return 2
  return 0
