FROM python:3.12-alpine AS gen
WORKDIR /src
COPY test/proxy-repro/gen-asset.py /src/gen-asset.py
RUN python3 /src/gen-asset.py --out-dir /srv/www

FROM nginx:1.27-alpine
COPY test/proxy-repro/backend/nginx-peer-a.conf /etc/nginx/nginx.conf
COPY --from=gen /srv/www /srv/www
RUN echo 'peer-a-body' >/srv/www/probe
