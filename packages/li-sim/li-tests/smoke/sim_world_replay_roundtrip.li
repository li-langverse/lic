import sim

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var sess: SimSessionStub = sim_session_stub_default()
  sess.game_px = 1.5
  sess.game_py = 2.0
  sess.game_pz = 0.25
  sess.game_vx = 0.1
  sess.game_vy = -0.2
  sess.game_vz = 0.05
  sim_world_snapshot_record(sess)
  var chk0: float = sim_world_snapshot_checksum(sess)
  if chk0 <= 0.0:
    return 1
  sess.game_px = 0.0
  sess.game_py = 0.0
  sim_world_snapshot_restore(sess)
  if sess.game_px != 1.5:
    return 2
  if sess.game_py != 2.0:
    return 3
  if sim_world_snapshot_checksum(sess) != chk0:
    return 4
  return 0
