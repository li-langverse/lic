import array

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var buf: array[64, float]
  buf[0] = 1.0
  buf[1] = 2.0
  buf[2] = 3.0
  buf[3] = 4.0
  var desc: ArrayDesc = array_desc_1d(4, array_storage_flat())
  var s: float = array_sum(desc, buf)
  if s < 9.9 or s > 10.1:
    return 1
  return 0
