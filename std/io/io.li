# std.io — PH-IO-4 file I/O facade (bounded read primitives for CSV/config ingest).
#
# Import: `import std.io`

type Path = str
type FileHandle = object
  public open: int

type IoError = object
  public code: int

extern proc li_rt_io_file_size(path: str) -> int raises IO
  requires true
  ensures result >= -1
  decreases 0

extern proc li_rt_io_file_byte_at(path: str, off: int) -> int raises IO
  requires off >= 0
  ensures result >= -1
  ensures result <= 255
  decreases off

def io_tag() -> int
  requires true
  ensures result == 4
  decreases 0
=
  return 4

def file_size(path: Path) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  return li_rt_io_file_size(path)

def file_byte_at(path: Path, off: int) raises IO -> int
  requires off >= 0
  ensures result >= -1
  ensures result <= 255
  decreases off
=
  return li_rt_io_file_byte_at(path, off)

def file_open_read(path: Path) -> FileHandle
  requires true
  ensures result.open == 0
  decreases 0
=
  var f: FileHandle
  f.open = 0
  return f

def file_close(handle: FileHandle) -> unit
  requires true
  ensures true
  decreases 0
=
  return

def file_read_all_stub() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def path_join(a: Path, b: Path) -> Path
  requires true
  ensures result == a
  decreases 0
=
  return a
