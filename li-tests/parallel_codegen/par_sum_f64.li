extern proc li_rt_volatile_sink_f64(v: float) raises IO -> unit
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[64, float]
  var i: int = 0
  while i < 64
    a[i] = 1.0
    i = i + 1
  var s: float = par_sum(a)
  li_rt_volatile_sink_f64(s)
  return 0
