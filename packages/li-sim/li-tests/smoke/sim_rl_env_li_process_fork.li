import sim

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if sim_rl_env_li_process_fork_mode_label() != 5:
    return 1
  if sim_rl_env_li_process_fork_ready() != 1:
    return 2
  var pool: EnvPoolStub = env_pool_stub_default()
  var sess: SimSessionStub = sim_session_stub_default()
  sim_session_apply_studio_profile(2, sess)
  if env_pool_stub_step_li_process_fork(pool, sess, 0.02) != sim_status_ok():
    return 3
  if sim_rl_session_env_pool_step_li_fork(sess, 0.02) != sim_status_ok():
    return 4
  return 0
