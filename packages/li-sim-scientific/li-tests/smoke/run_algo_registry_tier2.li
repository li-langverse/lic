import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md_oracle: float = sim_scientific_oracle_checksum_md()
  var heat_oracle: float = sim_scientific_oracle_checksum_heat()
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != md_oracle:
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat201: SimRunResult = run_algo(201, 1)
  if run_result_ok(heat201) != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat201.checksum != heat_oracle:
    return 7
  if heat201.checksum == 1.001:
    return 8
  var cfd206: SimRunResult = run_algo(206, 2)
  if run_result_ok(cfd206) != 1:
    return 9
  if cfd206.algo_id != 206:
    return 10
  var cfd_oracle: float = sim_scientific_oracle_checksum_cfd()
  if cfd206.checksum != cfd_oracle:
    return 11
  if cfd206.checksum == 1.001:
    return 12
  var fea214: SimRunResult = run_algo(214, 1)
  if run_result_ok(fea214) != 1:
    return 18
  if fea214.algo_id != 214:
    return 19
  var fea_oracle: float = sim_scientific_oracle_checksum_fea()
  if fea214.checksum != fea_oracle:
    return 20
  if fea214.checksum == 1.001:
    return 21
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 13
  if rigid302.algo_id != 302:
    return 14
  if rigid302.checksum == 1.001:
    return 15
  var qm_oracle: float = sim_scientific_oracle_checksum_qm()
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 16
  if qm418.algo_id != algo_qm_dft_scf_energy():
    return 22
  if qm418.checksum != qm_oracle:
    return 17
  if qm418.checksum == 1.001:
    return 23
  var drug_oracle: float = sim_scientific_oracle_checksum_drug()
  var drug501: SimRunResult = run_algo(501, 1)
  if run_result_ok(drug501) != 1:
    return 24
  if drug501.algo_id != 501:
    return 25
  if drug501.checksum != drug_oracle:
    return 26
  if drug501.checksum == 1.001:
    return 27
  var robo_oracle: float = sim_scientific_oracle_checksum_robo()
  var robo801: SimRunResult = run_algo(801, 2)
  if run_result_ok(robo801) != 1:
    return 28
  if robo801.algo_id != 801:
    return 29
  if robo801.checksum != robo_oracle:
    return 30
  if robo801.checksum == 1.001:
    return 31
  return 0
