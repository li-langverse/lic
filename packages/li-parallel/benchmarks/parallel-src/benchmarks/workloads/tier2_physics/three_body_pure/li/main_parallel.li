# li-parallel dual-mode entry (WP-PAR-48).
# Harness runs this when LI_PARALLEL=1; runtime pool + C overrides apply parallel execution.

# three_body_pure — shared C oracle (mini three-body; CI-scale steps in core).

extern proc li_three_body_kernel()
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_three_body_kernel()
  return 0
