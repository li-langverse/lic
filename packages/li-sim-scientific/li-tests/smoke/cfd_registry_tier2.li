import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd_chk: float = sim_scientific_oracle_checksum_cfd()
  if cfd_chk <= 0.0:
    return 1
  var cfd206: SimRunResult = run_algo(206, 1)
  if cfd206.ok != 1:
    return 2
  if cfd206.algo_id != 206:
    return 3
  if cfd206.checksum != cfd_chk:
    return 4
  if cfd206.checksum == 1.001:
    return 5
  return 0
