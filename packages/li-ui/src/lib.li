def paint_cmd_draw_image(dest: Rect, image_id: int, src: Rect, tint: Color) -> PaintCmd
  requires dest.w >= 0.0
  requires dest.h >= 0.0
  requires src.w >= 0.0
  requires src.h >= 0.0
  requires image_id >= paint_image_id_none()
  requires image_id <= paint_image_id_max()
  ensures result.kind == paint_op_draw_image()
  ensures result.rect == dest
  ensures result.src_rect == src
  ensures result.image_id == image_id
  ensures result.color == tint
  decreases image_id
=
  var c: PaintCmd
  c.kind = paint_op_draw_image()
  c.rect = dest
  c.color = tint
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  c.face_id = 0
  c.codepoint = 0
  c.glyph_count = 0
  c.image_id = image_id
  c.src_rect = src
  return c

def paint_frame_push_clip_scope(frame: var PaintFrame, clip_rect: Rect) -> unit
  requires frame.cmd_count >= 0
  requires clip_rect.w >= 0.0
  requires clip_rect.h >= 0.0
  ensures frame.cmd_count == old(frame.cmd_count) + 1
  ensures frame.last_kind == paint_op_clip_push()
  decreases 0
=
  paint_frame_push(frame, paint_cmd_clip_push(clip_rect))

def paint_frame_pop_clip_scope(frame: var PaintFrame) -> unit
  requires frame.cmd_count >= 0
  ensures frame.cmd_count == old(frame.cmd_count) + 1
  ensures frame.last_kind == paint_op_clip_pop()
  decreases 0
=
  paint_frame_push(frame, paint_cmd_clip_pop())
# END paint-cmds-ext

def paint_frame_push_elevated_panel(frame: var PaintFrame, rect: Rect) -> unit
  requires frame.cmd_count >= 0
  requires rect.w >= 0.0
  requires rect.h >= 0.0
  ensures frame.cmd_count == old(frame.cmd_count) + 2
  ensures frame.last_kind == paint_op_stroke_round_rect()
  decreases 0
=
  var grad: PaintCmd = paint_cmd_fill_gradient(rect, studio_color_bg_primary(), studio_color_bg_elevated())
  paint_frame_push(frame, grad)
  var border: PaintCmd = paint_cmd_stroke_round(rect, studio_color_border(), 1.0, studio_default_panel_radius_px())
  paint_frame_push(frame, border)

def paint_frame_push_accent_chip(frame: var PaintFrame, rect: Rect, accent: Color) -> unit
  requires frame.cmd_count >= 0
  requires rect.w >= 0.0
  requires rect.h >= 0.0
  ensures frame.cmd_count == old(frame.cmd_count) + 2
  ensures frame.last_kind == paint_op_stroke_round_rect()
  decreases 0
=
  var fill: PaintCmd = paint_cmd_fill_round(rect, accent, studio_radius_sm_px())
  paint_frame_push(frame, fill)
  var ring: PaintCmd = paint_cmd_stroke_round(rect, studio_color_border(), 1.0, studio_radius_sm_px())
  paint_frame_push(frame, ring)

def paint_studio_shell_chrome(frame: var PaintFrame, layout: var StudioShellLayout) -> unit
  requires frame.cmd_count >= 0
  ensures frame.cmd_count >= 1
  decreases 0
=
  # Record aggregate chrome op count; li-gui will expand to fill/stroke/grid per region.
  frame.cmd_count = paint_studio_shell_chrome_count()
  frame.last_kind = paint_op_viewport_grid()
  frame.last_rect = layout.viewport
  frame.last_color = studio_color_accent_cyan()

def paint_studio_shell_chrome_count() -> int
  requires true
  ensures result == 7
  decreases 0
=
  return 7

def paint_studio_shell_chrome_with_palette_count(palette_open: int) -> int
  requires palette_open >= studio_palette_closed_flag()
  requires palette_open <= studio_palette_open_flag()
  ensures result == paint_studio_shell_chrome_count() + paint_studio_palette_count(palette_open)
