# std/execution/decorators.li — reserved execution decorator names (Phase 7d-d)
#
# Users write @cpu, @parallel(disjoint=disjoint_elem), @vectorized on def/for/while.
# The compiler elaborates these at compile time; they are NOT runtime calls.
#
# Reserved (cannot user decorator def): parallel, vectorized, async, cpu, gpu, tpu,
# user_defined, serial, no_vectorize.
#
# Resource knobs (lic build, not decorators):
#   --jobs=N           — parallel compile workers (frontend), not runtime threads
#   --cores=N          — hardware cores for runtime parallel team
#   --threads-per-core=M — logical threads per core (default 1); team = min(N*M, 64)
#   --threads=N        — total runtime team (overrides --cores when both set)
#   @vectorized(lanes=4) — SIMD vector width in one core; never spawns li_parallel_for_i64
#
# OpenMP variant policy (#124 — prescriptive vs descriptive rubric):
#   @cpu(openmp=prescriptive|descriptive|auto|target) — select OpenMP lowering variant
#     prescriptive: explicit teams/target/SIMD directive stacks (competitive on offload)
#     descriptive:  compiler-discovered parallel loops (default host path until #34 IR)
#     auto:         compiler chooses; logs variant under lic build -v (Phase 2 codegen)
#     target:       OpenMP target teams prescriptive stack (#116 offload track)
#   @parallel(schedule=static|auto|dynamic) — schedule hint for prescriptive parallel for
#   Reject: @cpu(openmp=descriptive) on same def as @gpu (offload needs prescriptive/target)
#   li.toml [execution] parallel_style mirrors @cpu(openmp=…); backends = divergent TU fork
#   Spec: docs/superpowers/specs/2026-06-07-li-openmp-prescriptive-descriptive-rubric.md
#
# User decorators must use multi-segment names (e.g. li_math_tiled_parallel).

def __execution_decorators_doc() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
