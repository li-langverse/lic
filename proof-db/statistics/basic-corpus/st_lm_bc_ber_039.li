# ST-LM-BC-BER-039: Bernoulli distribution mean p variance p(1-p) (case 39).

def bernoulli_variance(p: float) -> float
  requires 0.0 <= p and p <= 1.0
  ensures result == p * (1.0 - p)
  decreases 0
=
  return p * (1.0 - p)

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
