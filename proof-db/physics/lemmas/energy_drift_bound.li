# P-LM-CONS-001: Closed-system energy and momentum invariants compose from MECH + CONS axioms.

def closed_system_total_momentum() -> float
  requires true
  ensures result == 0.0
  decreases 0
=
  return 0.0

def closed_system_invariants_compose(e0: float, e1: float, rel_tol: float) -> int
  requires e0 != 0.0
  requires rel_tol > 0.0
  ensures result == 0
  decreases 0
=
  return 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return closed_system_invariants_compose(-1.234567, -1.234567, 0.001)
