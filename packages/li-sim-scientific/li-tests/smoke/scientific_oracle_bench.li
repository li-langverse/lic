import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  if sim_scientific_oracle_checksum_md() <= 0.0:
    return 2
  if sim_scientific_oracle_checksum_md() >= 1.0e-3:
    return 3
  if sim_scientific_oracle_checksum_heat() <= 1.0:
    return 4
  if sim_scientific_oracle_checksum_heat() >= 10.0:
    return 5
  if sim_scientific_oracle_checksum_cfd() <= 0.0:
    return 6
  if sim_scientific_oracle_checksum_fea() <= 0.0:
    return 7
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if run_result_ok(md_run) != 1:
    return 8
  if md_run.checksum != sim_scientific_oracle_checksum_md():
    return 9
  var heat_run: SimRunResult = run_heat_smoke(0)
  if run_result_ok(heat_run) != 1:
    return 10
  if heat_run.checksum != sim_scientific_oracle_checksum_heat():
    return 11
  return 0
