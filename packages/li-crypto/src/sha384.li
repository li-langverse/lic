# sha384 — golden empty digest (M1).

def crypto_sha384_golden_empty_byte(i: int) -> int
  requires 0 <= i and i < 48
  ensures 0 <= result and result <= 255
  decreases 0
=
  if i == 0:
    return 56
  if i == 1:
    return 176
  if i == 2:
    return 96
  if i == 3:
    return 167
