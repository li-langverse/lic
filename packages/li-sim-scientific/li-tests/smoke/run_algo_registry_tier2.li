import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != sim_scientific_oracle_checksum_md():
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat203: SimRunResult = run_algo(203, 2)
  if run_result_ok(heat203) != 1:
    return 5
  if heat203.algo_id != 203:
    return 6
  if heat203.checksum != sim_scientific_oracle_checksum_heat():
    return 7
  if heat203.checksum == 1.001:
    return 8
  var cfd208: SimRunResult = run_algo(208, 0)
  if run_result_ok(cfd208) != 1:
    return 9
  if cfd208.algo_id != 208:
    return 10
  if cfd208.checksum != sim_scientific_oracle_checksum_cfd():
    return 11
  if cfd208.checksum == 1.001:
    return 12
  var fea214: SimRunResult = run_algo(214, 1)
  if run_result_ok(fea214) != 1:
    return 13
  if fea214.algo_id != 214:
    return 14
  if fea214.checksum != sim_scientific_oracle_checksum_fea():
    return 15
  if fea214.checksum == 1.001:
    return 16
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 17
  if rigid302.algo_id != 302:
    return 18
  if rigid302.checksum == 1.001:
    return 19
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 20
  if qm418.checksum != 1.001:
    return 21
  var qm401: SimRunResult = run_algo(401, 0)
  if run_result_ok(qm401) != 1:
    return 22
  if qm401.algo_id != 401:
    return 23
  if qm401.checksum != sim_scientific_oracle_checksum_qm():
    return 24
  if qm401.checksum == 1.001:
    return 25
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 26
  if aimd433.algo_id != 433:
    return 27
  if aimd433.checksum != sim_scientific_oracle_checksum_echem_aimd():
    return 28
  if aimd433.checksum == 1.001:
    return 29
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 30
  if gc434.algo_id != 434:
    return 31
  if gc434.checksum != sim_scientific_oracle_checksum_echem_gc_aimd():
    return 32
  if gc434.checksum == 1.001:
    return 33
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 34
  if sei435.algo_id != 435:
    return 35
  if sei435.checksum != sim_scientific_oracle_checksum_echem_sei_kmc():
    return 36
  if sei435.checksum == 1.001:
    return 37
  var echem_oracle: float = sim_scientific_oracle_checksum_echem_aimd()
  if echem_oracle <= 0.0:
    return 38
  if echem_oracle >= 1.0e-2:
    return 39
  var gc_oracle: float = sim_scientific_oracle_checksum_echem_gc_aimd()
  if gc_oracle <= 0.0:
    return 40
  if gc_oracle >= 0.05:
    return 41
  var sei_oracle: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  if sei_oracle <= 0.0:
    return 42
  if sei_oracle >= 0.35:
    return 43
  return 0
