import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  var md_oracle: float = sim_scientific_oracle_checksum_md()
  if md105.checksum != md_oracle:
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat201: SimRunResult = run_algo(201, 2)
  if run_result_ok(heat201) != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat201.checksum == 1.001:
    return 8
  var heat201b: SimRunResult = run_algo(201, 2)
  if heat201.checksum != heat201b.checksum:
    return 7
  var cfd206: SimRunResult = run_algo(algo_cfd_simple(), 1)
  if run_result_ok(cfd206) != 1:
    return 33
  if cfd206.algo_id != 206:
    return 34
  if cfd206.checksum == 1.001:
    return 36
  var cfd206b: SimRunResult = run_algo(algo_cfd_simple(), 1)
  if cfd206.checksum != cfd206b.checksum:
    return 35
  var fea214: SimRunResult = run_algo(algo_fea_linear_elasticity(), 1)
  if run_result_ok(fea214) != 1:
    return 38
  if fea214.algo_id != 214:
    return 39
  if fea214.checksum == 1.001:
    return 41
  var fea214b: SimRunResult = run_algo(algo_fea_linear_elasticity(), 1)
  if fea214.checksum != fea214b.checksum:
    return 40
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 9
  if rigid302.algo_id != 302:
    return 10
  if rigid302.checksum == 1.001:
    return 11
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 12
  if qm418.checksum != 1.001:
    return 13
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 16
  if aimd433.algo_id != 433:
    return 17
  if aimd433.checksum == 1.001:
    return 19
  var aimd433b: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if aimd433.checksum != aimd433b.checksum:
    return 18
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 22
  if gc434.algo_id != 434:
    return 23
  if gc434.checksum == 1.001:
    return 25
  var gc434b: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if gc434.checksum != gc434b.checksum:
    return 24
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 28
  if sei435.algo_id != 435:
    return 29
  if sei435.checksum == 1.001:
    return 31
  var sei435b: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if sei435.checksum != sei435b.checksum:
    return 30
  return 0
