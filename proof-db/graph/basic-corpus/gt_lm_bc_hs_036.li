# GT-LM-BC-HS-036: Handshaking lemma: sum deg(v) = 2|E| (variant 36).

def handshaking_sum(deg_sum: int, edge_count: int) -> int
  requires edge_count >= 0
  ensures result == 2 * edge_count
  decreases 0
=
  return deg_sum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
