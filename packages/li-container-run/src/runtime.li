# WP-CTN-040..042 — lirun OCI lifecycle (backend-aware; depends li-container + li-oci).

import container
import container.backend.darwin
import container.backend.lios
import container.backend.select
import container.backend.windows
import container.bundle
import container.runerr
import container.state
import oci.spec
import std.runtime.seam

def lirun_create_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def lirun_start_tag() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

def lirun_stop_tag() -> int
  requires true
  ensures result == 4
  decreases 0
=
  return 4

def lirun_delete_tag() -> int
  requires true
  ensures result == 5
  decreases 0
=
  return 5

def lirun_state_tag() -> int
  requires true
  ensures result == 6
  decreases 0
=
  return 6

def runtime_require_linux() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if container_linux_available() != 1:
    return error_unsupported()
  return 0

def runtime_create(container_id: var ptr, bundle_path: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if runtime_require_linux() != 0:
    return error_unsupported()
  if state_exists(container_id) == 1:
    return error_container_exists()
  var config: ptr = container_buf_alloc_i(65536)
  if bundle_read_config(bundle_path, config, 65536) != 0:
    container_buf_free_i(config)
    return error_bundle_not_found()
  if bundle_validate_rootfs(bundle_path, config) != 0:
    container_buf_free_i(config)
    return error_invalid_config()
  var oci: ptr = container_buf_alloc_i(64)
  if bundle_oci_version(config, oci, 64) != 0:
    container_buf_free_i(oci)
    container_buf_free_i(config)
    return error_invalid_config()
  if state_save_created(container_id, oci, bundle_path) != 0:
    container_buf_free_i(oci)
    container_buf_free_i(config)
    return error_runtime()
  if container_cgroup_create_i(container_id) != 0:
    container_buf_free_i(oci)
    container_buf_free_i(config)
    return error_runtime()
  var cgroup: ptr = container_buf_alloc_i(4096)
  container_cgroup_path_i(container_id, cgroup, 4096)
  bundle_apply_cgroup_limits(cgroup, config)
  container_buf_free_i(cgroup)
  container_buf_free_i(oci)
  container_buf_free_i(config)
  return 0

def runtime_child_setup(container_id: var ptr, bundle_path: var ptr, config: var ptr) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var flags: int = container_namespace_flags_i(config)
  container_unshare_i(flags)
  container_cgroup_join_i(container_id)
  container_setup_rootfs_i(bundle_path, config)
  var uid: int = bundle_process_uid(config)
  var gid: int = bundle_process_gid(config)
  container_drop_privileges_i(uid, gid)
  container_seccomp_apply_i(config)
  var cwd: ptr = "/"
  container_exec_i(cwd, config)
  return error_runtime()

def runtime_start(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if runtime_require_linux() != 0:
    return error_unsupported()
  var state_json: ptr = container_buf_alloc_i(4096)
  if state_load(container_id, state_json, 4096) != 0:
    container_buf_free_i(state_json)
    return error_container_not_found()
  var status: ptr = container_buf_alloc_i(64)
  state_status(state_json, status, 64)
  var running: ptr = "running"
  if container_str_cmp_i(status, running) == 0:
    container_buf_free_i(status)
    container_buf_free_i(state_json)
    return error_invalid_state()
  var bundle: ptr = container_buf_alloc_i(4096)
  container_json_field_str_i(state_json, "bundle", bundle, 4096)
  var config: ptr = container_buf_alloc_i(65536)
  if bundle_read_config(bundle, config, 65536) != 0:
    container_buf_free_i(bundle)
    container_buf_free_i(status)
    container_buf_free_i(state_json)
    container_buf_free_i(config)
    return error_invalid_config()
  var oci: ptr = container_buf_alloc_i(64)
  bundle_oci_version(config, oci, 64)
  var child: int = container_fork_child_i()
  if child < 0:
    container_buf_free_i(oci)
    container_buf_free_i(bundle)
    container_buf_free_i(status)
    container_buf_free_i(state_json)
    container_buf_free_i(config)
    return error_runtime()
  if child > 0:
    state_save_running(container_id, oci, bundle, child)
    container_buf_free_i(oci)
    container_buf_free_i(bundle)
    container_buf_free_i(status)
    container_buf_free_i(state_json)
    container_buf_free_i(config)
    return 0
  runtime_child_setup(container_id, bundle, config)
  return error_runtime()

def runtime_delete(container_id: var ptr, force: int) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if runtime_require_linux() != 0:
    return error_unsupported()
  var state_json: ptr = container_buf_alloc_i(4096)
  if state_load(container_id, state_json, 4096) != 0:
    container_buf_free_i(state_json)
    return error_container_not_found()
  var status: ptr = container_buf_alloc_i(64)
  state_status(state_json, status, 64)
  var running: ptr = "running"
  if container_str_cmp_i(status, running) == 0:
    if force != 1:
      container_buf_free_i(status)
      container_buf_free_i(state_json)
      return error_invalid_state()
    var pid: int = container_state_pid_value_i(state_json)
    if pid > 0:
      container_kill_i(pid, 9)
  container_cgroup_remove_i(container_id)
  state_delete(container_id)
  container_buf_free_i(status)
  container_buf_free_i(state_json)
  return 0

def runtime_kill(container_id: var ptr, signal: int) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if runtime_require_linux() != 0:
    return error_unsupported()
  var state_json: ptr = container_buf_alloc_i(4096)
  if state_load(container_id, state_json, 4096) != 0:
    container_buf_free_i(state_json)
    return error_container_not_found()
  var pid: int = container_state_pid_value_i(state_json)
  if pid > 0:
    container_kill_i(pid, signal)
  container_buf_free_i(state_json)
  return 0

def runtime_state(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if runtime_require_linux() != 0:
    return error_unsupported()
  var state_json: ptr = container_buf_alloc_i(4096)
  if state_load(container_id, state_json, 4096) != 0:
    container_buf_free_i(state_json)
    return error_container_not_found()
  var status: ptr = container_buf_alloc_i(64)
  state_status(state_json, status, 64)
  var running: ptr = "running"
  if container_str_cmp_i(status, running) == 0:
    var pid: int = container_state_pid_value_i(state_json)
    if pid > 0:
      if container_pid_alive_i(pid) != 1:
        var bundle: ptr = container_buf_alloc_i(4096)
        container_json_field_str_i(state_json, "bundle", bundle, 4096)
        var oci: ptr = container_buf_alloc_i(64)
        container_json_field_str_i(state_json, "ociVersion", oci, 64)
        state_save_stopped(container_id, oci, bundle, pid)
        state_load(container_id, state_json, 4096)
        container_buf_free_i(oci)
        container_buf_free_i(bundle)
  container_stdout_i(state_json)
  container_buf_free_i(status)
  container_buf_free_i(state_json)
  return 0

def lirun_runtime_backend_id() raises IO -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return container_backend_detect()

def lirun_runtime_backend_tag() raises IO -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  return container_backend_tag_for_id(bid)

def lirun_lifecycle_tag_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if lirun_create_tag() != 2:
    return 1
  if lirun_start_tag() != 3:
    return 2
  if lirun_stop_tag() != 4:
    return 3
  if lirun_delete_tag() != 5:
    return 4
  if lirun_state_tag() != 6:
    return 5
  return 0

def lirun_create_stub(container_id: var ptr, bundle_path: var ptr) -> int
  requires true
  ensures result == 0
  decreases 0
=
  return container_err_ok()

def lirun_create(container_id: var ptr, bundle_path: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  if bid == container_backend_id_linux():
    var rc: int = runtime_create(container_id, bundle_path)
    if rc != 0:
      return rc
    return container_err_ok()
  if bid == container_backend_id_lios():
    if container_lios_backend_tag() != 2:
      return container_err_backend_unsupported()
    return lirun_create_stub(container_id, bundle_path)
  if bid == container_backend_id_windows():
    if container_windows_backend_tag() != 3:
      return container_err_backend_unsupported()
    return lirun_create_stub(container_id, bundle_path)
  if bid == container_backend_id_darwin():
    if container_darwin_backend_tag() != 4:
      return container_err_backend_unsupported()
    return lirun_create_stub(container_id, bundle_path)
  return container_err_backend_unsupported()

def lirun_start(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  if bid == container_backend_id_linux():
    var rc: int = runtime_start(container_id)
    if rc != 0:
      return rc
    return container_err_ok()
  if bid == container_backend_id_lios():
    return container_err_ok()
  if bid == container_backend_id_windows():
    return container_err_ok()
  if bid == container_backend_id_darwin():
    return container_err_ok()
  return container_err_backend_unsupported()

def lirun_delete(container_id: var ptr, force: int) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  if bid == container_backend_id_linux():
    var rc: int = runtime_delete(container_id, force)
    if rc != 0:
      return rc
    return container_err_ok()
  var rc2: int = container_state_delete(container_id)
  if rc2 < 0:
    return container_err_state_missing()
  return container_err_ok()

def lirun_kill(container_id: var ptr, signal: int) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  if bid == container_backend_id_linux():
    var rc: int = runtime_kill(container_id, signal)
    if rc != 0:
      return rc
    return container_err_ok()
  return container_err_backend_unsupported()

def lirun_state_query(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  if bid == container_backend_id_linux():
    var rc: int = runtime_state(container_id)
    if rc != 0:
      return rc
    return container_err_ok()
  var cap: int = 4096
  var buf: ptr = container_buf_alloc_i(cap)
  var n: int = container_state_read(container_id, buf, cap)
  container_buf_free_i(buf)
  if n < 0:
    return container_err_state_missing()
  return container_err_ok()

def lirun_backend_lifecycle_selftest() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var bid: int = lirun_runtime_backend_id()
  var tag: int = container_backend_tag_for_id(bid)
  if tag < 0:
    return 1
  if bid == container_backend_id_linux():
    if tag != container_linux_backend_tag():
      return 2
  if bid == container_backend_id_lios():
    if tag != container_lios_backend_tag():
      return 3
  if bid == container_backend_id_windows():
    if tag != container_windows_backend_tag():
      return 4
  if bid == container_backend_id_darwin():
    if tag != container_darwin_backend_tag():
      return 5
  if bid == container_backend_id_unknown():
    if tag != container_backend_id_unknown():
      return 6
  if container_lios_isolation_score() != 3:
    return 7
  if container_windows_isolation_score() != 2:
    return 8
  if container_darwin_isolation_score() != 2:
    return 9
  return 0

def lirun_selftest() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var r: int = lirun_lifecycle_tag_selftest()
  if r != 0:
    return r
  r = lirun_backend_lifecycle_selftest()
  if r != 0:
    return r + 10
  if oci_spec_version() != 1:
    return 20
  r = li_container_selftest()
  if r != 0:
    return r + 30
  if lirun_runtime_backend_tag() < 0:
    return 40
  return 0

def lirun_parse_signal(name: var ptr) -> int
  requires true
  ensures result > 0
  decreases 0
=
  var sigterm: ptr = "SIGTERM"
  var term: ptr = "TERM"
  var sigkill: ptr = "SIGKILL"
  if container_str_cmp_i(name, sigterm) == 0:
    return 15
  if container_str_cmp_i(name, term) == 0:
    return 15
  if container_str_cmp_i(name, sigkill) == 0:
    return 9
  return 9

def lirun_argv_container_id(arg_idx: int) -> ptr
  requires 0 <= arg_idx
  ensures true
  decreases 0
=
  var id_flag: ptr = "--id"
  if container_str_cmp_i(li_rt_argv_i(arg_idx), id_flag) == 0:
    return li_rt_argv_i(arg_idx + 1)
  return li_rt_argv_i(arg_idx)

def lirun_argv_delete_force(n: int, id_arg_idx: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var force_flag: ptr = "--force"
  if n >= id_arg_idx + 2:
    if container_str_cmp_i(li_rt_argv_i(id_arg_idx + 1), force_flag) == 0:
      return 1
  if n >= id_arg_idx + 3:
    if container_str_cmp_i(li_rt_argv_i(id_arg_idx + 2), force_flag) == 0:
      return 1
  return 0

def lirun_cmd_version() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  container_stdout_i("lirun 0.1.0\n")
  return 0

def lirun_cmd_create(bundle: var ptr, container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rc: int = runtime_create(container_id, bundle)
  if rc != 0:
    var msg: ptr = "create failed"
    if rc == error_container_exists():
      msg = "container already exists"
    if rc == error_bundle_not_found():
      msg = "bundle not found"
    if rc == error_invalid_config():
      msg = "invalid bundle config"
    if rc == error_unsupported():
      msg = "lirun requires Linux (use WSL2 bridge on Windows)"
    emit_error_json(rc, msg)
    return 1
  return 0

def lirun_cmd_start(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rc: int = runtime_start(container_id)
  if rc != 0:
    var msg: ptr = "start failed"
    emit_error_json(rc, msg)
    return 1
  return 0

def lirun_cmd_delete(container_id: var ptr, force: int) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rc: int = runtime_delete(container_id, force)
  if rc != 0:
    var msg: ptr = "delete failed"
    emit_error_json(rc, msg)
    return 1
  return 0

def lirun_cmd_kill(container_id: var ptr, signal_name: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var sig: int = lirun_parse_signal(signal_name)
  var rc: int = runtime_kill(container_id, sig)
  if rc != 0:
    var msg: ptr = "kill failed"
    emit_error_json(rc, msg)
    return 1
  return 0

def lirun_cmd_state(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rc: int = runtime_state(container_id)
  if rc != 0:
    var msg: ptr = "state query failed"
    emit_error_json(rc, msg)
    return 1
  return 0

def lirun_run_from_argv() raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var n: int = li_rt_argc()
  if n < 2:
    return 1
  var cmd: ptr = li_rt_argv_i(1)
  var version_cmd: ptr = "version"
  if container_str_cmp_i(cmd, version_cmd) == 0:
    return lirun_cmd_version()
  var create_cmd: ptr = "create"
  if container_str_cmp_i(cmd, create_cmd) == 0:
    if n < 6:
      return 1
    var bundle_flag: ptr = "--bundle"
    var id_flag: ptr = "--id"
    if container_str_cmp_i(li_rt_argv_i(2), bundle_flag) != 0:
      return 1
    if container_str_cmp_i(li_rt_argv_i(4), id_flag) != 0:
      return 1
    return lirun_cmd_create(li_rt_argv_i(3), li_rt_argv_i(5))
  var start_cmd: ptr = "start"
  if container_str_cmp_i(cmd, start_cmd) == 0:
    if n < 4:
      return 1
    var id_flag2: ptr = "--id"
    if container_str_cmp_i(li_rt_argv_i(2), id_flag2) != 0:
      return 1
    return lirun_cmd_start(li_rt_argv_i(3))
  var delete_cmd: ptr = "delete"
  if container_str_cmp_i(cmd, delete_cmd) == 0:
    if n < 4:
      return 1
    var del_id: ptr = lirun_argv_container_id(2)
    var force: int = lirun_argv_delete_force(n, 2)
    return lirun_cmd_delete(del_id, force)
  var kill_cmd: ptr = "kill"
  if container_str_cmp_i(cmd, kill_cmd) == 0:
    if n < 4:
      return 1
    var kill_id: ptr = lirun_argv_container_id(2)
    var sig: ptr = "SIGKILL"
    if n >= 5:
      var id_flag_k: ptr = "--id"
      if container_str_cmp_i(li_rt_argv_i(2), id_flag_k) == 0:
        if n >= 6:
          sig = li_rt_argv_i(5)
      else:
        sig = li_rt_argv_i(4)
    return lirun_cmd_kill(kill_id, sig)
  var state_cmd: ptr = "state"
  if container_str_cmp_i(cmd, state_cmd) == 0:
    if n < 4:
      return 1
    return lirun_cmd_state(lirun_argv_container_id(2))
  return 1
