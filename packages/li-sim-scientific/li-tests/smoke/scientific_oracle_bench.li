import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var md: float = sim_scientific_oracle_checksum_md()
  var heat: float = sim_scientific_oracle_checksum_heat()
  var md105: SimRunResult = run_algo(105, 0)
  if run_result_ok(md105) != 1:
    return 2
  if md105.checksum != md:
    return 3
  var heat210: SimRunResult = run_algo(210, 0)
  if run_result_ok(heat210) != 1:
    return 4
  if heat210.checksum != heat:
    return 5
  return 0
