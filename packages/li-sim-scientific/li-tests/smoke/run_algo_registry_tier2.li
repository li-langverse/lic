import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum == 1.001:
    return 4
  var heat202: SimRunResult = run_algo(202, 2)
  if run_result_ok(heat202) != 1:
    return 5
  if heat202.algo_id != 202:
    return 6
  if heat202.checksum == 1.001:
    return 8
  if heat202.vertical_id != vertical_pde_heat_2d():
    return 44
  var cfd205: SimRunResult = run_algo(205, 1)
  if run_result_ok(cfd205) != 1:
    return 33
  if cfd205.algo_id != 205:
    return 34
  if cfd205.checksum == 1.001:
    return 36
  if cfd205.vertical_id != vertical_cfd_lid_driven_cavity():
    return 37
  if cfd205.checksum <= 0.0:
    return 32
  var fea214: SimRunResult = run_algo(214, 0)
  if run_result_ok(fea214) != 1:
    return 39
  if fea214.algo_id != 214:
    return 40
  if fea214.checksum == 1.001:
    return 42
  if fea214.vertical_id != vertical_fea_linear_elasticity():
    return 43
  if fea214.checksum <= 0.0:
    return 38
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 9
  if rigid302.algo_id != 302:
    return 10
  if rigid302.checksum == 1.001:
    return 11
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 12
  if qm418.checksum != 1.001:
    return 13
  return 0
