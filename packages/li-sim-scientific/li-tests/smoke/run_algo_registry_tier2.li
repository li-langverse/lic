import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md_oracle: float = sim_scientific_oracle_checksum_md()
  var heat_oracle: float = sim_scientific_oracle_checksum_heat()
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != md_oracle:
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat204: SimRunResult = run_algo(204, 2)
  if run_result_ok(heat204) != 1:
    return 5
  if heat204.algo_id != 204:
    return 6
  if heat204.checksum != heat_oracle:
    return 7
  if heat204.checksum == 1.001:
    return 8
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 9
  if rigid302.algo_id != 302:
    return 10
  if rigid302.checksum == 1.001:
    return 11
  var qm_oracle: float = heat_oracle + 0.987654
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 13
  if qm418.algo_id != algo_qm_dft_scf_energy():
    return 14
  if qm418.checksum != qm_oracle:
    return 15
  if qm418.checksum == 1.001:
    return 16
  var cfd_oracle: float = heat_oracle + 0.123456
  var cfd206: SimRunResult = run_algo(206, 0)
  if run_result_ok(cfd206) != 1:
    return 18
  if cfd206.algo_id != 206:
    return 19
  if cfd206.checksum != cfd_oracle:
    return 20
  if cfd206.checksum == 1.001:
    return 21
  var fea_oracle: float = heat_oracle + 0.654321
  var fea215: SimRunResult = run_algo(215, 0)
  if run_result_ok(fea215) != 1:
    return 23
  if fea215.algo_id != 215:
    return 24
  if fea215.checksum != fea_oracle:
    return 25
  if fea215.checksum == 1.001:
    return 26
  var echem_oracle: float = sim_scientific_oracle_checksum_echem_aimd()
  if echem_oracle <= 0.0:
    return 27
  if echem_oracle >= 1.0e-2:
    return 28
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 29
  if aimd433.algo_id != 433:
    return 30
  if aimd433.checksum != echem_oracle:
    return 31
  if aimd433.checksum == 1.001:
    return 32
  var gc_oracle: float = sim_scientific_oracle_checksum_echem_gc_aimd()
  if gc_oracle <= 0.0:
    return 33
  if gc_oracle >= 0.05:
    return 34
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 35
  if gc434.algo_id != 434:
    return 36
  if gc434.checksum != gc_oracle:
    return 37
  if gc434.checksum == 1.001:
    return 38
  var sei_oracle: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  if sei_oracle <= 0.0:
    return 39
  if sei_oracle >= 0.35:
    return 40
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 41
  if sei435.algo_id != 435:
    return 42
  if sei435.checksum != sei_oracle:
    return 43
  if sei435.checksum == 1.001:
    return 44
  return 0
