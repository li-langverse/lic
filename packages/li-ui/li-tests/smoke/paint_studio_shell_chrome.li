import ui

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_ui_version() < 5:
    return 1
  if paint_op_kind_max() != paint_op_draw_image():
    return 2
  var panel: Rect = rect_make(8.0, 8.0, 120.0, 40.0)
  var fill_round: PaintCmd = paint_cmd_fill_round(panel, studio_color_bg_elevated(), studio_default_panel_radius_px())
  if fill_round.kind != paint_op_fill_round_rect():
    return 3
  if fill_round.radius_px != 6.0:
    return 4
  var stroke_round: PaintCmd = paint_cmd_stroke_round(panel, studio_color_border(), 1.0, studio_default_panel_radius_px())
  if stroke_round.kind != paint_op_stroke_round_rect():
    return 5
  var grad: PaintCmd = paint_cmd_fill_gradient(panel, studio_color_bg_primary(), studio_color_bg_elevated())
  if grad.kind != paint_op_fill_gradient():
    return 6
  var frame: PaintFrame = paint_frame_new()
  paint_frame_push(frame, fill_round)
  paint_frame_push(frame, stroke_round)
  paint_frame_push(frame, grad)
  if frame.cmd_count != 3:
    return 7
  if frame.last_kind != paint_op_fill_gradient():
    return 8
  var layout: StudioShellLayout = layout_studio_shell_adaptive(1920.0, 1080.0)
  var chrome: PaintFrame = paint_frame_new()
  paint_studio_shell_chrome(chrome, layout)
  if chrome.cmd_count != paint_studio_shell_chrome_count():
    return 9
  return 0
