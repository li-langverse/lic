import ml

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[64, float]
  var b: array[64, float]
  var c: array[64, float]
  a[0] = 1.0
  a[5] = 1.0
  b[0] = 1.0
  b[1] = 2.0
  b[4] = 3.0
  b[5] = 4.0
  var ad: MlTensorDesc = ml_tensor_desc_2d(4, 4, 8)
  var bd: MlTensorDesc = ml_tensor_desc_2d(4, 4, 8)
  if ml_tensor_matmul_64(ad, a, bd, b, c) != 1:
    return 1
  if c[0] < 0.9 or c[0] > 1.1:
    return 2
  return 0
