def par_disjoint_mod(buf: var array[8, float], period: int) -> unit
  requires period == 8
  ensures true
  decreases 0
=
  parallel for j in 0..<8
    requires disjoint_mod(j, period, buf)
    decreases 8 - j
  =
    buf[j % period] = 0.0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var buf: array[8, float]
  par_disjoint_mod(buf, 8)
  return 0
