import gui

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_gui_version() < 14:
    return 1
  if gui_motion_version() < 1:
    return 2
  if motion_reduced() != 0:
    return 3
  if gui_animation_easing_default_id() != motion_easing_id_ease_out_cubic():
    return 4
  if gui_animation_reduced_motion_scale() != 0.0:
    return 5
  if easing_linear(0.0) != 0.0:
    return 6
  if easing_linear(1.0) != 1.0:
    return 7
  if easing_ease_out_cubic(0.0) != 0.0:
    return 8
  if easing_ease_out_cubic(1.0) != 1.0:
    return 9
  if easing_ease_in_out_cubic(0.0) != 0.0:
    return 10
  if easing_ease_in_out_cubic(1.0) != 1.0:
    return 11
  var lin0: float = tween_float(2.0, 8.0, 0.0, motion_easing_id_linear())
  if lin0 != 2.0:
    return 12
  var lin1: float = tween_float(2.0, 8.0, 1.0, motion_easing_id_linear())
  if lin1 != 8.0:
    return 13
  var cubic0: float = tween_float(0.0, 100.0, 0.0, motion_easing_id_ease_out_cubic())
  if cubic0 != 0.0:
    return 14
  var cubic1: float = tween_float(0.0, 100.0, 1.0, motion_easing_id_ease_out_cubic())
  if cubic1 != 100.0:
    return 15
  var inout0: float = tween_float(10.0, 20.0, 0.0, motion_easing_id_ease_in_out_cubic())
  if inout0 != 10.0:
    return 16
  var inout1: float = tween_float(10.0, 20.0, 1.0, motion_easing_id_ease_in_out_cubic())
  if inout1 != 20.0:
    return 17
  if motion_clock_ms(0, 16.0) != 0.0:
    return 18
  if motion_clock_ms(3, 16.0) != 48.0:
    return 19
  if motion_clock_ms(5, 20.0) != 100.0:
    return 20
  return 0
