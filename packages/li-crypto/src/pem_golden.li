def crypto_pem_pkcs8_wire_len() -> int
  requires true
  ensures result == 119
  decreases 0
=
  return 119

def crypto_pem_cert_wire_len() -> int
  requires true
  ensures result == 371
  decreases 0
=
  return 371

def crypto_pem_pkcs8_b64_start() -> int
  requires true
  ensures result == 28
  decreases 0
=
  return 28

def crypto_pem_pkcs8_b64_end() -> int
  requires true
  ensures result == 92
  decreases 0
=
  return 92

def crypto_pem_cert_b64_start() -> int
  requires true
  ensures result == 28
  decreases 0
=
  return 28

def crypto_pem_cert_b64_end() -> int
  requires true
  ensures result == 344
  decreases 0
=
  return 344

def crypto_pem_pkcs8_der_len() -> int
  requires true
  ensures result == 48
  decreases 0
=
  return 48

def crypto_pem_cert_der_len() -> int
  requires true
  ensures result == 233
  decreases 0
=
  return 233

def crypto_pem_wire_byte(kind: int, i: int) -> int
  requires kind == 0 or kind == 1
  requires 0 <= i
  ensures 0 <= result and result <= 255
  decreases 0
=
  if kind == 0:
    return crypto_pem_pkcs8_wire_byte(i)
  return crypto_pem_cert_wire_byte(i)

def crypto_pem_wire_len(kind: int) -> int
  requires kind == 0 or kind == 1
  ensures result > 0
  decreases 0
=
  if kind == 0:
    return crypto_pem_pkcs8_wire_len()
  return crypto_pem_cert_wire_len()
