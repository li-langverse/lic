# Phase 3 — PaintCmd builders (clip, glyphs, image). Mirrored into lib.li for `import ui`.
# Opcodes 7–10 and paint_op_kind_max live in lib.li before PaintCmd type.

def paint_image_id_none() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def paint_image_id_studio_logo() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def paint_image_id_dock_icon() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def paint_cmd_clip_push(clip_rect: Rect) -> PaintCmd
  requires clip_rect.w >= 0.0
  requires clip_rect.h >= 0.0
  ensures result.kind == paint_op_clip_push()
  ensures result.rect == clip_rect
  decreases 0
=
  var c: PaintCmd
  c.kind = paint_op_clip_push()
  c.rect = clip_rect
  c.color = studio_color_bg_primary()
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  paint_cmd_ext_zero(c)
  return c

def paint_cmd_clip_pop() -> PaintCmd
  requires true
  ensures result.kind == paint_op_clip_pop()
  decreases 0
=
  var c: PaintCmd
  c.kind = paint_op_clip_pop()
  c.rect = rect_make(0.0, 0.0, 0.0, 0.0)
  c.color = studio_color_bg_primary()
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  paint_cmd_ext_zero(c)
  return c

def paint_cmd_draw_glyph(dest: Rect, face_id: int, codepoint: int, color: Color) -> PaintCmd
  requires dest.w >= 0.0
  requires dest.h >= 0.0
  requires face_id == font_face_inter() or face_id == font_face_ui_mono()
  requires font_atlas_codepoint_supported(codepoint) == 1
  ensures result.kind == paint_op_draw_glyphs()
  ensures result.rect == dest
  ensures result.color == color
  ensures result.face_id == face_id
  ensures result.codepoint == codepoint
  ensures result.glyph_count == 1
  decreases codepoint
=
  var c: PaintCmd
  c.kind = paint_op_draw_glyphs()
  c.rect = dest
  c.color = color
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  c.face_id = face_id
  c.codepoint = codepoint
  c.glyph_count = 1
  c.image_id = 0
  c.src_rect = rect_make(0.0, 0.0, 0.0, 0.0)
  return c

def paint_cmd_draw_glyphs_run(dest: Rect, face_id: int, color: Color, first_codepoint: int, glyph_count: int) -> PaintCmd
  requires dest.w >= 0.0
  requires dest.h >= 0.0
  requires face_id == font_face_inter() or face_id == font_face_ui_mono()
  requires glyph_count >= 1
  requires glyph_count <= 32
  requires font_atlas_codepoint_supported(first_codepoint) == 1
  ensures result.kind == paint_op_draw_glyphs()
  ensures result.rect == dest
  ensures result.color == color
  ensures result.face_id == face_id
  ensures result.codepoint == first_codepoint
  ensures result.glyph_count == glyph_count
  decreases glyph_count
=
  var c: PaintCmd
  c.kind = paint_op_draw_glyphs()
  c.rect = dest
  c.color = color
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  c.face_id = face_id
  c.codepoint = first_codepoint
  c.glyph_count = glyph_count
  c.image_id = 0
  c.src_rect = rect_make(0.0, 0.0, 0.0, 0.0)
  return c

def paint_cmd_draw_image(dest: Rect, image_id: int, src: Rect, tint: Color) -> PaintCmd
  requires dest.w >= 0.0
  requires dest.h >= 0.0
  requires src.w >= 0.0
  requires src.h >= 0.0
  requires image_id >= paint_image_id_none()
  requires image_id <= paint_image_id_dock_icon()
  ensures result.kind == paint_op_draw_image()
  ensures result.rect == dest
  ensures result.src_rect == src
  ensures result.image_id == image_id
  ensures result.color == tint
  decreases image_id
=
  var c: PaintCmd
  c.kind = paint_op_draw_image()
  c.rect = dest
  c.color = tint
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  c.face_id = 0
  c.codepoint = 0
  c.glyph_count = 0
  c.image_id = image_id
  c.src_rect = src
  return c

def paint_frame_push_clip_scope(frame: var PaintFrame, clip_rect: Rect) -> unit
  requires frame.cmd_count >= 0
  requires clip_rect.w >= 0.0
  requires clip_rect.h >= 0.0
  ensures frame.cmd_count == old(frame.cmd_count) + 1
  ensures frame.last_kind == paint_op_clip_push()
  decreases 0
=
  paint_frame_push(frame, paint_cmd_clip_push(clip_rect))

def paint_frame_pop_clip_scope(frame: var PaintFrame) -> unit
  requires frame.cmd_count >= 0
  ensures frame.cmd_count == old(frame.cmd_count) + 1
  ensures frame.last_kind == paint_op_clip_pop()
  decreases 0
=
  paint_frame_push(frame, paint_cmd_clip_pop())
