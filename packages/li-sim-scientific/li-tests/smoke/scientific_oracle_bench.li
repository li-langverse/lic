import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  sim_scientific_oracle_checksum_md()
  sim_scientific_oracle_checksum_heat()
  var fea: float = sim_scientific_oracle_checksum_fea()
  if fea < 2.9:
    return 2
  if fea > 3.1:
    return 3
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  if cfd < 0.1:
    return 4
  if cfd > 0.2:
    return 5
  var md_run: SimRunResult = run_algo(105, 0)
  if run_result_ok(md_run) != 1:
    return 10
  if md_run.checksum == 1.001:
    return 11
  var heat_run: SimRunResult = run_algo(203, 0)
  if run_result_ok(heat_run) != 1:
    return 12
  if heat_run.checksum == 1.001:
    return 13
  return 0
