# GT-LM-BC-HS-016: Regular graph: if every vertex has degree d then 2|E| = d|V|.

def handshaking_sum(deg_sum: int, edge_count: int) -> int
  requires edge_count >= 0 and deg_sum == 2 * edge_count
  ensures result == 2 * edge_count
  decreases 0
=
  return 2 * edge_count

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
