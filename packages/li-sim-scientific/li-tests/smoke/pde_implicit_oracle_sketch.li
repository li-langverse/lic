# lic#108: matrix-free implicit PDE API sketch (PETSc SNES/KSP vendor hook deferred).
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if pde_implicit_oracle_nx() != 64:
    return 1
  var chk: float = pde_implicit_jacobi_micro_checksum()
  if chk <= 0.0:
    return 2
  if chk >= 10.0:
    return 3
  return 0
