import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var qm_run: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm_run) != 1:
    return 1
  if qm_run.algo_id != 418:
    return 2
  if qm_run.checksum != sim_scientific_oracle_checksum_qm_dft():
    return 3
  if qm_run.checksum == 1.001:
    return 4
  if qm_run.checksum <= 0.0:
    return 5
  if qm_run.checksum > 1.0:
    return 6
  return 0
