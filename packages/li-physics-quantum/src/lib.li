
extern proc li_rt_sqrt(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
def li_std_physics_quantum_version() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

# WP-ECHEM-13: 2-state nonadiabatic population transfer (documented stub).
def quantum_tddft_2state_population_step(p_ground: float, coupling: float, dt: float) -> float
  requires p_ground >= 0.0
  requires p_ground <= 1.0
  requires coupling >= 0.0
  requires dt > 0.0
  ensures result >= 0.0
  ensures result <= 1.0
  decreases 0
=
  var p_excited: float = 1.0 - p_ground
  var hop: float = coupling * dt * p_excited
  if hop > p_ground:
    hop = p_ground
  var next: float = p_ground - hop
  if next < 0.0:
    next = 0.0
  if next > 1.0:
    next = 1.0
  return next

def quantum_tddft_nonadiabatic_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var p: float = 1.0
  var coupling: float = 0.04
  var dt: float = 0.5
  var step: int = 0
  while step < 6
    p = quantum_tddft_2state_population_step(p, coupling, dt)
    step = step + 1
  if p >= 0.95:
    return 0
  if p <= 0.0:
    return 0
  return 1
def norm_sq_1d(psi_re: array[8, float], psi_im: array[8, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var s: float = 0.0
  var i: int = 0
  while i < 8
    s = s + psi_re[i] * psi_re[i] + psi_im[i] * psi_im[i]
    i = i + 1
  return s
def normalize_1d(psi_re: array[8, float], psi_im: array[8, float]) raises IO -> unit
  requires true
  ensures true
  decreases 0
=
  var n2: float = norm_sq_1d(psi_re, psi_im)
  if n2 == 0.0:
    return
  var inv_n: float = 1.0 / li_rt_sqrt(n2)
  var i: int = 0
  while i < 8
    psi_re[i] = psi_re[i] * inv_n
    psi_im[i] = psi_im[i] * inv_n
    i = i + 1
def harmonic_potential_1d(x: float, k: float) -> float
  requires k >= 0.0
  ensures result == 0.5 * k * x * x
  decreases 0
=
  return 0.5 * k * x * x
def schrodinger_kinetic_diag(dx: float, mass: float) -> float
  requires dx > 0.0
  requires mass > 0.0
  ensures result == hbar * hbar / (2.0 * mass * dx * dx)
  decreases 0
=
  var hbar: float = 1.0
  return hbar * hbar / (2.0 * mass * dx * dx)

# sim-p2-qm-dft-scf — minimal H₂ STO-3G-class SCF scaffold (proved stub; not full Gaussian ERIs).
def qm_scf_h2_bond_ang() -> float
  requires true
  ensures result == 0.74
  decreases 0
=
  return 0.74

def qm_scf_h2_max_iter() -> int
  requires true
  ensures result == 8
  decreases 0
=
  return 8

def qm_scf_h2_mixing() -> float
  requires true
  ensures result == 0.35
  decreases 0
=
  return 0.35

def qm_scf_h2_energy_from_density(dens: float) -> float
  requires dens >= 0.0
  ensures result <= 0.0
  decreases 0
=
  var bond: float = qm_scf_h2_bond_ang()
  var inv_r: float = 1.0 / (0.5 * bond + 0.05)
  var kin: float = 0.5 * dens * dens
  var pot: float = -2.0 * dens * inv_r
  var xc: float = -0.738558 * dens * (dens * dens) * (dens * dens) * (dens * dens)
  if dens == 0.0:
    xc = 0.0
  return kin + pot + xc

def qm_scf_h2_fock_step(dens: var float, mix: float) -> float
  requires mix > 0.0
  requires mix <= 1.0
  requires dens >= 0.0
  ensures result <= 0.0
  decreases 0
=
  var target: float = 1.0 / (qm_scf_h2_bond_ang() + 0.2)
  if target > 1.0:
    target = 1.0
  dens = (1.0 - mix) * dens + mix * target
  return qm_scf_h2_energy_from_density(dens)

def qm_scf_h2_stub_iterations() -> int
  requires true
  ensures result >= 1
  ensures result <= qm_scf_h2_max_iter()
  decreases 0
=
  var dens: float = 0.5
  var energy: float = qm_scf_h2_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = qm_scf_h2_mixing()
  while iter < qm_scf_h2_max_iter()
    var orb_e: float = qm_scf_h2_fock_step(dens, mix)
    var e_new: float = qm_scf_h2_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    iter = iter + 1
    if de < tol:
      return iter
  return iter

def qm_scf_h2_stub_converged() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var dens: float = 0.5
  var energy: float = qm_scf_h2_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = qm_scf_h2_mixing()
  while iter < qm_scf_h2_max_iter()
    var orb_e: float = qm_scf_h2_fock_step(dens, mix)
    var e_new: float = qm_scf_h2_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    iter = iter + 1
    if de < tol:
      return 1
  return 0

def qm_scf_h2_stub_energy() -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var dens: float = 0.5
  var energy: float = qm_scf_h2_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = qm_scf_h2_mixing()
  while iter < qm_scf_h2_max_iter()
    var orb_e: float = qm_scf_h2_fock_step(dens, mix)
    var e_new: float = qm_scf_h2_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    iter = iter + 1
    if de < tol:
      return energy
  return energy
