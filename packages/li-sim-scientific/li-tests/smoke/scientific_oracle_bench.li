import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var md: float = sim_scientific_oracle_checksum_md()
  if md <= 0.0:
    return 2
  if md >= 1.0e-3:
    return 3
  var heat: float = sim_scientific_oracle_checksum_heat()
  if heat <= 1.0:
    return 4
  if heat >= 10.0:
    return 5
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if run_result_ok(md_run) != 1:
    return 6
  if md_run.checksum != md:
    return 7
  var heat_run: SimRunResult = run_heat_smoke(0)
  if run_result_ok(heat_run) != 1:
    return 8
  if heat_run.checksum != heat:
    return 9
  var qm: float = sim_scientific_oracle_checksum_qm()
  if qm >= 0.0:
    return 10
  if qm > -0.01:
    return 11
  var qm_run: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm_run) != 1:
    return 12
  if qm_run.checksum != qm:
    return 13
  if qm_run.checksum == 1.001:
    return 14
  return 0
