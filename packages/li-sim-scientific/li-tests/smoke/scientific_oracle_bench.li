import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var heat_run: SimRunResult = run_heat_smoke(0)
  if run_result_ok(heat_run) != 1:
    return 2
  var heat_ref: SimRunResult = run_heat_tier2_registry(algo_pde_heat_explicit_2d(), 0)
  if heat_run.checksum != heat_ref.checksum:
    return 3
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if run_result_ok(md_run) != 1:
    return 4
  var md_ref: SimRunResult = run_md_tier2_registry(algo_md_lj_cutoff_mic(), 0)
  if md_run.checksum != md_ref.checksum:
    return 5
  return 0
