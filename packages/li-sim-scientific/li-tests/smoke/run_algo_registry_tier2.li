import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum == 1.001:
    return 3
  var heat201: SimRunResult = run_algo(201, 1)
  if run_result_ok(heat201) != 1:
    return 4
  if heat201.algo_id != 201:
    return 5
  var heat_ref: SimRunResult = run_heat_smoke(1)
  if heat201.checksum != heat_ref.checksum:
    return 6
  if heat201.checksum == 1.001:
    return 7
  var cfd210: SimRunResult = run_algo(210, 2)
  if run_result_ok(cfd210) != 1:
    return 8
  if cfd210.algo_id != 210:
    return 9
  var cfd_ref: SimRunResult = run_cfd_tier2_registry(210, 2)
  if cfd210.checksum == 1.001:
    return 10
  if cfd210.checksum != cfd_ref.checksum:
    return 11
  var fea214: SimRunResult = run_algo(214, 1)
  if run_result_ok(fea214) != 1:
    return 12
  if fea214.algo_id != 214:
    return 13
  var fea_ref: SimRunResult = run_fea_tier2_registry(214, 1)
  if fea214.checksum == 1.001:
    return 14
  if fea214.checksum != fea_ref.checksum:
    return 15
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 16
  if rigid302.algo_id != 302:
    return 17
  if rigid302.checksum == 1.001:
    return 18
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 19
  var qm_ref: SimRunResult = run_qm_tier2_registry(418, 0)
  if qm418.checksum == 1.001:
    return 20
  if qm418.checksum != qm_ref.checksum:
    return 21
  if qm418.vertical_id != vertical_qm_dft():
    return 22
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 23
  if aimd433.algo_id != 433:
    return 24
  if aimd433.vertical_id != vertical_echem_aimd():
    return 25
  if aimd433.checksum == 1.001:
    return 26
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 27
  if gc434.algo_id != 434:
    return 28
  if gc434.vertical_id != vertical_echem_gc_aimd():
    return 29
  if gc434.checksum == 1.001:
    return 30
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 31
  if sei435.algo_id != 435:
    return 32
  if sei435.vertical_id != vertical_echem_sei_kmc():
    return 33
  if sei435.checksum == 1.001:
    return 34
  return 0
