# PH-SCI-GPU-07: @gpu wavefunction normalization (quantum vertical).
import physics.quantum

@gpu
def physics_gpu_quantum_normalize_smoke() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var psi_re: array[8, float]
  var psi_im: array[8, float]
  var i: int = 0
  while i < 8
    psi_re[i] = 1.0
    psi_im[i] = 0.0
    i = i + 1
  normalize_1d(psi_re, psi_im)
  return 1

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if physics_gpu_quantum_normalize_smoke() != 1:
    return 1
  return 0
