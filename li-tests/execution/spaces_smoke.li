import std.execution.spaces

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var host: int = memory_space_host()
  var omp: int = execution_space_openmp()
  var v: View1D = view1d_new(host, 8)
  if view_space(v) != host:
    return 1
  if omp != execution_space_openmp():
    return 1
  var src: array[8, float]
  var dst: array[8, float]
  src[0] = 1.0
  src[1] = 2.0
  src[2] = 3.0
  src[3] = 4.0
  src[4] = 5.0
  src[5] = 6.0
  src[6] = 7.0
  src[7] = 8.0
  view_copy_host8(src, dst)
  var sum: float = view_checksum_host8(dst)
  if sum < 36.0:
    return 1
  return __execution_spaces_doc()
