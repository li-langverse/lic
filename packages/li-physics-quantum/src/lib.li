
extern proc li_rt_sqrt(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
def li_std_physics_quantum_version() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

# WP-ECHEM-13: 2-state nonadiabatic population transfer (documented stub).
def quantum_tddft_2state_population_step(p_ground: float, coupling: float, dt: float) -> float
  requires p_ground >= 0.0
  requires p_ground <= 1.0
  requires coupling >= 0.0
  requires dt > 0.0
  ensures result >= 0.0
  ensures result <= 1.0
  decreases 0
=
  var p_excited: float = 1.0 - p_ground
  var hop: float = coupling * dt * p_excited
  if hop > p_ground:
    hop = p_ground
  var next: float = p_ground - hop
  if next < 0.0:
    next = 0.0
  if next > 1.0:
    next = 1.0
  return next

def quantum_tddft_nonadiabatic_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var p: float = 1.0
  var coupling: float = 0.04
  var dt: float = 0.5
  var step: int = 0
  while step < 6
    p = quantum_tddft_2state_population_step(p, coupling, dt)
    step = step + 1
  if p >= 0.95:
    return 0
  if p <= 0.0:
    return 0
  return 1
def norm_sq_1d(psi_re: array[8, float], psi_im: array[8, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var s: float = 0.0
  var i: int = 0
  while i < 8
    s = s + psi_re[i] * psi_re[i] + psi_im[i] * psi_im[i]
    i = i + 1
  return s
def normalize_1d(psi_re: array[8, float], psi_im: array[8, float]) raises IO -> unit
  requires true
  ensures true
  decreases 0
=
  var n2: float = norm_sq_1d(psi_re, psi_im)
  if n2 == 0.0:
    return
  var inv_n: float = 1.0 / li_rt_sqrt(n2)
  var i: int = 0
  while i < 8
    psi_re[i] = psi_re[i] * inv_n
    psi_im[i] = psi_im[i] * inv_n
    i = i + 1
def harmonic_potential_1d(x: float, k: float) -> float
  requires k >= 0.0
  ensures result == 0.5 * k * x * x
  decreases 0
=
  return 0.5 * k * x * x
def schrodinger_kinetic_diag(dx: float, mass: float) -> float
  requires dx > 0.0
  requires mass > 0.0
  ensures result == hbar * hbar / (2.0 * mass * dx * dx)
  decreases 0
=
  var hbar: float = 1.0
  return hbar * hbar / (2.0 * mass * dx * dx)

# sim-p2 / algo 418 — H₂ STO-3G-class minimal SCF stub (honest scaffold, not checksum 1.001).
def qm_scf_h2_bond_length_ang() -> float
  requires true
  ensures result == 0.74
  decreases 0
=
  return 0.74

def qm_scf_h2_grid_n() -> int
  requires true
  ensures result == 8
  decreases 0
=
  return 8

def qm_scf_h2_grid_dr() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.18

def qm_scf_h2_grid_r_at(i: int) -> float
  requires i >= 0
  requires i < qm_scf_h2_grid_n()
  ensures result > 0.0
  decreases i
=
  if i == 0:
    return 0.12
  if i == 1:
    return 0.30
  if i == 2:
    return 0.48
  if i == 3:
    return 0.66
  if i == 4:
    return 0.84
  if i == 5:
    return 1.02
  if i == 6:
    return 1.20
  return 1.38

def qm_scf_h2_primitive_decay(r: float, zeta: float) -> float
  requires r >= 0.0
  requires zeta > 0.0
  ensures result > 0.0
  decreases 0
=
  var rr: float = r * r
  return 1.0 / (1.0 + zeta * rr)

def qm_scf_h2_basis_eval(r: float) -> float
  requires r >= 0.0
  ensures result >= 0.0
  decreases 0
=
  var p0: float = qm_scf_h2_primitive_decay(r, 3.42525091)
  var p1: float = qm_scf_h2_primitive_decay(r, 0.62391373)
  var p2: float = qm_scf_h2_primitive_decay(r, 0.16885540)
  return 0.15432897 * p0 + 0.53532814 * p1 + 0.44463454 * p2

def qm_scf_h2_cbrt_rho(rho: float) -> float
  requires rho >= 0.0
  ensures result >= 0.0
  decreases 0
=
  if rho <= 1.0e-12:
    return 0.0
  var x: float = rho
  if x < 1.0e-6:
    x = 1.0e-6
  var k: int = 0
  while k < 4
    var x2: float = x * x
    if x2 > 1.0e-18:
      x = (2.0 * x + rho / x2) / 3.0
    k = k + 1
  return x

def qm_scf_h2_lda_xc(rho: float) -> float
  requires rho >= 0.0
  ensures result <= 0.0
  decreases 0
=
  if rho <= 1.0e-12:
    return 0.0
  var cbrt: float = qm_scf_h2_cbrt_rho(rho)
  return -0.738558 * cbrt

def qm_scf_h2_basis_n() -> int
  requires true
  ensures result == 4
  decreases 0
=
  return 4

def qm_scf_h2_basis_zeta_at(bi: int) -> float
  requires bi >= 0
  requires bi < qm_scf_h2_basis_n()
  ensures result > 0.0
  decreases bi
=
  if bi == 0:
    return 3.42525091
  if bi == 1:
    return 0.62391373
  if bi == 2:
    return 0.16885540
  return 0.90000000

def qm_scf_h2_basis_centroid_at(bi: int) -> float
  requires bi >= 0
  requires bi < qm_scf_h2_basis_n()
  ensures result > 0.0
  decreases bi
=
  if bi == 0:
    return 0.30
  if bi == 1:
    return 0.60
  if bi == 2:
    return 0.90
  return 1.20

def qm_scf_h2_basis_eval_at(bi: int, r: float) -> float
  requires bi >= 0
  requires bi < qm_scf_h2_basis_n()
  requires r >= 0.0
  ensures result >= 0.0
  decreases bi
=
  return qm_scf_h2_primitive_decay(r, qm_scf_h2_basis_zeta_at(bi))

def qm_scf_h2_coulomb_2center(bi: int, bj: int) -> float
  requires bi >= 0
  requires bi < qm_scf_h2_basis_n()
  requires bj >= 0
  requires bj < qm_scf_h2_basis_n()
  ensures result > 0.0
  decreases bi + bj
=
  var ri: float = qm_scf_h2_basis_centroid_at(bi)
  var rj: float = qm_scf_h2_basis_centroid_at(bj)
  var d: float = ri - rj
  if d < 0.0:
    d = -d
  return 1.0 / (d + 0.20)

def qm_scf_h2_core_hamiltonian_ii(bi: int) -> float
  requires bi >= 0
  requires bi < qm_scf_h2_basis_n()
  ensures result < 0.0
  decreases bi
=
  var ri: float = qm_scf_h2_basis_centroid_at(bi)
  return -1.0 / (ri + 0.05) + 0.25 * qm_scf_h2_basis_zeta_at(bi)

def qm_scf_h2_fock_diagonal_build(P: array[4, array[4, float]], F: var array[4, array[4, float]]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    var j: int = 0
    while j < qm_scf_h2_basis_n()
      F[i][j] = 0.0
      j = j + 1
    i = i + 1
  i = 0
  while i < qm_scf_h2_basis_n()
    var h_ii: float = qm_scf_h2_core_hamiltonian_ii(i)
    var coul: float = 0.0
    var exch: float = 0.0
    var j: int = 0
    while j < qm_scf_h2_basis_n()
      var p_jj: float = P[j][j]
      coul = coul + p_jj * qm_scf_h2_coulomb_2center(i, j)
      if i == j:
        exch = exch + 0.5 * p_jj * qm_scf_h2_coulomb_2center(i, j)
      j = j + 1
    F[i][i] = h_ii + coul - exch
    i = i + 1

def qm_scf_h2_matvec4(F: array[4, array[4, float]], v: var array[4, float], out: var array[4, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    var sum: float = 0.0
    var j: int = 0
    while j < qm_scf_h2_basis_n()
      sum = sum + F[i][j] * v[j]
      j = j + 1
    out[i] = sum
    i = i + 1

def qm_scf_h2_vec_norm4(v: array[4, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var sum: float = 0.0
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    sum = sum + v[i] * v[i]
    i = i + 1
  if sum <= 0.0:
    return 1.0
  var n: int = 0
  var x: float = sum
  while n < 6
    x = 0.5 * (x + sum / x)
    n = n + 1
  return x

def qm_scf_h2_vec_normalize4(v: var array[4, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var norm: float = qm_scf_h2_vec_norm4(v)
  if norm <= 1.0e-12:
    return
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    v[i] = v[i] / norm
    i = i + 1

def qm_scf_h2_rayleigh4(F: array[4, array[4, float]], v: var array[4, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var Fv: array[4, float]
  qm_scf_h2_matvec4(F, v, Fv)
  var num: float = 0.0
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    num = num + v[i] * Fv[i]
    i = i + 1
  return num

def qm_scf_h2_eigensolve_power4(F: array[4, array[4, float]], coeffs: var array[4, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    coeffs[i] = 1.0
    i = i + 1
  qm_scf_h2_vec_normalize4(coeffs)
  var energy: float = qm_scf_h2_rayleigh4(F, coeffs)
  var step: int = 0
  while step < 4
    var Fv: array[4, float]
    qm_scf_h2_matvec4(F, coeffs, Fv)
    i = 0
    while i < qm_scf_h2_basis_n()
      coeffs[i] = Fv[i]
      i = i + 1
    qm_scf_h2_vec_normalize4(coeffs)
    energy = qm_scf_h2_rayleigh4(F, coeffs)
    step = step + 1
  return energy

def qm_scf_h2_density_matrix_from_coeffs(coeffs: var array[4, float], P: var array[4, array[4, float]]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    var j: int = 0
    while j < qm_scf_h2_basis_n()
      P[i][j] = 2.0 * coeffs[i] * coeffs[j]
      j = j + 1
    i = i + 1

def qm_scf_h2_fill_density_from_coeffs(coeffs: var array[4, float], dens: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var k: int = 0
  while k < qm_scf_h2_grid_n()
    var r: float = qm_scf_h2_grid_r_at(k)
    var psi: float = 0.0
    var i: int = 0
    while i < qm_scf_h2_basis_n()
      psi = psi + coeffs[i] * qm_scf_h2_basis_eval_at(i, r)
      i = i + 1
    dens[k] = psi * psi
    k = k + 1

def qm_scf_h2_fill_density_from_basis(dens: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var coeffs: array[4, float]
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    coeffs[i] = 0.0
    i = i + 1
  coeffs[0] = 1.0
  qm_scf_h2_fill_density_from_coeffs(coeffs, dens)

def qm_scf_h2_hartree_grid(dens: array[8, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var hartree: float = 0.0
  var dr: float = qm_scf_h2_grid_dr()
  var i: int = 0
  while i < qm_scf_h2_grid_n()
    var ri: float = qm_scf_h2_grid_r_at(i)
    var j: int = 0
    while j < qm_scf_h2_grid_n()
      var rj: float = qm_scf_h2_grid_r_at(j)
      var d: float = ri - rj
      if d < 0.0:
        d = -d
      hartree = hartree + 0.5 * dens[i] * dens[j] * dr * dr / (d + 0.05)
      j = j + 1
    i = i + 1
  return hartree

def qm_scf_h2_init_density(dens: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  qm_scf_h2_fill_density_from_basis(dens)

def qm_scf_h2_energy_from_density(dens: array[8, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var kin: float = 0.0
  var pot: float = 0.0
  var xc: float = 0.0
  var dr: float = qm_scf_h2_grid_dr()
  var half_bond: float = 0.5 * qm_scf_h2_bond_length_ang()
  var i: int = 0
  while i < qm_scf_h2_grid_n()
    var r: float = qm_scf_h2_grid_r_at(i)
    var rho: float = dens[i]
    var d_nuc: float = r + half_bond
    var inv_r: float = 1.0 / (d_nuc + 0.05)
    pot = pot - rho * dr * (inv_r + inv_r)
    xc = xc + qm_scf_h2_lda_xc(rho) * dr
    if i < 7:
      var dphi: float = qm_scf_h2_basis_eval(qm_scf_h2_grid_r_at(i + 1))
      dphi = dphi - qm_scf_h2_basis_eval(r)
      kin = kin + 0.5 * dphi * dphi / (dr * dr)
    i = i + 1
  var hartree: float = qm_scf_h2_hartree_grid(dens)
  return kin + pot + xc + hartree

def qm_scf_h2_scf_fock_step(dens: var array[8, float], mix: float) -> float
  requires mix > 0.0
  requires mix <= 1.0
  ensures result <= 0.0
  decreases 0
=
  var P: array[4, array[4, float]]
  var coeffs: array[4, float]
  var i: int = 0
  while i < qm_scf_h2_basis_n()
    coeffs[i] = 0.0
    i = i + 1
  coeffs[0] = 1.0
  qm_scf_h2_density_matrix_from_coeffs(coeffs, P)
  var F: array[4, array[4, float]]
  qm_scf_h2_fock_diagonal_build(P, F)
  var orb_energy: float = qm_scf_h2_eigensolve_power4(F, coeffs)
  var new_dens: array[8, float]
  qm_scf_h2_fill_density_from_coeffs(coeffs, new_dens)
  i = 0
  while i < qm_scf_h2_grid_n()
    dens[i] = (1.0 - mix) * dens[i] + mix * new_dens[i]
    i = i + 1
  return orb_energy

def qm_scf_h2_iteration_scaffold(max_iter: int) -> float
  requires max_iter >= 1
  requires max_iter <= 32
  ensures result <= 0.0
  decreases max_iter
=
  var dens: array[8, float]
  qm_scf_h2_fill_density_from_basis(dens)
  var energy: float = qm_scf_h2_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < max_iter
    var orb_e: float = qm_scf_h2_scf_fock_step(dens, mix)
    var e_new: float = qm_scf_h2_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

def qm_scf_h2_stub_energy() -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  return qm_scf_h2_iteration_scaffold(8)

def qm_scf_h2_stub_converged() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var dens: array[8, float]
  qm_scf_h2_fill_density_from_basis(dens)
  var energy: float = qm_scf_h2_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < 8
    var orb_e: float = qm_scf_h2_scf_fock_step(dens, mix)
    var e_new: float = qm_scf_h2_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    iter = iter + 1
    if de < tol:
      return 1
  return 0

def qm_scf_h2_stub_iterations() -> int
  requires true
  ensures result >= 1
  ensures result <= 8
  decreases 0
=
  var dens: array[8, float]
  qm_scf_h2_fill_density_from_basis(dens)
  var energy: float = qm_scf_h2_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < 8
    var orb_e: float = qm_scf_h2_scf_fock_step(dens, mix)
    var e_new: float = qm_scf_h2_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    iter = iter + 1
    if de < tol:
      return iter
  return 8
