# TLS proxy CL defer / upstream-hold / accounting invariants (C selftest).
extern def li_rt_httpd_proxy_relay_selftest() -> int
  requires true
  ensures -15 <= result
  ensures result <= 0

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_rt_httpd_proxy_relay_selftest() != 0:
    return 1
  return 0
