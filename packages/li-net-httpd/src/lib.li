  requires conn >= 0
  ensures true
  decreases 0
=
  var body_len: int = sz
  var ka: int = 0
  var hdr: ptr = net_buf_alloc(512)
  var hlen: int = httpd_write_response_hdr_i(hdr, 512, 200, body_len, ka)
  if hlen < 0:
    net_buf_free(hdr)
