
extern proc li_rt_sqrt(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0

type Particle = object
  public px: float
  public py: float
  public pz: float
  public vx: float
  public vy: float
  public vz: float
  public life: float

type Emitter = object
  public rate: float
  public burst: int

def li_std_physics_particles_version() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def emitter_tick(e: Emitter, dt: float) -> int
  requires dt >= 0.0
  ensures result >= 0
  decreases 0
=
  if e.burst > 0:
    return e.burst
  return 0

# Pairwise N-body acceleration (2D); accumulates into fx/fy (Newtonian, softened).
def nbody_pair_force(
    ax: float, ay: float, bx: float, by: float,
    g: float, mass: float, soft: float,
    fx: var float, fy: var float) -> unit
  requires g > 0.0
  requires mass > 0.0
  ensures true
  decreases 0
=
  var dx: float = bx - ax
  var dy: float = by - ay
  var r2: float = dx * dx + dy * dy + soft * soft
  if r2 < 1.0e-12:
    return
  var inv_r3: float = 1.0 / (li_rt_sqrt(r2) * r2)
  var scale: float = g * mass * mass * inv_r3
  fx = fx + scale * dx
  fy = fy + scale * dy

# Lennard-Jones force scalar (truncated at cutoff)
def lj_force_scalar(r: float, epsilon: float, sigma: float, rc: float) -> float
  requires r > 0.0
  requires sigma > 0.0
  requires rc > 0.0
  ensures result >= 0.0
  decreases 0
=
  if r >= rc:
    return 0.0
  var sr: float = sigma / r
  var sr6: float = sr * sr * sr * sr * sr * sr
  var sr12: float = sr6 * sr6
  return 24.0 * epsilon * (2.0 * sr12 - sr6) / r

def md_mini_forces_3d(
    px: var array[16, float], py: var array[16, float], pz: var array[16, float],
    fx: var array[16, float], fy: var array[16, float], fz: var array[16, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var epsilon: float = 1.0
  var sigma: float = 1.0
  var rc: float = 2.5
  var i: int = 0
  while i < 16
    fx[i] = 0.0
    fy[i] = 0.0
    fz[i] = 0.0
    i = i + 1
  i = 0
  while i < 16
    var j: int = i + 1
    while j < 16
      var dx: float = px[j] - px[i]
      var dy: float = py[j] - py[i]
      var dz: float = pz[j] - pz[i]
      var r2: float = dx * dx + dy * dy + dz * dz
      if r2 >= rc * rc:
        j = j + 1
        continue
      if r2 < 1.0e-12:
        j = j + 1
        continue
      var r: float = li_rt_sqrt(r2)
      var f_scalar: float = lj_force_scalar(r, epsilon, sigma, rc)
      var inv_r: float = 1.0 / r
      var fxi: float = f_scalar * dx * inv_r
      var fyi: float = f_scalar * dy * inv_r
      var fzi: float = f_scalar * dz * inv_r
      fx[i] = fx[i] - fxi
      fy[i] = fy[i] - fyi
      fz[i] = fz[i] - fzi
      fx[j] = fx[j] + fxi
      fy[j] = fy[j] + fyi
      fz[j] = fz[j] + fzi
      j = j + 1
    i = i + 1

def md_mini_step(
    px: var array[16, float], py: var array[16, float], pz: var array[16, float],
    vx: var array[16, float], vy: var array[16, float], vz: var array[16, float],
    dt: float) -> unit
  requires dt > 0.0
  ensures true
  decreases 0
=
  var fx: array[16, float]
  var fy: array[16, float]
  var fz: array[16, float]
  md_mini_forces_3d(px, py, pz, fx, fy, fz)
  var i: int = 0
  while i < 16
    vx[i] = vx[i] + fx[i] * dt
    vy[i] = vy[i] + fy[i] * dt
    vz[i] = vz[i] + fz[i] * dt
    px[i] = px[i] + vx[i] * dt
    py[i] = py[i] + vy[i] * dt
    pz[i] = pz[i] + vz[i] * dt
    i = i + 1

# WP-SCI-GPU-VENDOR-02 — 4-particle LJ force checksum witness (matches MD oracle chain layout).
def physics_particles_md_grid_force_checksum_4() -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var px: array[4, float]
  var py: array[4, float]
  var fx: array[4, float]
  var fy: array[4, float]
  var spacing: float = 1.12
  px[0] = 0.0
  py[0] = 0.0
  px[1] = spacing
  py[1] = 0.0
  px[2] = spacing + spacing
  py[2] = 0.0
  px[3] = spacing + spacing + spacing
  py[3] = 0.0
  var i: int = 0
  var epsilon: float = 1.0
  var sigma: float = 1.0
  var rc: float = 2.5
  i = 0
  while i < 4
    fx[i] = 0.0
    fy[i] = 0.0
    i = i + 1
  i = 0
  while i < 4
    var j: int = i + 1
    while j < 4
      var dx: float = px[j] - px[i]
      var dy: float = py[j] - py[i]
      var r2: float = dx * dx + dy * dy
      if r2 < rc * rc and r2 >= 1.0e-12:
        var r: float = li_rt_sqrt(r2)
        var f_scalar: float = lj_force_scalar(r, epsilon, sigma, rc)
        var inv_r: float = 1.0 / r
        var fxi: float = f_scalar * dx * inv_r
        var fyi: float = f_scalar * dy * inv_r
        fx[i] = fx[i] - fxi
        fy[i] = fy[i] - fyi
        fx[j] = fx[j] + fxi
        fy[j] = fy[j] + fyi
      j = j + 1
    i = i + 1
  var sum: float = 0.0
  i = 0
  while i < 4
    sum = sum + fx[i] * fx[i] + fy[i] * fy[i]
    i = i + 1
  return sum

def physics_particles_gpu_progress() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var px: array[16, float]
  var py: array[16, float]
  var pz: array[16, float]
  var vx: array[16, float]
  var vy: array[16, float]
  var vz: array[16, float]
  var i: int = 0
  while i < 16
    px[i] = 0.0
    py[i] = 0.0
    pz[i] = 0.0
    vx[i] = 0.1
    vy[i] = 0.0
    vz[i] = 0.0
    i = i + 1
  var k: int = 0
  while k < 64
    md_mini_step(px, py, pz, vx, vy, vz, 0.01)
    k = k + 1
  if px[0] <= 0.0:
    return 0
  return 1

# --- WP-ECHEM-10: classical MD solvent shell (LJ + Ewald stub) around echem slab ---

def echem_solvent_water_count() -> int
  requires true
  ensures result == 16
  decreases 0
=
  return 16

def echem_solvent_sphere_center_z_ang() -> float
  requires true
  ensures result > 4.0
  ensures result < 6.0
  decreases 0
=
  return 5.0

def echem_solvent_lj_epsilon_kcal() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.1521

def echem_solvent_lj_sigma_ang() -> float
  requires true
  ensures result > 3.0
  ensures result < 3.5
  decreases 0
=
  return 3.1507

def echem_solvent_lj_rc_ang() -> float
  requires true
  ensures result > 7.0
  decreases 0
=
  return 8.0

def echem_ewald_stub_kappa() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.4

def echem_ewald_stub_energy(r: float) -> float
  requires r > 0.0
  ensures result >= 0.0
  decreases 0
=
  var kappa: float = echem_ewald_stub_kappa()
  var damp: float = 1.0
  var kr: float = kappa * r
  if kr >= 6.0:
    damp = 0.0
  if kr > 0.0:
    if kr < 6.0:
      damp = 1.0 - kr / 6.0
  return damp / r

def echem_solvent_water_spacing_ang() -> float
  requires true
  ensures result > 2.5
  ensures result < 3.2
  decreases 0
=
  return 2.8

def echem_solvent_water_oxygen_x(idx: int) -> float
  requires idx >= 0
  requires idx < echem_solvent_water_count()
  ensures result >= -8.0
  ensures result <= 8.0
  decreases 0
=
  var i: int = idx
  var col: int = i % 4
  var spacing: float = echem_solvent_water_spacing_ang()
  if col == 0:
    return -1.5 * spacing
  if col == 1:
    return -0.5 * spacing
  if col == 2:
    return 0.5 * spacing
  return 1.5 * spacing

def echem_solvent_water_oxygen_y(idx: int) -> float
  requires idx >= 0
  requires idx < echem_solvent_water_count()
  ensures result >= -8.0
  ensures result <= 8.0
  decreases 0
=
  var i: int = idx
  var row: int = i / 4
  var spacing: float = echem_solvent_water_spacing_ang()
  if row == 0:
    return -1.5 * spacing
  if row == 1:
    return -0.5 * spacing
  if row == 2:
    return 0.5 * spacing
  return 1.5 * spacing

def echem_solvent_water_oxygen_z(idx: int) -> float
  requires idx >= 0
  requires idx < echem_solvent_water_count()
  ensures result > 3.0
  ensures result < 7.0
  decreases 0
=
  var i: int = idx
  var base: float = echem_solvent_sphere_center_z_ang()
  var layer: float = 0.0
  if i % 2 == 1:
    layer = 0.2
  if i >= echem_solvent_water_count() / 2:
    layer = layer + 0.4
  return base + layer

def echem_solvent_pair_distance_sq(idx_a: int, idx_b: int) -> float
  requires idx_a >= 0
  requires idx_b >= 0
  requires idx_a < echem_solvent_water_count()
  requires idx_b < echem_solvent_water_count()
  ensures result >= 0.0
  decreases 0
=
  var ia: int = idx_a
  var ib: int = idx_b
  var dx: float = echem_solvent_water_oxygen_x(ib) - echem_solvent_water_oxygen_x(ia)
  var dy: float = echem_solvent_water_oxygen_y(ib) - echem_solvent_water_oxygen_y(ia)
  var dz: float = echem_solvent_water_oxygen_z(ib) - echem_solvent_water_oxygen_z(ia)
  return dx * dx + dy * dy + dz * dz

def echem_solvent_sqrt_r2(r2: float) -> float
  requires r2 >= 0.0
  ensures result >= 0.0
  decreases 0
=
  if r2 < 1.0e-12:
    return 0.0
  var r: float = r2
  if r2 > 1.0:
    r = r2 * 0.5 + 0.5
  var k: int = 0
  while k < 8
    r = 0.5 * (r + r2 / r)
    k = k + 1
  return r

def echem_solvent_pair_lj_energy(idx_a: int, idx_b: int) -> float
  requires idx_a >= 0
  requires idx_b >= 0
  requires idx_a < echem_solvent_water_count()
  requires idx_b < echem_solvent_water_count()
  ensures result >= -100.0
  ensures result <= 100.0
  decreases 0
=
  var ia: int = idx_a
  var ib: int = idx_b
  var r2: float = echem_solvent_pair_distance_sq(ia, ib)
  if r2 < 1.0e-12:
    return 0.0
  var r: float = echem_solvent_sqrt_r2(r2)
  var rc: float = echem_solvent_lj_rc_ang()
  if r >= rc:
    return 0.0
  var eps: float = echem_solvent_lj_epsilon_kcal()
  var sig: float = echem_solvent_lj_sigma_ang()
  var sr: float = sig / r
  var sr6: float = sr * sr * sr * sr * sr * sr
  var sr12: float = sr6 * sr6
  return 4.0 * eps * (sr12 - sr6)

def echem_solvent_shell_energy_stub() -> float
  requires true
  ensures result != 0.0
  decreases 0
=
  var n: int = echem_solvent_water_count()
  var e_lj: float = 0.0
  var e_ew: float = 0.0
  var i: int = 0
  while i < n
    var j: int = i + 1
    while j < n
      e_lj = e_lj + echem_solvent_pair_lj_energy(i, j)
      var r2: float = echem_solvent_pair_distance_sq(i, j)
      if r2 > 1.0e-12:
        var r: float = echem_solvent_sqrt_r2(r2)
        e_ew = e_ew + echem_ewald_stub_energy(r)
      j = j + 1
    i = i + 1
  return e_lj + 0.01 * e_ew

def echem_solvent_gr_bin_count() -> int
  requires true
  ensures result == 16
  decreases 0
=
  return 16

def echem_solvent_gr_dr_ang() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.5

def echem_solvent_gr_bin_lo_ang(bin_idx: int) -> float
  requires bin_idx >= 0
  requires bin_idx < echem_solvent_gr_bin_count()
  ensures result >= 0.0
  decreases bin_idx
=
  if bin_idx == 0:
    return 0.0
  if bin_idx == 1:
    return 0.5
  if bin_idx == 2:
    return 1.0
  if bin_idx == 3:
    return 1.5
  if bin_idx == 4:
    return 2.0
  if bin_idx == 5:
    return 2.5
  if bin_idx == 6:
    return 3.0
  if bin_idx == 7:
    return 3.5
  if bin_idx == 8:
    return 4.0
  if bin_idx == 9:
    return 4.5
  if bin_idx == 10:
    return 5.0
  if bin_idx == 11:
    return 5.5
  if bin_idx == 12:
    return 6.0
  if bin_idx == 13:
    return 6.5
  if bin_idx == 14:
    return 7.0
  return 7.5

def echem_solvent_gr_bin_center_ang(bin_idx: int) -> float
  requires bin_idx >= 0
  requires bin_idx < echem_solvent_gr_bin_count()
  ensures result > 0.0
  decreases bin_idx
=
  var lo: float = echem_solvent_gr_bin_lo_ang(bin_idx)
  var dr: float = echem_solvent_gr_dr_ang()
  return lo + 0.5 * dr

def echem_solvent_gr_bin_hits(bin_idx: int) -> int
  requires bin_idx >= 0
  requires bin_idx < echem_solvent_gr_bin_count()
  ensures result >= 0
  decreases 0
=
  var n: int = echem_solvent_water_count()
  var dr: float = echem_solvent_gr_dr_ang()
  var hits: int = 0
  var i: int = 0
  while i < n
    var j: int = i + 1
    while j < n
      var r2: float = echem_solvent_pair_distance_sq(i, j)
      if r2 > 1.0e-12:
        var r: float = echem_solvent_sqrt_r2(r2)
        var b: int = 0
        while b < echem_solvent_gr_bin_count()
          var lo: float = echem_solvent_gr_bin_lo_ang(b)
          var hi: float = lo + dr
          if r >= lo:
            if r < hi:
              if b == bin_idx:
                hits = hits + 1
          b = b + 1
      j = j + 1
    i = i + 1
  return hits

def echem_solvent_gr_peak_r_ang() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  var best_bin: int = 0
  var best_hits: int = 0
  var b: int = 0
  while b < echem_solvent_gr_bin_count()
    var h: int = echem_solvent_gr_bin_hits(b)
    if h > best_hits:
      best_hits = h
      best_bin = b
    b = b + 1
  return echem_solvent_gr_bin_center_ang(best_bin)

def echem_solvent_gr_peak_reference_ang() -> float
  requires true
  ensures result > 2.0
  ensures result < 4.0
  decreases 0
=
  return 2.8

def echem_solvent_gr_peak_tolerance_ang() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.35

def echem_solvent_gr_peak_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var peak: float = echem_solvent_gr_peak_r_ang()
  var ref: float = echem_solvent_gr_peak_reference_ang()
  var tol: float = echem_solvent_gr_peak_tolerance_ang()
  var d: float = peak - ref
  if d < 0.0:
    d = -d
  if d > tol:
    return 0
  var e: float = echem_solvent_shell_energy_stub()
  if e == 0.0:
    return 0
  return 1

