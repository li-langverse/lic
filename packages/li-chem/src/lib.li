    return 0
  var e_h_star_stub: float = echem_dft_h_star_energy_hartree()
  var e_h2_stub: float = echem_dft_h2_energy_hartree()
  var delta_stub: float = e_h_star_stub - 0.5 * e_h2_stub
  var stub0: float = echem_hartree_to_ev(delta_stub)
  var de: float = u0 - stub0
