import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd210: SimRunResult = run_algo(210, 2)
  if run_result_ok(cfd210) != 1:
    return 1
  if cfd210.algo_id != 210:
    return 2
  if cfd210.checksum != sim_scientific_oracle_checksum_cfd():
    return 3
  if cfd210.checksum == 1.001:
    return 4
  var fea214: SimRunResult = run_algo(214, 1)
  if run_result_ok(fea214) != 1:
    return 5
  if fea214.algo_id != 214:
    return 6
  if fea214.checksum != sim_scientific_oracle_checksum_fea():
    return 7
  if fea214.checksum == 1.001:
    return 8
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 9
  if qm418.checksum != sim_scientific_oracle_checksum_qm_dft():
    return 10
  if qm418.checksum == 1.001:
    return 11
  var qm405: SimRunResult = run_algo(405, 0)
  if run_result_ok(qm405) != 1:
    return 12
  if qm405.checksum != sim_scientific_oracle_checksum_qm_dft():
    return 13
  if qm405.checksum == 1.001:
    return 14
  return 0
