# UiSnapshot — serializable shell element tree with stable dot-path ID tags (WREC W0).

extern proc li_rt_ui_snapshot_id_name(tag: int) -> str
  requires tag >= 0
  ensures result != ""
  decreases tag

extern proc li_rt_ui_snapshot_tag_from_id(id: str) -> int
  requires true
  ensures result >= 0
  decreases 0

