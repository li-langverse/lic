# WP-CTN-010 — OCI image spec constants (pure Li; no Container effect).

def oci_spec_version() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def oci_spec_image_manifest_version() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def oci_spec_image_index_version() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def oci_media_type_manifest_v2() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def oci_media_type_config_v1() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def oci_media_type_layer_v1() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

def oci_spec_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if oci_spec_version() != 1:
    return 1
  if oci_spec_image_manifest_version() != 2:
    return 2
  if oci_spec_image_index_version() != 2:
    return 3
  if oci_media_type_manifest_v2() != 1:
    return 4
  if oci_media_type_config_v1() != 2:
    return 5
  if oci_media_type_layer_v1() != 3:
    return 6
  return 0
