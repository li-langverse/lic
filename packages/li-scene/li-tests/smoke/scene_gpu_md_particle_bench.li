# PH-SCI-GPU-09: @gpu MD particle tier bench loop (simulation viz vertical).
import scene

@gpu
def scene_gpu_md_particle_bench_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var draw: SceneParticleDraw = scene_bench_particle_tier_simulate(scene_md_tier_10k())
  if draw.meets_target != 1:
    return 0
  if scene_md_particle_display_fps(draw) < 30:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if scene_gpu_md_particle_bench_smoke() != 1:
    return 1
  return 0
