# PH-SCI-GPU-18: @gpu DFT energy + LKIR launch pipeline (compile_open_ok; vendor CUDA optional).
import chem

@gpu
def chem_gpu_dft_lkir_smoke() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var e: float = chem_dft_energy_kernel_hartree()
  if e >= 0.0:
    return 0
  if chem_dft_gpu_lkir_progress() != 1:
    return 0
  return chem_dft_gpu_lkir_launch_pipeline()

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if chem_gpu_dft_lkir_smoke() != 1:
    return 1
  return 0
