import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if echem_sei_kmc_step_count() != 48:
    return 1
  if echem_sei_kmc_growth_smoke() != 1:
    return 2
  var rel_err: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  if rel_err >= 0.35:
    return 3
  var kmc: SimRunResult = run_algo(algo_echem_sei_kmc(), 0)
  if run_result_ok(kmc) != 1:
    return 4
  if kmc.checksum != rel_err:
    return 5
  if kmc.checksum == 1.001:
    return 6
  return 0
