import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  if sim_scientific_oracle_checksum_cfd() != 4.0:
    return 4
  if fea_oracle_bar_chain_checksum() != 3.0:
    return 5
  if sim_scientific_oracle_checksum_qm_dft() > -0.5:
    return 6
  var heat_run: SimRunResult = run_heat_smoke(0)
  if heat_run.checksum != sim_scientific_oracle_checksum_heat():
    return 10
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if md_run.checksum != sim_scientific_oracle_checksum_md():
    return 8
  return 0
