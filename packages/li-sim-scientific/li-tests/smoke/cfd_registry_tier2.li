import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd_run: SimRunResult = run_algo(206, 0)
  if run_result_ok(cfd_run) != 1:
    return 1
  if cfd_run.algo_id != 206:
    return 2
  if cfd_run.checksum != sim_scientific_oracle_checksum_cfd():
    return 3
  if cfd_run.checksum == 1.001:
    return 4
  return 0
