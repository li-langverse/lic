# PH-SCI-GPU-15: @gpu 6-DOF session IK step (robotics simulation vertical).
import sim.robotics

@gpu
def robo_gpu_ik_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return sim_robotics_gpu_ik_progress()

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if robo_gpu_ik_smoke() != 1:
    return 1
  return 0
