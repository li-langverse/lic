import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fea: float = sim_scientific_oracle_checksum_fea()
  if fea != 8.0:
    return 1
  var cfd: float = sim_scientific_oracle_checksum_cfd_lid()
  if cfd != 0.8:
    return 2
  var fea214: SimRunResult = run_algo(algo_fea_linear_elasticity(), 0)
  if fea214.checksum != fea:
    return 3
  var cfd206: SimRunResult = run_algo(algo_cfd_simple(), 0)
  if cfd206.checksum != cfd:
    return 4
  if cfd206.checksum == 1.001:
    return 5
  return 0
