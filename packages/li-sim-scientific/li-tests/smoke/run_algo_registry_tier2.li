def tier2_check_fea() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var fea214: SimRunResult = run_algo(214, 0)
  var fea_oracle: float = sim_scientific_oracle_checksum_fea()
  if fea214.checksum != fea_oracle:
    return 38
  if fea214.ok != 1:
    return 36
  if fea214.algo_id != 214:
    return 37
  if fea214.checksum == 1.001:
    return 39
  return 0

def tier2_check_qm() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var qm_oracle: float = sim_scientific_oracle_checksum_qm()
  if qm_oracle == 1.001:
    return 13
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if qm418.ok != 1:
    return 12
  if qm418.checksum == 1.001:
    return 40
  return 0

def tier2_check_drug_stub() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var drug501: SimRunResult = run_algo(algo_drug_litl_stages(), 0)
  if drug501.ok != 1:
    return 41
  if drug501.checksum != 1.001:
    return 42
  return 0

def tier2_check_echem() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if aimd433.ok != 1:
    return 16
  if aimd433.algo_id != 433:
    return 17
  if aimd433.checksum == 1.001:
    return 19
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if gc434.ok != 1:
    return 22
  if gc434.algo_id != 434:
    return 23
  if gc434.checksum == 1.001:
    return 25
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if sei435.ok != 1:
    return 28
  if sei435.algo_id != 435:
    return 29
  if sei435.checksum == 1.001:
    return 31
  return 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var r0: int = tier2_check_md()
  if r0 != 0:
    return r0
  var r1: int = tier2_check_heat()
  if r1 != 0:
    return r1
  var r2: int = tier2_check_rigid()
  if r2 != 0:
    return r2
  var r3: int = tier2_check_cfd()
  if r3 != 0:
    return r3
  var r4: int = tier2_check_fea()
  if r4 != 0:
    return r4
  var r5: int = tier2_check_drug_stub()
  if r5 != 0:
    return r5
  var r6: int = tier2_check_echem()
  if r6 != 0:
    return r6
  var r7: int = tier2_check_qm()
  if r7 != 0:
    return r7
  return 0
