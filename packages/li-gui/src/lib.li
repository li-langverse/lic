  return layout3.bounds

def inspector_pilot_empty_hint_rect(layout: InspectorPilotLayoutResult, line: int) -> Rect
  requires layout.has_selection == 0
  requires line >= 0
  requires line <= 1
  ensures result.w >= 0.0
  decreases line
=
  if line == 0:
    var layout0: WidgetLayoutResult = layout.hints_layout.child_layouts[0]
    return layout0.bounds
  var layout1: WidgetLayoutResult = layout.hints_layout.child_layouts[1]
  return layout1.bounds

def inspector_pilot_empty_hint_box_rect(layout: InspectorPilotLayoutResult) -> Rect
