type PaintCmd = object
  public kind: int
  public rect: Rect
  public color: Color
  public stroke_px: float
  public radius_px: float
  public color_b: Color
  public face_id: int
  public codepoint: int
  public glyph_count: int
  public image_id: int
  public src_rect: Rect

def paint_cmd_ext_zero(c: var PaintCmd) -> unit
  requires true
  ensures c.face_id == 0
  ensures c.codepoint == 0
  ensures c.glyph_count == 0
  ensures c.image_id == 0
  decreases 0
=
  c.face_id = 0
  c.codepoint = 0
  c.glyph_count = 0
  c.image_id = 0
  c.src_rect = rect_make(0.0, 0.0, 0.0, 0.0)

type PaintFrame = object
  public cmd_count: int
  public last_kind: int
  public last_rect: Rect
  public last_color: Color

def paint_frame_new() -> PaintFrame
  requires true
  ensures result.cmd_count == 0
  decreases 0
=
  var f: PaintFrame
  f.cmd_count = 0
  f.last_kind = 0
  f.last_rect = rect_make(0.0, 0.0, 0.0, 0.0)
  f.last_color = studio_color_bg_primary()
  return f

def paint_frame_push(frame: var PaintFrame, cmd: PaintCmd) -> unit
  requires frame.cmd_count >= 0
  requires cmd.kind >= paint_op_fill_rect()
  requires cmd.kind <= paint_op_kind_max()
  ensures frame.cmd_count == old(frame.cmd_count) + 1
  decreases 0
=
  frame.cmd_count = frame.cmd_count + 1
  frame.last_kind = cmd.kind
  frame.last_rect = cmd.rect
  frame.last_color = cmd.color

def paint_cmd_fill(rect: Rect, color: Color) -> PaintCmd
  requires rect.w >= 0.0
  requires rect.h >= 0.0
  ensures result.kind == paint_op_fill_rect()
  decreases 0
=
  var c: PaintCmd
  c.kind = paint_op_fill_rect()
  c.rect = rect
  c.color = color
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  paint_cmd_ext_zero(c)
  return c

