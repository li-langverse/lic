import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd206: SimRunResult = run_algo(algo_cfd_simple(), 1)
  if run_result_ok(cfd206) != 1:
    return 33
  if cfd206.algo_id != 206:
    return 34
  var cfd_oracle: float = sim_scientific_oracle_checksum_cfd()
  if cfd206.checksum != cfd_oracle:
    return 35
  if cfd206.vertical_id != vertical_cfd_lid_driven_cavity():
    return 37
  var fea212: SimRunResult = run_algo(algo_fea_linear_elasticity(), 2)
  if run_result_ok(fea212) != 1:
    return 39
  if fea212.algo_id != 212:
    return 40
  var fea_oracle: float = sim_scientific_oracle_checksum_fea()
  if fea212.checksum != fea_oracle:
    return 41
  if fea212.vertical_id != vertical_fea_linear_elasticity():
    return 43
  return 0
