# PH-SCI-GPU-11: @gpu scientific viz pipeline step loop.
import sim.viz

@gpu
def viz_gpu_pipeline_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return sim_viz_gpu_progress()

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if viz_gpu_pipeline_smoke() != 1:
    return 1
  return 0
