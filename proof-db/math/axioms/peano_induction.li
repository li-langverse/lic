# M-AX-PEANO-IND: Peano induction schema (base + step ⇒ ∀ n, P n).

def proof_db_peano_induction(base_holds: int, step_holds: int)-> int
  requires base_holds >= 0 and step_holds >= 0
  ensures (base_holds == 1 and step_holds == 1) implies (result == 1)
  decreases 0
=
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
