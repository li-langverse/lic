# std/execution/memory_spaces.li — Kokkos-class memory + execution space enums (PH-7e, #110)
#
# Spec-only v1: static placement tags for tier-2 physics migration.
# No runtime space discovery; no implicit DualView sync.
# See docs/hpc/kokkos-memory-execution-spaces-rubric.md

# MemorySpace — where buffer bytes are resident (Kokkos::MemorySpace analog)
def memory_space_host() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def memory_space_device() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def memory_space_unified() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

# ExecutionSpace — which parallel backend runs a kernel (Kokkos::ExecutionSpace analog)
def execution_space_serial() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def execution_space_openmp() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def execution_space_threads() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

# Reserved for #116 offload: execution_space_sycl, execution_space_cuda, execution_space_hip

# View[T, Space, Layout] — spec placeholder; layout ABI owned by #128
type View = object

def view_space_host() -> int
  requires true
  ensures result == memory_space_host()
  decreases 0
=
  return memory_space_host()

def view_space_device() -> int
  requires true
  ensures result == memory_space_device()
  decreases 0
=
  return memory_space_device()

def default_execution_space_tier2() -> int
  requires true
  ensures result == execution_space_openmp()
  decreases 0
=
  return execution_space_openmp()

def __memory_spaces_doc() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
