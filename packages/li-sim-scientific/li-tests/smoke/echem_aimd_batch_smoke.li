import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if echem_aimd_batch_steps_valid(64) != 1:
    return 1
  if echem_aimd_batch_steps_valid(32) != 0:
    return 2
  if echem_aimd_batch_steps_valid(10001) != 0:
    return 3
  var batch: AimdBatchResult = echem_aimd_batch_run(64)
  if batch.ok != 1:
    return 4
  if batch.steps != 64:
    return 5
  if batch.checksum_ok != 1:
    return 6
  if batch.gpu_path != echem_aimd_batch_gpu_path_select():
    return 7
  return 0
