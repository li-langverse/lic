import sim.viz
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var s: VizPipelineState = viz_pipeline_init()
  var heat: float = sim_scientific_oracle_checksum_heat()
  var chk: float = viz_wgpu_field_draw_step(s, heat)
  if chk <= 0.0:
    return 1
  return 0
