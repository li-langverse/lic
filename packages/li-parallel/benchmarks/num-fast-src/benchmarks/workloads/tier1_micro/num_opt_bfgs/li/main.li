# Pure-Li num_opt_bfgs — same nested loops as C (no LI_EXTRA_C bloat).

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var x: array[4, float]
  var g: array[4, float]
  var acc: float = 0.0
  var r: int = 0
  while r < 20000
    x[0] = 0.5
    x[1] = -1.0
    x[2] = 0.25
    x[3] = 0.75
    var it: int = 0
    while it < 12
      var i: int = 0
      while i < 4
        var gi: float = 0.0
        var j: int = 0
        while j < 4
          var scale: float = 0.1
          if j == i:
            scale = 1.0
          gi = gi + 2.0 * x[j] * scale
          j = j + 1
        g[i] = gi + 1.0
        i = i + 1
      i = 0
      while i < 4
        x[i] = x[i] - 0.01 * g[i]
        i = i + 1
      it = it + 1
    i = 0
    while i < 4
      acc = acc + x[i]
      i = i + 1
    r = r + 1
  li_rt_volatile_sink_f64(acc)
  return 0
