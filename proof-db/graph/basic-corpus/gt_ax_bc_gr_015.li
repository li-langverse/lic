# GT-AX-BC-GR-015: Adjacency symmetry: A[i,j] = A[j,i] for simple undirected graphs.
# Simple graph: irreflexive and symmetric adjacency (no self-loops).

def simple_graph_symmetric(adj_ij: int, adj_ji: int) -> int
  requires true
  ensures result == adj_ji
  decreases 0
=
  return adj_ji

extern proc gt_ax_bc_gr_015_axiom_witness() -> int
  requires true
  ensures result == 0
  decreases 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
