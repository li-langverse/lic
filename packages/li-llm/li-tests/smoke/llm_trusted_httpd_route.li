import llm

def main() -> int raises IO, Alloc
  requires true
  ensures result == 0
  decreases 0
=
  if li_llm_version() < 6:
    return 1
  if llm_trusted_backend_li_httpd_route() != 1:
    return 2
  if llm_trusted_backend_li_httpd_path_note() != 1:
    return 3
  var w: LlmModelWeights = llm_load_weights("fixtures/ph-ml-weights/model.safetensors")
  var tracked: LlmGenerateResult = llm_generate_tracked("hi", w, "fixtures/vocab.json", 8)
  if tracked.forward_matmul != 1:
    return 4
  if tracked.decode_steps < 8:
    return 5
  if tracked.token_count < 8:
    return 6
  return 0
