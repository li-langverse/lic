# D-LM-BC-IND-006: Strong induction: if P(0) and forall k ((forall j <= k P(j)) implies P(k+1)) then forall n P(n).

def induction_step(n: int, step: int) -> int
  requires n >= 0 and step >= 0
  ensures result == n + step
  decreases 0
=
  return n + step

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
