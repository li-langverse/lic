extern def li_dpar_rank() -> int
  requires true
  ensures result >= 0

extern def li_dpar_world_size() -> int
  requires true
  ensures result >= 1

extern def li_dpar_barrier() -> unit
  requires true
  ensures true

extern def li_dpar_block_partition_begin(global_n: int, rank: int, world: int) -> int
  requires global_n >= 0
  requires rank >= 0
  requires world > 0
  ensures result >= 0
  ensures result <= global_n

extern def li_dpar_block_partition_end(global_n: int, rank: int, world: int) -> int
  requires global_n >= 0
  requires rank >= 0
  requires world > 0
  ensures result >= 0
  ensures result <= global_n

def rank() -> int raises IO
  requires true
  ensures result >= 0
  decreases 0
=
  return li_dpar_rank()

def world_size() -> int raises IO
  requires true
  ensures result >= 1
  decreases 0
=
  return li_dpar_world_size()

def barrier() -> unit raises IO
  requires true
  ensures true
  decreases 0
=
  li_dpar_barrier()

extern def li_dpar_scatter_f64(sendbuf: ptr, recvbuf: ptr, sendcount: int, root: int) -> unit
  requires true
  ensures true

extern def li_dpar_gather_f64(sendbuf: ptr, recvbuf: ptr, sendcount: int, root: int) -> unit
  requires true
  ensures true

extern def li_dpar_scan_sum_f64(local: float, out: ptr) -> unit
  requires true
  ensures true

def scatter_f64(sendbuf: ptr, recvbuf: ptr, sendcount: int, root: int) -> unit raises IO
  requires sendcount >= 0
  requires root >= 0
  ensures true
  decreases sendcount
=
  li_dpar_scatter_f64(sendbuf, recvbuf, sendcount, root)

def gather_f64(sendbuf: ptr, recvbuf: ptr, sendcount: int, root: int) -> unit raises IO
  requires sendcount >= 0
  requires root >= 0
  ensures true
  decreases sendcount
=
  li_dpar_gather_f64(sendbuf, recvbuf, sendcount, root)

def scan_sum_f64(local: float, out: ptr) -> unit raises IO
  requires true
  ensures true
  decreases 0
=
  li_dpar_scan_sum_f64(local, out)

def block_partition_begin(global_n: int, rank_id: int, world: int) -> int raises IO
  requires global_n >= 0
  requires rank_id >= 0
  requires world > 0
  ensures result >= 0
  ensures result <= global_n
  decreases global_n
=
  return li_dpar_block_partition_begin(global_n, rank_id, world)

def block_partition_end(global_n: int, rank_id: int, world: int) -> int raises IO
  requires global_n >= 0
  requires rank_id >= 0
  requires world > 0
  ensures result >= 0
  ensures result <= global_n
  decreases global_n
=
  return li_dpar_block_partition_end(global_n, rank_id, world)
