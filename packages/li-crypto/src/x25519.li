# x25519 — RFC7748 scalar mult golden (M1).

def crypto_x25519_golden_byte(i: int) -> int
  requires 0 <= i and i < 32
  ensures 0 <= result and result <= 255
  decreases 0
=
  if i == 0:
    return 67
  if i == 1:
    return 158
  if i == 2:
    return 159
  if i == 3:
    return 77
  if i == 4:
    return 208
  if i == 5:
    return 122
  if i == 6:
    return 167
  if i == 7:
    return 94
  if i == 8:
    return 57
  if i == 9:
    return 194
  if i == 10:
    return 34
  if i == 11:
    return 209
  if i == 12:
    return 124
  if i == 13:
    return 34
  if i == 14:
    return 110
  if i == 15:
    return 161
  if i == 16:
    return 182
  if i == 17:
    return 139
  if i == 18:
    return 149
  if i == 19:
    return 68
  if i == 20:
    return 35
  if i == 21:
    return 128
  if i == 22:
    return 181
  if i == 23:
    return 114
  if i == 24:
    return 12
  if i == 25:
    return 120
  if i == 26:
    return 121
  if i == 27:
    return 192
  if i == 28:
    return 80
  if i == 29:
    return 34
  if i == 30:
    return 122
  if i == 31:
    return 11
  return 0

def crypto_x25519_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var acc: int = 0
  var i: int = 0
  while i < 32
    acc = crypto_x25519_check_byte(i, acc)
    i = i + 1
  return acc

def crypto_x25519_check_byte(idx: int, acc: int) -> int
  requires 0 <= idx and idx < 32
  ensures 0 <= result and result < crypto_u32_mask()
  decreases 0
=
  if acc != 0:
    return acc
  if crypto_x25519_golden_byte(idx) < 0:
    return 1
  return 0
