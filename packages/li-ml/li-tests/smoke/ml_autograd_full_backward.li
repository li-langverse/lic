import ml

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if ml_autograd_workload_class() != 2:
    return 1
  var x: array[8, array[8, float]]
  var w1: array[8, array[8, float]]
  var w2: array[8, array[8, float]]
  var y: array[8, array[8, float]]
  var loss: float = 0.0
  x[0][0] = 1.0
  x[0][1] = 1.0
  w1[0][0] = 1.0
  w1[0][1] = 0.0
  w1[1][0] = 0.0
  w1[1][1] = 1.0
  w2[0][0] = 1.0
  w2[1][0] = 1.0
  if ml_mlp_train_step_f32(2, 2, 1, x, w1, w2, y, loss) != 1:
    return 2
  if loss < 0.5:
    return 3
  return 0
