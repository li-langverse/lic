# Parallel BLAS-style kernels (WP-PAR-31).

def par_axpy(n: int, a: float, x: array[1024, float], y: var array[1024, float]) -> unit
  requires n >= 0
  requires n <= 1024
  ensures true
  decreases n
=
  var i: int = 0
  while i < n
    y[i] = y[i] + a * x[i]
    i = i + 1

def par_copy(n: int, src: array[1024, float], dst: var array[1024, float]) -> unit
  requires n >= 0
  requires n <= 1024
  ensures true
  decreases n
=
  var i: int = 0
  while i < n
    dst[i] = src[i]
    i = i + 1

def par_outer_product_elem(row: int, col: int, x0: float, x1: float, y0: float, y1: float) -> float
  requires row >= 0
  requires col >= 0
  requires row < 2
  requires col < 2
  ensures true
  decreases row + col
=
  if row == 0:
    if col == 0:
      return x0 * y0
    return x0 * y1
  if col == 0:
    return x1 * y0
  return x1 * y1

def par_matmul_outer(
  m: int, n: int, x: array[8, float], y: array[8, float], c: var array[8, array[8, float]]
) -> unit
  requires m == 2
  requires n == 2
  ensures true
  decreases 0
=
  c[0][0] = par_outer_product_elem(0, 0, x[0], x[1], y[0], y[1])
  c[0][1] = par_outer_product_elem(0, 1, x[0], x[1], y[0], y[1])
  c[1][0] = par_outer_product_elem(1, 0, x[0], x[1], y[0], y[1])
  c[1][1] = par_outer_product_elem(1, 1, x[0], x[1], y[0], y[1])
