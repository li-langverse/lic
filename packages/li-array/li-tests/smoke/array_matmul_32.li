import array
import ml

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[64, float]
  var b: array[64, float]
  var c: array[64, float]
  var i: int = 0
  while i < 8
    var fi: int = ml_matmul_flat_idx(i, i, 8)
    a[fi] = 1.0
    b[fi] = 1.0
    i = i + 1
  var ad: ArrayDesc = array_desc_2d(32, 32, 32, array_storage_flat())
  var bd: ArrayDesc = array_desc_2d(32, 32, 32, array_storage_flat())
  if array_matmul_shape_ok(ad, bd) != 1:
    return 1
  if array_matmul(ad, a, bd, b, c) != 1:
    return 2
  if c[0] < 0.9 or c[0] > 1.1:
    return 3
  return 0
