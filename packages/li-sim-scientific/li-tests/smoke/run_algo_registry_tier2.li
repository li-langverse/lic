import sim
import sim.scientific

def tier2_check_md() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var r: SimRunResult = run_algo(105, 1)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_md():
    return 3
  if chk == 1.001:
    return 4
  if r.algo_id != 105:
    return 2
  if r.ok != 1:
    return 1
  return 0

def tier2_check_heat() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var r: SimRunResult = run_algo(201, 2)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_heat():
    return 7
  if chk == 1.001:
    return 8
  if r.algo_id != 201:
    return 6
  if r.ok != 1:
    return 5
  return 0

def tier2_check_cfd() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if sim_scientific_oracle_checksum_cfd() <= 0.0:
    return 32
  var r: SimRunResult = run_algo(algo_cfd_simple(), 1)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_cfd():
    return 35
  if chk == 1.001:
    return 36
  if r.algo_id != 206:
    return 34
  if r.ok != 1:
    return 33
  return 0

def tier2_check_fea() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if sim_scientific_oracle_checksum_fea() <= 0.0:
    return 37
  var r: SimRunResult = run_algo(algo_fea_linear_elasticity(), 1)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_fea():
    return 40
  if chk == 1.001:
    return 41
  if r.algo_id != 214:
    return 39
  if r.ok != 1:
    return 38
  return 0

def tier2_check_rigid() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var r: SimRunResult = run_algo(302, 0)
  var chk: float = r.checksum
  if chk == 1.001:
    return 11
  if r.algo_id != 302:
    return 10
  if r.ok != 1:
    return 9
  return 0

def tier2_check_qm() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if sim_scientific_oracle_checksum_qm() >= 0.0:
    return 12
  var r: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_qm():
    return 42
  if chk == 1.001:
    return 43
  if r.ok != 1:
    return 13
  return 0

def tier2_check_echem_aimd() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if sim_scientific_oracle_checksum_echem_aimd() <= 0.0:
    return 14
  if sim_scientific_oracle_checksum_echem_aimd() >= 1.0e-2:
    return 15
  var r: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_echem_aimd():
    return 18
  if chk == 1.001:
    return 19
  if r.algo_id != 433:
    return 17
  if r.ok != 1:
    return 16
  return 0

