import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != sim_scientific_oracle_checksum_md():
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat201: SimRunResult = run_algo(201, 2)
  if run_result_ok(heat201) != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat201.checksum != sim_scientific_oracle_checksum_heat():
    return 7
  if heat201.checksum == 1.001:
    return 8
  var cfd206: SimRunResult = run_algo_registry(206, 1)
  if run_result_ok(cfd206) != 1:
    return 9
  if cfd206.algo_id != 206:
    return 10
  if cfd206.checksum != sim_scientific_oracle_checksum_cfd():
    return 11
  if cfd206.checksum == 1.001:
    return 12
  if cfd206.vertical_id != vertical_cfd_lid_driven_cavity():
    return 13
  var fea212: SimRunResult = run_algo_registry(212, 0)
  if run_result_ok(fea212) != 1:
    return 14
  if fea212.algo_id != 212:
    return 15
  if fea212.checksum != sim_scientific_oracle_checksum_fea():
    return 16
  if fea212.checksum == 1.001:
    return 17
  if fea212.vertical_id != vertical_fea_linear_elasticity():
    return 18
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 19
  if rigid302.algo_id != 302:
    return 20
  if rigid302.checksum == 1.001:
    return 21
  var qm_oracle: float = sim_scientific_oracle_checksum_qm()
  if qm_oracle <= 0.0:
    return 22
  if qm_oracle >= 10.0:
    return 23
  var qm401: SimRunResult = run_algo(401, 0)
  if run_result_ok(qm401) != 1:
    return 24
  if qm401.algo_id != 401:
    return 25
  if qm401.checksum != qm_oracle:
    return 26
  if qm401.checksum == 1.001:
    return 27
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 28
  if qm418.algo_id != 418:
    return 29
  if qm418.checksum != qm_oracle:
    return 30
  if qm418.checksum == 1.001:
    return 31
  var echem_oracle: float = sim_scientific_oracle_checksum_echem_aimd()
  if echem_oracle <= 0.0:
    return 32
  if echem_oracle >= 1.0e-2:
    return 33
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 34
  if aimd433.algo_id != 433:
    return 35
  if aimd433.checksum != echem_oracle:
    return 36
  if aimd433.checksum == 1.001:
    return 37
  var gc_oracle: float = sim_scientific_oracle_checksum_echem_gc_aimd()
  if gc_oracle <= 0.0:
    return 38
  if gc_oracle >= 0.05:
    return 39
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 40
  if gc434.algo_id != 434:
    return 41
  if gc434.checksum != gc_oracle:
    return 42
  if gc434.checksum == 1.001:
    return 43
  var sei_oracle: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  if sei_oracle <= 0.0:
    return 44
  if sei_oracle >= 0.35:
    return 45
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 46
  if sei435.algo_id != 435:
    return 47
  if sei435.checksum != sei_oracle:
    return 48
  if sei435.checksum == 1.001:
    return 49
  return 0
