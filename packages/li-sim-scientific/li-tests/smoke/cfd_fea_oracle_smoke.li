import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fea: float = sim_scientific_oracle_checksum_fea()
  if fea != 3.0:
    return 1
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  if cfd <= 0.0:
    return 2
  if cfd >= 10.0:
    return 3
  var cfd511: SimRunResult = run_algo(511, 0)
  if run_result_ok(cfd511) != 1:
    return 4
  if cfd511.checksum == 1.001:
    return 50
  if cfd511.algo_id != 511:
    return 51
  var diff: float = cfd511.checksum - cfd
  if diff < 0.0:
    diff = -diff
  if diff > 1.0e-9:
    return 5
  if cfd511.checksum == 1.001:
    return 6
  var fea521: SimRunResult = run_algo(521, 0)
  if run_result_ok(fea521) != 1:
    return 7
  if fea521.checksum != fea:
    return 8
  if fea521.checksum == 1.001:
    return 9
  return 0
