import array

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[64, float]
  var b: array[64, float]
  var c: array[64, float]
  a[0] = 1.0
  a[1] = 0.0
  a[2] = 0.0
  a[3] = 1.0
  a[4] = 2.0
  a[5] = 0.0
  a[6] = 0.0
  a[7] = 2.0
  b[0] = 1.0
  b[1] = 1.0
  b[2] = 1.0
  b[3] = 1.0
  b[4] = 1.0
  b[5] = 2.0
  b[6] = 3.0
  b[7] = 4.0
  var ad: ArrayDesc = array_desc_3d(2, 2, 2, 2, array_storage_flat())
  var bd: ArrayDesc = array_desc_3d(2, 2, 2, 2, array_storage_flat())
  if array_matmul_batch_shape_ok(ad, bd) != 1:
    return 1
  if array_matmul_batch(ad, a, bd, b, c) != 1:
    return 2
  if c[0] < 0.9 or c[0] > 1.1:
    return 3
  if c[7] < 7.9 or c[7] > 8.1:
    return 4
  return 0
