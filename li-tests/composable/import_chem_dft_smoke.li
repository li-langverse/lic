import sim
import sim.scientific
import chem

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var e_chem: float = echem_dft_h2_energy_hartree()
  if e_chem >= 0.0:
    return 1
  var qm: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm) != 1:
    return 2
  if qm.algo_id != algo_qm_dft_scf_energy():
    return 3
  if qm.checksum != e_chem:
    return 4
  if qm.checksum == 1.001:
    return 5
  var vert: SimRunResult = run_simulation(vertical_qm_dft(), 0)
  if run_result_ok(vert) != 1:
    return 6
  if vert.checksum != e_chem:
    return 7
  return 0
