def par_disjoint_lookup_rotate(buf: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  parallel for j in 0..<8
    requires disjoint_lookup(j, (j + 1) % 8, buf)
    decreases 8 - j
  =
    buf[(j + 1) % 8] = 0.0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var buf: array[8, float]
  par_disjoint_lookup_rotate(buf)
  return 0
