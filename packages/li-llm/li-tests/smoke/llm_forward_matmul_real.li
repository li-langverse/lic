import llm

def main() -> int raises IO, Alloc
  requires true
  ensures result == 0
  decreases 0
=
  if li_llm_version() != 6:
    return 1
  var w: LlmModelWeights = llm_load_weights("fixtures/ph-ml-weights/model.safetensors")
  if llm_weights_use_matmul_forward(w) != 1:
    return 2
  var tok: LlmTokenIds = llm_tokenize("ab", "fixtures/vocab.json")
  var cache: LlmKVCache
  cache.seq_len = 0
  cache.forward_matmul = 0
  var logits: LlmLogits = llm_forward(tok, w, cache)
  if cache.forward_matmul != 1:
    return 3
  if logits.vocab_size != 256:
    return 4
  return 0
