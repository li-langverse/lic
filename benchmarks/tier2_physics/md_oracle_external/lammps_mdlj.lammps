# LAMMPS input skeleton — md_oracle_external v0_micro (stub; not executed in CI)
# Align with md_lennard_jones params.toml when B1 driver lands.
# Pinned: stable_22Jun2024

units           lj
atom_style      atomic
boundary        p p p

lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box

mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

velocity        all create 0.8 7
fix             1 all nve

timestep        0.004
run             10000
