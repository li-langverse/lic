# PH-SCI-GPU-06: @gpu wavefunction normalization (quantum vertical).
import physics.quantum

@gpu
def physics_gpu_quantum_normalize_smoke() raises IO -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return physics_quantum_gpu_progress()

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  if physics_gpu_quantum_normalize_smoke() != 1:
    return 1
  return 0
