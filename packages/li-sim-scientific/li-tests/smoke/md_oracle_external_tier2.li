# WP-SCI-03 / md-r3-oracle-plan — algo 104 md_oracle_external cites Li internal oracle.
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var oracle: float = sim_scientific_oracle_checksum_md()
  if oracle <= 0.0:
    return 1
  if oracle >= 1.0e-3:
    return 2
  var r: SimRunResult = run_algo(104, 1)
  if run_result_ok(r) != 1:
    return 3
  if r.algo_id != 104:
    return 4
  if r.checksum != oracle:
    return 5
  if r.checksum == 1.001:
    return 6
  return 0
