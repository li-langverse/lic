# GT-LM-BC-HS-046: Multigraph: counting edge incidences gives sum deg(v) = 2|E|.

def handshaking_sum(deg_sum: int, edge_count: int) -> int
  requires edge_count >= 0
  ensures result == 2 * edge_count
  decreases 0
=
  return deg_sum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
