import std.csv
import std.io

def main() -> int raises Alloc
  requires true
  ensures result == 0
  decreases 0
=
  var tag: int = csv_tag() + io_tag()
  if tag != 10:
    return 1
  var csv_path: Path = "bench.csv"
  var body: str = file_read_all(csv_path)
  if body != "":
    return 2
  return 0
