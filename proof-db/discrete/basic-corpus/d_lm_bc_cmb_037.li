# D-LM-BC-CMB-037: Binomial theorem: (x+y)^n = sum_{k=0}^n C(n,k) x^k y^(n-k).

def binomial_symmetry(n: int, k: int) -> int
  requires n >= 0 and 0 <= k and k <= n
  ensures result == n - k
  decreases 0
=
  return n - k

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
