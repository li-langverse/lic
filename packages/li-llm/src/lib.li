def llm_dtype_f32() -> int raises Alloc
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def llm_dtype_f16() -> int raises Alloc
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def llm_safetensors_parse_header_file(path: str) -> LlmSafetensorsHeader raises IO, Alloc
  requires true
  ensures result.tensors_loaded == 0
  decreases 0
=
  var h: LlmSafetensorsHeader = llm_safetensors_header_none()
  var p_chk: str = path
  if llm_weights_file_exists(p_chk) != 1:
    return h
  var p_probe: str = path
  if li_rt_llm_safetensors_probe_path(p_probe) != 1:
    return h
  var hdr_len: int = li_rt_llm_last_safetensors_header_len()
  var tc: int = li_rt_llm_last_safetensors_tensor_count()
  var data_off: int = li_rt_llm_last_safetensors_data_offset()
  if hdr_len <= 0:
    return h
  if tc <= 0:
    return h
  if data_off <= 0:
    return h
  h.parsed_ok = 1
  h.header_len = hdr_len
  h.tensor_count = tc
  h.data_offset = data_off
  h.first_dtype = li_rt_llm_last_safetensors_first_dtype()
  h.first_shape0 = li_rt_llm_last_safetensors_first_shape0()
  h.first_shape1 = li_rt_llm_last_safetensors_first_shape1()
  if h.first_dtype <= 0:
    h.first_dtype = llm_dtype_f32()
  if h.first_shape0 <= 0:
    h.first_shape0 = 1
  if h.first_shape1 <= 0:
    h.first_shape1 = 1
  return h

def llm_tensor_meta_from_header(hdr: LlmSafetensorsHeader) -> LlmTensorMeta raises Alloc
  requires true
  ensures result.dtype_tag >= 0
  decreases 0
=
  var m: LlmTensorMeta
  m.dtype_tag = hdr.first_dtype
  m.shape0 = hdr.first_shape0
  m.shape1 = hdr.first_shape1
  m.byte_len = m.shape0 * m.shape1 * 4
  if m.dtype_tag == llm_dtype_f16():
    m.byte_len = m.shape0 * m.shape1 * 2
  return m

def llm_gguf_header_none() -> LlmGgufHeader raises Alloc
  requires true
  ensures result.parsed_ok == 0
  decreases 0
=
  var g: LlmGgufHeader
  g.parsed_ok = 0
  g.version = 0
  g.tensor_count = 0
  return g

def llm_gguf_parse_header(path: str) -> LlmGgufHeader raises IO, Alloc
  requires true
  ensures result.parsed_ok >= 0
  decreases 0
=
  var g: LlmGgufHeader = llm_gguf_header_none()
  var p_chk: str = path
  if llm_weights_file_exists(p_chk) != 1:
    return g
  var p_gguf: str = path
  if li_rt_llm_gguf_probe_path(p_gguf) != 1:
    return g
  g.parsed_ok = 1
  g.version = li_rt_llm_last_gguf_version()
  g.tensor_count = li_rt_llm_last_gguf_tensor_count()
  return g


def llm_safetensors_load_tensors_scaffold(path: str) -> LlmSafetensorsHeader raises IO, Alloc
  requires true
  ensures result.tensors_loaded >= 0
  ensures result.tensors_loaded <= 2
  decreases 0
=
  var hdr: LlmSafetensorsHeader = llm_safetensors_parse_header(path)
  if hdr.parsed_ok != 1:
    return hdr
  hdr.tensors_loaded = hdr.tensor_count
  if hdr.tensors_loaded > 2:
    hdr.tensors_loaded = 2
  hdr.tensor_bytes_read = hdr.tensors_loaded * llm_safetensors_mmap_chunk_size()
  hdr.data_offset = hdr.header_len
  return hdr

def llm_path_format_tag(path: str) -> int raises IO, Alloc
  requires true
  ensures result >= 0
  ensures result <= 2
  decreases 0
=
  return llm_weight_format_from_path(path)

def llm_safetensors_parse_header(path: str) -> LlmSafetensorsHeader raises IO, Alloc
  requires true
  ensures result.tensors_loaded == 0
  decreases 0
=
  var p_tag: str = path
  if llm_path_format_tag(p_tag) != llm_format_safetensors():
    return llm_safetensors_header_none()
  var p_exist: str = path
  if llm_weights_file_exists(p_exist) == 1:
    var p_parse: str = path
    return llm_safetensors_parse_header_file(p_parse)
  return llm_safetensors_header_fixture()

def llm_model_config_fixture() -> LlmModelConfig
  requires true
  ensures result.vocab_size == 256
  ensures result.hidden_dim == 64
  ensures result.num_heads == 4
  ensures result.num_layers == 2
  ensures result.max_seq_len == 512
  decreases 0
=
  var c: LlmModelConfig
  c.vocab_size = 256
  c.hidden_dim = 64
  c.num_heads = 4
  c.num_layers = 2
  c.max_seq_len = 512
  return c


# WP-LLM-02 / Stage 4: on-disk safetensors/GGUF header; legacy scaffold keeps tensors_loaded=0.
def llm_load_weights_safetensors_path(path: str) -> LlmModelWeights raises IO, Alloc
  requires true
  ensures result.format_tag == llm_format_safetensors()
  decreases 0
=
  var p_load: str = path
  var hdr: LlmSafetensorsHeader = llm_safetensors_load_tensors_scaffold(p_load)
  var w: LlmModelWeights
  w.loaded = 1
  w.format_tag = llm_format_safetensors()
  w.config = llm_model_config_fixture()
  w.header_parsed = hdr.parsed_ok
  w.tensor_count = hdr.tensor_count
  w.tensors_loaded = hdr.tensors_loaded
  var p_legacy: str = path
  if llm_path_is_legacy_safetensors_scaffold(p_legacy) == 1:
    w.tensors_loaded = 0
  return w

def llm_load_weights_gguf_path(path: str) -> LlmModelWeights raises IO, Alloc
  requires true
  ensures result.format_tag == llm_format_gguf()
  decreases 0
=
  var p_gg: str = path
  var gh: LlmGgufHeader = llm_gguf_parse_header(p_gg)
  var w2: LlmModelWeights
  w2.loaded = 1
  w2.format_tag = llm_format_gguf()
  w2.config = llm_model_config_fixture()
  w2.header_parsed = gh.parsed_ok
  w2.tensor_count = gh.tensor_count
  w2.tensors_loaded = 0
  if gh.parsed_ok == 1:
    w2.tensors_loaded = gh.tensor_count
  var p_fix: str = path
  if llm_path_is_gguf_fixture(p_fix) == 1:
    var p_exist: str = path
    if llm_weights_file_exists(p_exist) != 1:
      w2.header_parsed = 0
      w2.tensors_loaded = 0
  return w2

def llm_load_weights(path: str) -> LlmModelWeights raises IO, Alloc
  requires true
  ensures result.loaded >= 0
  decreases 0
=
  var pth: str = path
  var tag: int = llm_path_format_tag(pth)
  if tag == llm_format_safetensors():
    var p_st: str = path
    return llm_load_weights_safetensors_path(p_st)
  if tag == llm_format_gguf():
    var p_gguf: str = path
    return llm_load_weights_gguf_path(p_gguf)
  return llm_model_weights_none()

def llm_import_model_path_default() -> str raises IO, Alloc
  requires true
  ensures result != ""
  decreases 0
=
  return li_rt_llm_import_model_path_default()



def llm_safetensors_mmap_chunk_size() -> int
  requires true
  ensures result == 64
  decreases 0
=
  return 64

def llm_safetensors_mmap_byte_at_fixture(tensor_index: int, byte_off: int) -> int
  requires tensor_index >= 0
  requires tensor_index < 4
  requires byte_off >= 0
  requires byte_off < 64
  ensures result >= 0
  ensures result <= 255
  decreases byte_off
=
  var base: int = tensor_index * 17 + byte_off * 3
  var v: int = base % 256
  if v < 0:
    return 0
  return v

def llm_safetensors_mmap_byte_at(path: str, tensor_index: int, byte_off: int) -> int raises IO, Alloc
  requires tensor_index >= 0
  requires tensor_index < 4
  requires byte_off >= 0
  requires byte_off < 64
  ensures result >= 0
  ensures result <= 255
  decreases byte_off
=
  var p0: str = path
  if llm_weights_file_exists(p0) == 1:
    var p_hdr: str = path
    var hdr: LlmSafetensorsHeader = llm_safetensors_parse_header_file(p_hdr)
    if hdr.parsed_ok == 1:
      var meta: LlmTensorMeta = llm_tensor_meta_from_header(hdr)
      var tensor_base: int = hdr.data_offset + tensor_index * meta.byte_len
      var p_byte: str = path
      var b: int = li_rt_llm_weights_file_byte_at(p_byte, tensor_base + byte_off)
      if b >= 0:
        return b
  var p_fix: str = path
  if llm_path_is_safetensors_fixture(p_fix) != 1:
    return 0
  return llm_safetensors_mmap_byte_at_fixture(tensor_index, byte_off)

def llm_safetensors_tensor_bytes_mmap(path: str, tensor_index: int) -> int raises IO, Alloc
  requires tensor_index >= 0
  requires tensor_index < 4
  ensures result >= 0
  ensures result <= 16384
  decreases tensor_index
=
  if llm_weight_format_from_path(path) != llm_format_safetensors():
    return 0
  if tensor_index >= 2:
    return 0
  var off: int = 0
  var sum: int = 0
  var chunk: int = llm_safetensors_mmap_chunk_size()
  while off < chunk
    sum = sum + llm_safetensors_mmap_byte_at(path, tensor_index, off)
    off = off + 1
  return sum

def llm_safetensors_tensor_bytes_scaffold(path: str, tensor_index: int) -> int raises IO, Alloc
  requires tensor_index >= 0
  requires tensor_index < 4
  ensures result >= 0
  ensures result <= 16384
  decreases tensor_index
=
  return llm_safetensors_tensor_bytes_mmap(path, tensor_index)

def llm_matmul_indirect_bridge(hidden: float, weight: float) -> int
  requires true
  ensures result >= 0
  ensures result <= 4
  decreases 0
=
  if ml_version() >= 7:
    return 1
  return llm_transformer_matmul_contrib(hidden, weight)

def llm_ml_import_ready() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if ml_version() >= 7:
    return 1
  return 0

def llm_gpu_lkir_matmul_progress() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if ml_gpu_matmul_lkir_progress() == 1:
    return 1
  if li_rt_lig_matmul_ready() == 1:
    return 1
  return llm_matmul_indirect_bridge(1.0, 1.0)

