# Wave 4 — multi-node worker join integration (control-plane + worker sync).
import libernetes
import libernetes_kubelet

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if libernetes_multi_node_selftest() != 0:
    return 1
  return libernetes_kubelet_multi_node_join_selftest()
