import sim.scientific
import studio

extern proc li_rt_studio_aimd_scenario_reset() -> int
  requires true
  ensures result >= 0
  decreases 0

extern proc li_rt_studio_aimd_batch_write_json(path: str, steps: int, ok: int, checksum: float, energy_drift: float, gpu_path: int) -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases steps

# W5 — E2E hero pipeline: configure → batch run → final viz (in-process; no UI step replay).
def main() -> int raises IO, Alloc
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_studio_version() < 57:
    return 1
  if li_rt_studio_aimd_scenario_reset() != 0:
    return 2
  var steps: int = studio_aimd_hero_demo_steps()
  if echem_aimd_batch_steps_valid(steps) != 1:
    return 3
  if studio_aimd_hero_configure(steps, 300, 0, studio_aimd_algo_echem_interface()) != 1:
    return 4
  var batch: AimdBatchResult = echem_aimd_batch_run(steps)
  if batch.ok != 1:
    return 5
  if batch.steps != steps:
    return 6
  if batch.checksum_ok != 1:
    return 7
  var expect_gpu: int = echem_aimd_batch_gpu_path_select()
  if batch.gpu_path != expect_gpu:
    return 8
  var trace_checksum: float = batch.checksum
  var trace_drift: float = batch.energy_drift
  if li_rt_studio_aimd_batch_write_json("build/aimd-demo/out/batch-result.json", batch.steps, batch.ok, trace_checksum, trace_drift, batch.gpu_path) != 1:
    return 9
  if studio_aimd_final_viz_ok(batch, "build/aimd-demo/out/final-frame.ppm", 1280, 720) != 1:
    return 10
  return 0
