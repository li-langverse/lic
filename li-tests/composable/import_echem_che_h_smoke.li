import chem

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if echem_she_reference_ev() != 4.44:
    return 1
  if echem_dft_h_star_energy_hartree() >= 0.0:
    return 2
  if echem_dft_h2_energy_hartree() >= 0.0:
    return 3
  var u0: float = echem_che_h_adsorption_energy(0.0)
  if u0 >= 0.0:
    return 4
  var u_pos: float = echem_che_h_adsorption_energy(0.5)
  if u_pos >= u0:
    return 5
  var u_neg: float = echem_che_h_adsorption_energy(-0.5)
  if u_neg <= u0:
    return 6
  var c_uf: float = echem_edl_helmholtz_capacitance_stub()
  if c_uf < 10.0:
    return 7
  if c_uf > 30.0:
    return 8
  if echem_edl_pb_vs_helmholtz_smoke() != 1:
    return 13
  if echem_static_barrier_neb_stub() != 0.73:
    return 9
  if echem_neb_image_count() < 3:
    return 14
  if echem_static_barrier_neb_vs_stub_smoke() != 1:
    return 15
  if echem_potential_volcano_trend_smoke() != 1:
    return 10
  var at_u0: float = echem_dft_energy_at_potential(0.0)
  if at_u0 != u0:
    return 11
  if echem_gpu_che_h_ads_progress() != 1:
    return 12
  return 0
