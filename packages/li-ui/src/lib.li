  requires dest.w >= 0.0
  requires dest.h >= 0.0
  requires face_id == font_face_inter() or face_id == font_face_ui_mono()
  requires glyph_count >= 1
  requires glyph_count <= 32
  requires font_atlas_codepoint_supported(first_codepoint) == 1
  ensures result.kind == paint_op_draw_glyphs()
  ensures result.rect == dest
  ensures result.color == color
  ensures result.face_id == face_id
  ensures result.codepoint == first_codepoint
  ensures result.glyph_count == glyph_count
  decreases glyph_count
=
