
extern proc li_rt_sqrt(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
def li_std_physics_quantum_version() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

# sim-p2-qm-dft-scf (418): H₂ STO-3G class mini SCF scaffold (proved kernel tier T0).
def qm_scf_h2_bond_length_ang() -> float
  requires true
  ensures result == 0.74
  decreases 0
=
  return 0.74

def qm_scf_h2_basis_label() -> int
  requires true
  ensures result == 603
  decreases 0
=
  return 603

def qm_scf_h2_stub_max_iterations() -> int
  requires true
  ensures result == 8
  decreases 0
=
  return 8

def qm_scf_h2_stub_mixing() -> float
  requires true
  ensures result > 0.0
  ensures result < 1.0
  decreases 0
=
  return 0.35

def qm_scf_h2_stub_energy_step(energy: float, mix: float) -> float
  requires mix > 0.0
  requires mix < 1.0
  ensures result <= 0.0
  decreases 0
=
  var target: float = -1.12 + 0.08 * qm_scf_h2_bond_length_ang()
  return energy + mix * (target - energy)

def qm_scf_h2_stub_iteration(max_iter: int) -> float
  requires max_iter >= 1
  requires max_iter <= 32
  ensures result <= 0.0
  decreases max_iter
=
  var energy: float = -0.5
  var mix: float = qm_scf_h2_stub_mixing()
  var tol: float = 1.0e-5
  var iter: int = 0
  while iter < max_iter
    var e_new: float = qm_scf_h2_stub_energy_step(energy, mix)
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

def qm_scf_h2_stub_energy() -> float
  requires true
  ensures result < 0.0
  decreases 0
=
  return qm_scf_h2_stub_iteration(qm_scf_h2_stub_max_iterations())

def qm_scf_h2_stub_converged() -> int
  requires true
  ensures result == 1
  decreases 0
=
  var e0: float = -0.5
  var e1: float = qm_scf_h2_stub_iteration(qm_scf_h2_stub_max_iterations())
  var de: float = e1 - e0
  if de < 0.0:
    de = -de
  if de < 0.5:
    return 1
  return 0

def qm_scf_h2_stub_iterations() -> int
  requires true
  ensures result == qm_scf_h2_stub_max_iterations()
  decreases 0
=
  return qm_scf_h2_stub_max_iterations()

# WP-ECHEM-13: 2-state nonadiabatic population transfer (documented stub).
def quantum_tddft_2state_population_step(p_ground: float, coupling: float, dt: float) -> float
  requires p_ground >= 0.0
  requires p_ground <= 1.0
  requires coupling >= 0.0
  requires dt > 0.0
  ensures result >= 0.0
  ensures result <= 1.0
  decreases 0
=
  var p_excited: float = 1.0 - p_ground
  var hop: float = coupling * dt * p_excited
  if hop > p_ground:
    hop = p_ground
  var next: float = p_ground - hop
  if next < 0.0:
    next = 0.0
  if next > 1.0:
    next = 1.0
  return next

def quantum_tddft_nonadiabatic_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var p: float = 1.0
  var coupling: float = 0.04
  var dt: float = 0.5
  var step: int = 0
  while step < 6
    p = quantum_tddft_2state_population_step(p, coupling, dt)
    step = step + 1
  if p >= 0.95:
    return 0
  if p <= 0.0:
    return 0
  return 1
def norm_sq_1d(psi_re: array[8, float], psi_im: array[8, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var s: float = 0.0
  var i: int = 0
  while i < 8
    s = s + psi_re[i] * psi_re[i] + psi_im[i] * psi_im[i]
    i = i + 1
  return s
def normalize_1d(psi_re: array[8, float], psi_im: array[8, float]) raises IO -> unit
  requires true
  ensures true
  decreases 0
=
  var n2: float = norm_sq_1d(psi_re, psi_im)
  if n2 == 0.0:
    return
  var inv_n: float = 1.0 / li_rt_sqrt(n2)
  var i: int = 0
  while i < 8
    psi_re[i] = psi_re[i] * inv_n
    psi_im[i] = psi_im[i] * inv_n
    i = i + 1
def harmonic_potential_1d(x: float, k: float) -> float
  requires k >= 0.0
  ensures result == 0.5 * k * x * x
  decreases 0
=
  return 0.5 * k * x * x
def schrodinger_kinetic_diag(dx: float, mass: float) -> float
  requires dx > 0.0
  requires mass > 0.0
  ensures result == hbar * hbar / (2.0 * mass * dx * dx)
  decreases 0
=
  var hbar: float = 1.0
  return hbar * hbar / (2.0 * mass * dx * dx)
