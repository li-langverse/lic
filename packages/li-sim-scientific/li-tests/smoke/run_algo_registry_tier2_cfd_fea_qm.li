import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd_oracle: float = sim_scientific_oracle_checksum_cfd()
  if cfd_oracle < 1.0e-12:
    return 32
  var cfd206: SimRunResult = run_algo(206, 1)
  if cfd206.ok != 1:
    return 33
  if cfd206.algo_id != 206:
    return 34
  if cfd206.checksum != cfd_oracle:
    return 35
  if cfd206.checksum == 1.001:
    return 36
  var fea_oracle: float = sim_scientific_oracle_checksum_fea()
  if fea_oracle < 1.0e-12:
    return 38
  var fea214: SimRunResult = run_algo(214, 1)
  if fea214.ok != 1:
    return 39
  if fea214.algo_id != 214:
    return 40
  if fea214.checksum != fea_oracle:
    return 41
  if fea214.checksum == 1.001:
    return 42
  var qm_overlap: float = sim_scientific_oracle_checksum_qm_overlap()
  if qm_overlap < 1.0e-12:
    return 44
  var qm402: SimRunResult = run_algo(402, 0)
  if qm402.ok != 1:
    return 45
  if qm402.algo_id != 402:
    return 46
  if qm402.checksum != qm_overlap:
    return 47
  if qm402.checksum == 1.001:
    return 48
  var qm_dft_oracle: float = sim_scientific_oracle_checksum_qm_dft()
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if qm418.ok != 1:
    return 12
  if qm418.checksum != qm_dft_oracle:
    return 13
  if qm418.checksum == 1.001:
    return 50
  return 0
