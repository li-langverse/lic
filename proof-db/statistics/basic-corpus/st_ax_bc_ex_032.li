# ST-AX-BC-EX-032: Expectation linearity E[aX+bY] = aE[X]+bE[Y] on finite spaces (case 32).
# Expectation linearity: E[aX + bY] = a E[X] + b E[Y] on finite spaces.

def expectation_linear(a: float, b: float, ex: float, ey: float) -> float
  requires true
  ensures result == a * ex + b * ey
  decreases 0
=
  return a * ex + b * ey

def st_ax_bc_ex_032_axiom_witness()-> int
  requires true
  ensures result == 0
  decreases 0

=

  return 0

