import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum == 1.001:
    return 3
  var heat201: SimRunResult = run_algo(algo_pde_heat_explicit_2d(), 2)
  if run_result_ok(heat201) != 1:
    return 4
  if heat201.algo_id != 201:
    return 5
  if heat201.checksum == 1.001:
    return 6
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 7
  if rigid302.checksum == 1.001:
    return 8
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 9
  if qm418.checksum != 30.0:
    return 10
  if qm418.checksum == 1.001:
    return 11
  var qm401: SimRunResult = run_algo(401, 0)
  if run_result_ok(qm401) != 1:
    return 12
  if qm401.checksum != 30.0:
    return 13
  var cfd206: SimRunResult = run_algo(206, 1)
  if run_result_ok(cfd206) != 1:
    return 14
  if cfd206.algo_id != 206:
    return 15
  if cfd206.checksum != 28.0:
    return 16
  var fea214: SimRunResult = run_algo(214, 0)
  if run_result_ok(fea214) != 1:
    return 17
  if fea214.algo_id != 214:
    return 18
  if fea214.checksum != 2.5:
    return 19
  var stub701: SimRunResult = run_algo(701, 0)
  if run_result_ok(stub701) != 1:
    return 20
  if stub701.checksum != 1.001:
    return 21
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 22
  if aimd433.checksum == 1.001:
    return 23
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 24
  if gc434.checksum == 1.001:
    return 25
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 26
  if sei435.checksum == 1.001:
    return 27
  return 0
