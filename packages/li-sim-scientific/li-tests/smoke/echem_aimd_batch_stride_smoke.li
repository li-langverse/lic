import sim.scientific

extern proc li_rt_studio_aimd_scenario_set_dft_stride(dft_stride: int) -> int
  requires true
  ensures result == 1
  decreases dft_stride

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_rt_studio_aimd_scenario_set_dft_stride(1) != 1:
    return 1
  if echem_aimd_batch_dft_stride() != 1:
    return 2
  var batch: AimdBatchResult = echem_aimd_batch_run(128)
  if batch.ok != 1:
    return 3
  if batch.dft_stride != 1:
    return 4
  if batch.dft_calls != 128:
    return 5
  return 0
