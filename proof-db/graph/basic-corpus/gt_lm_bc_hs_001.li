# GT-LM-BC-HS-001: Handshaking lemma: sum_{v in V} deg(v) = 2|E| in any finite graph.

def handshaking_sum(deg_sum: int, edge_count: int) -> int
  requires edge_count >= 0
  ensures result == 2 * edge_count
  decreases 0
=
  return deg_sum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
