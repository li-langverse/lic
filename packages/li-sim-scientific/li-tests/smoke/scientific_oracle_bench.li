import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var md: float = sim_scientific_oracle_checksum_md()
  if md < 0.0:
    md = -md
  if md >= 1.0e-3:
    return 3
  var heat: float = sim_scientific_oracle_checksum_heat()
  if heat < 0.0:
    heat = -heat
  if heat >= 10.0:
    return 5
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  if cfd < 0.0:
    cfd = -cfd
  if cfd >= 10.0:
    return 7
  var fea: float = sim_scientific_oracle_checksum_fea()
  if fea < 0.0:
    fea = -fea
  if fea >= 1.0:
    return 9
  var qm: float = sim_scientific_oracle_checksum_qm()
  if qm < 0.0:
    qm = -qm
  if qm >= 1.0:
    return 11
  var tol: float = 1.0e-9
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if run_result_ok(md_run) != 1:
    return 12
  if sim_scientific_checksum_rel_diff(md_run.checksum, md) > tol:
    return 13
  var heat_run: SimRunResult = run_heat_smoke(0)
  if run_result_ok(heat_run) != 1:
    return 14
  if sim_scientific_checksum_rel_diff(heat_run.checksum, heat) > tol:
    return 15
  return 0
