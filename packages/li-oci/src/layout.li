# WP-CTN-011 — OCI image layout (blobs/, index.json, oci-layout).

import spec

def oci_layout_version() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def oci_layout_blob_dir_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def oci_layout_index_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def oci_layout_file_tag() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

def oci_layout_digest_hex_len() -> int
  requires true
  ensures result == 64
  decreases 0
=
  return 64

def oci_layout_blob_path_prefix_len() -> int
  requires true
  ensures result == 6
  decreases 0
=
  return 6

def oci_layout_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if oci_spec_version() != 1:
    return 1
  if oci_layout_version() != 1:
    return 2
  if oci_layout_blob_dir_tag() != 1:
    return 3
  if oci_layout_index_tag() != 2:
    return 4
  if oci_layout_file_tag() != 3:
    return 5
  if oci_layout_digest_hex_len() != 64:
    return 6
  if oci_layout_blob_path_prefix_len() != 6:
    return 7
  return 0
