import ml

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if ml_echem_surrogate_in_dim() != 3:
    return 1
  if ml_echem_surrogate_hidden() != 4:
    return 2
  if ml_echem_surrogate_out_dim() != 1:
    return 3
  if ml_echem_surrogate_mlp_smoke() != 1:
    return 4
  var e: float = ml_echem_surrogate_predict_ev(0.0, 0.08, 0.03)
  if e < 6.5:
    return 5
  if e > 8.0:
    return 6
  return 0
