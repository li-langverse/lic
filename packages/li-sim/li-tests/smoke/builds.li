import sim

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_version() != 1:
    return 1
  if algo_registry_count() < 1:
    return 2
  var sess: SimSessionStub = sim_session_stub_default()
  if sim_reset(sess) != sim_status_ok():
    return 3
  if sess.tick != 0:
    return 4
  if sim_step(sess, 0.016) != sim_status_ok():
    return 5
  if sess.tick != 1:
    return 6
  return 0
