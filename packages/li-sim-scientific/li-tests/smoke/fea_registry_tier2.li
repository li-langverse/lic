import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fea_chk: float = sim_scientific_oracle_checksum_fea()
  if fea_chk < 2.0:
    return 1
  var fea214: SimRunResult = run_algo(214, 0)
  if fea214.ok != 1:
    return 2
  if fea214.algo_id != 214:
    return 3
  if fea214.checksum != fea_chk:
    return 4
  if fea214.checksum == 1.001:
    return 5
  return 0
