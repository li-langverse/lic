import llm

def main() -> int raises IO, Alloc
  requires true
  ensures result == 0
  decreases 0
=
  var path: str = llm_import_model_path_default()
  var w: LlmModelWeights = llm_load_weights(path)
  if llm_model_weights_valid(w) != 1:
    return 1
  if w.tensors_loaded != 2:
    return 2
  if w.header_parsed != 1:
    return 3
  var tok: LlmTokenIds = llm_tokenize("ab", "fixtures/vocab.json")
  var cache: LlmKVCache
  cache.seq_len = 0
  var logits: LlmLogits = llm_forward(tok, w, cache)
  if logits.top_id < 0:
    return 4
  return 0
