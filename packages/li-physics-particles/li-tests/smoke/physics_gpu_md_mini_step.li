# PH-SCI-GPU-03: @gpu MD position integration loop (particles vertical).
import physics.particles

@gpu
def physics_gpu_md_mini_step_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var px: array[16, float]
  var py: array[16, float]
  var pz: array[16, float]
  var vx: array[16, float]
  var vy: array[16, float]
  var vz: array[16, float]
  var i: int = 0
  while i < 16
    px[i] = 0.0
    py[i] = 0.0
    pz[i] = 0.0
    vx[i] = 0.1
    vy[i] = 0.0
    vz[i] = 0.0
    i = i + 1
  var k: int = 0
  while k < 64
    md_mini_step(px, py, pz, vx, vy, vz, 0.01)
    k = k + 1
  if px[0] <= 0.0:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if physics_gpu_md_mini_step_smoke() != 1:
    return 1
  return 0
