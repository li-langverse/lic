import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd521: SimRunResult = run_algo(521, 0)
  if run_result_ok(cfd521) != 1:
    return 1
  if cfd521.algo_id != 521:
    return 2
  if cfd521.vertical_id != vertical_cfd_lid_driven_cavity():
    return 3
  if cfd521.checksum == 1.001:
    return 4
  var cfd_oracle: float = sim_scientific_oracle_checksum_cfd()
  if cfd_oracle <= 0.0:
    return 5
  if cfd521.checksum != cfd_oracle:
    return 6
  return 0
