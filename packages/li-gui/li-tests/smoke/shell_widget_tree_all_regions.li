import gui

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_gui_version() < 13:
    return 1
  if gui_shell_widget_tree_version() != 1:
    return 2
  if shell_widget_tree_region_count() != 8:
    return 3
  var agent: StoreInt = store_int_new(reactive_store_id_agent_task(), studio_agent_task_running())
  var palette: StoreInt = store_int_new(reactive_store_id_palette_open(), studio_palette_open_flag())
  var mode: StoreInt = store_int_new(reactive_store_id_shell_mode(), studio_mode_author())
  var tick: StoreFloat = store_float_new(reactive_store_id_timeline_tick(), 0.25)
  var params: ShellWidgetTreeParams = shell_widget_tree_params_from_stores(agent, palette, mode, tick, 0, 1, 1)
  if params.agent_task_state != studio_agent_task_running():
    return 4
  var lay: StudioShellLayout = layout_studio_shell_adaptive(1280.0, 720.0)
  var tree: ShellWidgetTree = shell_widget_tree_new(params, lay.inspector.w, lay.inspector.h)
  if tree.region_count != 8:
    return 5
  var tl: ShellWidgetTreeLayout = shell_widget_tree_layout(tree, lay)
  if shell_widget_tree_all_regions_laid_out(tl) != 1:
    return 6
  if shell_widget_tree_region_laid_out(tl, shell_widget_tree_region_inspector()) != 1:
    return 7
  var frame: PaintFrame = paint_frame_new()
  shell_widget_tree_paint(tree, tl, frame)
  if frame.cmd_count < shell_widget_tree_paint_region_cmds(1):
    return 8
  return 0
