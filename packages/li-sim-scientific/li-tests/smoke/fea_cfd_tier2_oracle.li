import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var heat: float = sim_scientific_oracle_checksum_heat()
  if heat <= 1.0:
    return 99
  var fea: float = sim_scientific_oracle_checksum_fea()
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  var fea215: SimRunResult = run_algo(algo_fea_linear_elasticity(), 0)
  if run_result_ok(fea215) != 1:
    return 5
  if fea215.checksum != fea:
    return 6
  if fea215.checksum == 1.001:
    return 7
  var cfd206: SimRunResult = run_algo(algo_cfd_simple(), 0)
  if run_result_ok(cfd206) != 1:
    return 8
  if cfd206.checksum != cfd:
    return 9
  if cfd206.checksum == 1.001:
    return 10
  return 0
