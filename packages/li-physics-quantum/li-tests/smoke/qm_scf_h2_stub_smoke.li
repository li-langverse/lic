import physics.quantum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if qm_scf_h2_bond_length_ang() != 0.74:
    return 1
  if qm_scf_h2_stub_converged() != 1:
    return 2
  if qm_scf_h2_stub_scf_iterations() != qm_scf_h2_stub_max_iterations():
    return 3
  var e: float = qm_scf_h2_stub_energy()
  if e >= 0.0:
    return 4
  if e < -2.0:
    return 5
  return 0
