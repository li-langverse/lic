import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fea_expected: float = sim_scientific_oracle_checksum_fea()
  var fea0: SimRunResult = run_algo(algo_fea_linear_elasticity(), 0)
  var fea_chk: float = fea0.checksum
  if fea_chk != fea_expected:
    return 5
  if run_result_ok(fea0) != 1:
    return 1
  if fea0.algo_id != algo_fea_linear_elasticity():
    return 2
  if fea0.vertical_id != vertical_fea_linear_elasticity():
    return 3
  if fea_chk == 1.001:
    return 4
  return 0
