# WP-CTN-024 — Linux container backend (namespaces + cgroups tags).

def container_linux_backend_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_linux_namespaces_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_linux_cgroups_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def container_linux_seccomp_tag() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

def container_linux_backend_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_linux_backend_tag() != 1:
    return 1
  if container_linux_namespaces_tag() != 1:
    return 2
  if container_linux_cgroups_tag() != 2:
    return 3
  if container_linux_seccomp_tag() != 3:
    return 4
  return 0
