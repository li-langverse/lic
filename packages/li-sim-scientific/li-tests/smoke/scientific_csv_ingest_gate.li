import sim.scientific

# PH-IO-4 + PH-SCI — ingest bundle witness then MD tier-2 registry (std.io/csv in ph_io4 + check-ph-io-4-gate).

def scientific_csv_ingest_gate() -> int
  requires true
  ensures result == 10
  decreases 0
=
  return sim_scientific_csv_ingest_bundle_tag()

def main() raises Alloc -> int
  requires true
  ensures result == 0
  decreases 0
=
  if scientific_csv_ingest_gate() != 10:
    return 1
  var md: float = sim_scientific_oracle_checksum_md()
  if md <= 0.0:
    return 2
  var bundle: int = sim_scientific_csv_ingest_bundle_tag()
  if bundle != 10:
    return 3
  var md_reg: SimRunResult = sim_scientific_ingest_then_md_registry(bundle, 1)
  if run_result_ok(md_reg) != 1:
    return 4
  if md_reg.algo_id != 105:
    return 5
  if md_reg.checksum != md:
    return 6
  if md_reg.checksum == 1.001:
    return 7
  return 0
