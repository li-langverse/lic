# PH-7e: Horner trip edge — 64 steps (pow4 / fma-unroll path, below ConstLoop threshold).

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var x: float = 1.1
  var acc: float = 0.0
  var i: int = 0
  while i < 64
    acc = acc * x + 1.0
    i = i + 1
  li_rt_volatile_sink_f64(acc)
  return 0
