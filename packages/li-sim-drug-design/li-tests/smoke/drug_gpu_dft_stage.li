# PH-SCI-GPU-17: @gpu drug LitL DFT stage — kernel energy + workflow checksum.
import sim.drug_design

@gpu
def drug_gpu_dft_stage_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var dft: DrugLitlStagePayload = drug_litl_stage_payload(drug_litl_stage_dft())
  if dft.dft_energy_hartree >= 0.0:
    return 0
  if dft.conformer_count != 8:
    return 0
  if run_drug_design_litl_workflow(0) != 0:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if drug_gpu_dft_stage_smoke() != 1:
    return 1
  return 0
