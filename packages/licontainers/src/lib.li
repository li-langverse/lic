# WP-CTN-063 — deprecated shim; delegates to split container packages.

import container.backend.linux
import container.run
import cri
import oci
import cri.serve
import runtime.cri_socket
import runtime.remote

def licontainers_version() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def licontainers_cri_lifecycle_selftest() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  if oci_spec_version() != 1:
    return 1
  if cri_v1_api_version() != 1:
    return 2
  if oci_image_pull_tag() != 1:
    return 3
  if lirun_create_tag() != 2:
    return 4
  if lirun_start_tag() != 3:
    return 5
  if container_linux_namespaces_tag() != 1:
    return 6
  if container_linux_cgroups_tag() != 2:
    return 7
  return 0

def licontainers_cri_socket_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if cri_serve_stub() != 0:
    return 1
  if runtime_cri_socket_tag() != 4:
    return 2
  return 0

def licontainers_remote_cri_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if runtime_remote_cri_forward_stub() != 0:
    return 1
  if runtime_remote_cri_tag() != 5:
    return 2
  if runtime_cri_socket_tag() >= runtime_remote_cri_tag():
    return 3
  return 0
