# hkdf — RFC5869 case 1 golden (M1).

def crypto_hkdf_golden_byte(i: int) -> int
  requires 0 <= i and i < 42
  ensures 0 <= result and result <= 255
  decreases 0
=
  if i == 0:
    return 171
  if i == 1:
    return 186
  if i == 2:
    return 251
  if i == 3:
    return 19
