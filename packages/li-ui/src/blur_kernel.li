# Separable box-blur kernel — normalized weights for shadow-layer diffusion (wtfx-w4).
# One-dimensional taps: w(i) = 1 / (2*radius + 1) for i in [-radius, radius].

def blur_kernel_int_as_float(v: int) -> float
  requires v >= 0
  ensures result >= 0.0
  decreases v
=
  var acc: float = 0.0
  var i: int = 0
  while i < v:
    acc = acc + 1.0
    i = i + 1
  return acc

def blur_kernel_radius_from_sigma(sigma_px: float) -> int
  requires sigma_px >= 0.0
  ensures result >= 0
  decreases 0
=
  var r: int = 0
  if sigma_px >= 3.0:
    r = 3
  if r == 0 and sigma_px >= 2.0:
    r = 2
  if r == 0 and sigma_px >= 1.0:
    r = 1
  return r

def blur_kernel_tap_count(radius: int) -> int
  requires radius >= 0
  requires radius <= 8
  ensures result == radius * 2 + 1
  ensures result >= 1
  decreases radius
=
  return radius * 2 + 1

def blur_kernel_weight_at(radius: int, tap_index: int) -> float
  requires radius >= 0
  requires radius <= 8
  requires tap_index >= 0
  requires tap_index < blur_kernel_tap_count(radius)
  ensures result > 0.0
  ensures result <= 1.0
  decreases radius
=
  var taps: int = blur_kernel_tap_count(radius)
  return 1.0 / blur_kernel_int_as_float(taps)

def blur_kernel_weight_sum(radius: int) -> float
  requires radius >= 0
  requires radius <= 8
  ensures result >= 0.999
  ensures result <= 1.001
  decreases radius
=
  var sum: float = 0.0
  var i: int = 0
  var taps: int = blur_kernel_tap_count(radius)
  while i < taps:
    sum = sum + blur_kernel_weight_at(radius, i)
    i = i + 1
  return sum

def blur_separable_passes_for_radius(radius_px: float, token_passes: int) -> int
  requires radius_px >= 0.0
  requires token_passes >= 1
  requires token_passes <= 4
  ensures result >= 1
  ensures result <= 4
  decreases token_passes
=
  if token_passes < 1:
    return 1
  return token_passes

def blur_effective_sigma_px(sigma_px: float, radius_px: float) -> float
  requires sigma_px >= 0.0
  requires radius_px >= 0.0
  ensures result >= 0.0
  decreases 0
=
  if sigma_px > radius_px:
    return radius_px
  return sigma_px
