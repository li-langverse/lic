FROM ghcr.io/li-langverse/lic-ci:ubuntu24-llvm22 AS build
WORKDIR /src
COPY . .
RUN ./scripts/build-li-httpd.sh

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 socat curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/li-httpd /usr/local/bin/li-httpd
COPY scripts/validate-httpd-config.py scripts/flatten-httpd-config.py scripts/setup-tls-httpd.py \
  scripts/httpd_config.py scripts/httpd_toml_style.py scripts/httpd_tls.py scripts/httpd_m2.py \
  scripts/httpd_m3.py scripts/httpd_m15.py scripts/httpd_leak_censor.py /opt/lic-scripts/
COPY test/proxy-repro/proxy/httpd-lb.toml /proxy/httpd-lb.toml
COPY test/proxy-repro/entrypoint-proxy-lb.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
