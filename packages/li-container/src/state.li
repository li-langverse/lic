# WP-CTN-021 — container state persistence (seam FFI).

import seam

def container_state_status_created_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_state_status_running_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def container_state_status_stopped_tag() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

def container_state_oci_version_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_state_write(id: var ptr, oci_version: var ptr, status: var ptr, pid: int, has_pid: int, bundle: var ptr, exit_code: int, has_exit: int) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  return container_state_write_i(id, oci_version, status, pid, has_pid, bundle, exit_code, has_exit)

def container_state_read(id: var ptr, json_out: var ptr, cap: int) raises IO -> int
  requires 0 < cap
  ensures result >= -1
  decreases 0
=
  return container_state_read_i(id, json_out, cap)

def container_state_delete(id: var ptr) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  return container_state_delete_i(id)

def container_state_pid_from_json(state_json: var ptr) raises IO -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return container_state_pid_value_i(state_json)

def container_state_validate_tags() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_state_status_created_tag() != 1:
    return 1
  if container_state_status_running_tag() != 2:
    return 2
  if container_state_status_stopped_tag() != 3:
    return 3
  if container_state_oci_version_tag() != 1:
    return 4
  return 0

def container_state_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return container_state_validate_tags()

def state_exists(container_id: var ptr) raises IO, Alloc -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var path: ptr = container_buf_alloc_i(4096)
  container_state_path_i(container_id, path, 4096)
  var ok: int = container_file_exists_i(path)
  container_buf_free_i(path)
  return ok

def state_load(container_id: var ptr, buf: var ptr, cap: int) raises IO, Alloc -> int
  requires 0 < cap
  ensures result >= 0
  decreases 0
=
  if state_exists(container_id) != 1:
    return 1
  if container_state_read_i(container_id, buf, cap) < 0:
    return 2
  return 0

def state_save_created(container_id: var ptr, oci_version: var ptr, bundle_path: var ptr) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var status: ptr = "created"
  return container_state_write_i(container_id, oci_version, status, 0, 0, bundle_path, 0, 0)

def state_save_running(container_id: var ptr, oci_version: var ptr, bundle_path: var ptr, pid: int) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var status: ptr = "running"
  return container_state_write_i(container_id, oci_version, status, pid, 1, bundle_path, 0, 0)

def state_save_stopped(container_id: var ptr, oci_version: var ptr, bundle_path: var ptr, pid: int) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var status: ptr = "stopped"
  return container_state_write_i(container_id, oci_version, status, pid, 1, bundle_path, 0, 0)

def state_delete(container_id: var ptr) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  return container_state_delete_i(container_id)

def state_status(state_json: var ptr, out: var ptr, cap: int) raises IO -> int
  requires 0 < cap
  ensures result >= -1
  decreases 0
=
  return container_json_status_i(state_json, out, cap)
