# LiOS native hypervisor probe (Wave 3).
# Production path: LiOS kernel → libernetes.io/os=lios (KVM remains dev-only).

def lios_probe_label_key() -> str
  requires true
  ensures result == "libernetes.io/os"
  decreases 0
=
  return "libernetes.io/os"

def lios_probe_label_value() -> str
  requires true
  ensures result == "lios"
  decreases 0
=
  return "lios"

def lios_probe_backend_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def lios_probe_signal() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def lios_probe_smoke() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if lios_probe_label_key() != "libernetes.io/os":
    return 1
  if lios_probe_label_value() != "lios":
    return 1
  if lios_probe_backend_tag() != 2:
    return 1
  return 0
