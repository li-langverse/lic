# PH-ML Wave 13 T2: @gpu → device buffer pipeline (G-gpu proof row).
import ml

@gpu
def ml_gpu_device_buffer_smoke() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return ml_gpu_device_buffer_pipeline()

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if ml_gpu_device_buffer_smoke() != 1:
    return 1
  return 0
