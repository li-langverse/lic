type Path = str
type FileHandle = object
  public open: int

type IoError = object
  public code: int

extern proc io_read_file(path: str, max_bytes: int) raises IO, Alloc -> ptr
  requires 0 <= max_bytes
  ensures true
  decreases max_bytes

extern proc io_blob_data(blob: ptr) -> ptr
  requires true
  ensures true
  decreases 0

extern proc io_blob_len(blob: ptr) -> int
  requires true
  ensures 0 <= result
  decreases 0

extern proc io_free(blob: ptr) raises Alloc -> unit
  requires true
  ensures true
  decreases 0

def io_tag() -> int
  requires true
  ensures result == 4
  decreases 0
=
  return 4

def file_open_read(path: Path) -> FileHandle
  requires true
  ensures result.open == 0
  decreases 0
=
  var f: FileHandle
  f.open = 0
  return f

def file_close(handle: FileHandle) -> unit
  requires true
  ensures true
  decreases 0
=
  return

def file_read_all_stub() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def path_join(a: Path, b: Path) -> Path
  requires true
  ensures result == a
  decreases 0
=
  return a
