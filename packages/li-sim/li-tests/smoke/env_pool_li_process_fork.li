import sim

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if sim_rl_env_li_process_fork_ready() != 1:
    return 1
  var sess: SimSessionStub = sim_session_stub_default()
  sim_session_apply_studio_profile(2, sess)
  if sim_rl_session_env_pool_step_li_fork(sess, 0.02) != sim_status_ok():
    return 2
  var psz: int = sim_rl_env_pool_size_default()
  if sess.env_pool_steps_emitted != psz:
    return 3
  if sess.tick != psz:
    return 4
  return 0
