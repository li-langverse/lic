import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd_oracle: float = cfd_lid_draught_witness()
  if cfd_oracle != 2.0:
    return 7
  if cfd_oracle <= 0.0:
    return 1
  var cfd521: SimRunResult = run_algo(algo_cfd_lid_driven_cavity(), 1)
  if run_result_ok(cfd521) != 1:
    return 2
  if cfd521.algo_id != 521:
    return 3
  if cfd521.checksum != cfd_oracle:
    return 4
  if cfd521.checksum == 1.001:
    return 5
  return 0
