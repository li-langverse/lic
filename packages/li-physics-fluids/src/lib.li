
extern def li_rt_sqrt(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0

type FluidCell = object
  public rho: float
  public vx: float
  public vy: float

type Idx4 = {i: int | 0 <= i and i < 4}

def li_std_physics_fluids_version() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def sph_kernel_poly6(r: float, h: float) -> float
  requires h > 0.0
  requires r >= 0.0
  ensures result >= 0.0
  decreases 0
=
  if r >= h:
    return 0.0
  var x: float = (h * h - r * r) / (h * h * h)
  return 315.0 / (64.0 * 3.14159265) * x * x * x

def euler_advect_scalar(field: var array[8, float], vx: var array[8, float], dt: float, dx: float) -> unit
  requires dt > 0.0
  requires dx > 0.0
  ensures true
  decreases 0
=
  var i: int = 0
  while i < 8
    field[i] = field[i] - vx[i] * dt / dx
    i = i + 1

def heat_step_explicit(
    u: var array[8, float], lap: var array[8, float], alpha: float, dt: float) -> unit
  requires dt > 0.0
  ensures true
  decreases 0
=
  var i: int = 0
  while i < 8
    u[i] = u[i] + alpha * dt * lap[i]
    i = i + 1

# lic#108 — matrix-free Laplacian apply for 1D implicit heat (8-cell scaffold).
def heat_implicit_matvec_1d(u: var array[8, float], out: var array[8, float], r: float) -> unit
  requires r > 0.0
  ensures true
  decreases 0
=
  out[0] = u[0]
  out[7] = u[7]
  var i: int = 1
  while i < 7
    out[i] = u[i] + r * (u[i - 1] + u[i + 1] - 2.0 * u[i])
    i = i + 1

# lic#108 — assembled Jacobi sweep for (I - r*L) x = b on 8-cell 1D grid.
def jacobi_heat_implicit_assembled_step(
    u: var array[8, float], b: var array[8, float], x: var array[8, float], r: float) -> unit
  requires r > 0.0
  ensures true
  decreases 0
=
  x[0] = b[0]
  x[7] = b[7]
  var denom: float = 1.0 + 2.0 * r
  var i: int = 1
  while i < 7
    x[i] = (b[i] + r * (u[i - 1] + u[i + 1])) / denom
    i = i + 1
  i = 0
  while i < 8
    u[i] = x[i]
    i = i + 1

def pde_implicit_jacobi_init_field(u: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  u[0] = 0.0
  u[1] = 0.24740395925499513
  u[2] = 0.479425538604203
  u[3] = 0.6816387600826449
  u[4] = 0.8414709848078965
  u[5] = 0.9489843753576942
  u[6] = 0.9974949866040994
  u[7] = 0.9974949866040994

# lic#108 — tier-2 catalog row pde_heat_implicit_jacobi (algo_id 204) Li oracle.
def pde_implicit_jacobi_oracle_checksum() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  var u: array[8, float]
  var b: array[8, float]
  var x: array[8, float]
  var alpha: float = 0.25
  var dx: float = 0.125
  var dt: float = 0.0001
  var r: float = alpha * dt / (dx * dx)
  pde_implicit_jacobi_init_field(u)
  var step: int = 0
  while step < 200
    var i: int = 0
    while i < 8
      b[i] = u[i]
      i = i + 1
    var j: int = 0
    while j < 4
      jacobi_heat_implicit_assembled_step(u, b, x, r)
      j = j + 1
    step = step + 1
  return u[0] + u[1] + u[2] + u[3] + u[4] + u[5] + u[6] + u[7]

def cloth_pbd_distance(
    px: var array[4, float], py: var array[4, float],
    i: Idx4, j: Idx4, rest: float, stiffness: float) -> unit
  requires rest > 0.0
  requires stiffness >= 0.0
  requires stiffness <= 1.0
  ensures true
  decreases 0
=
  var dx: float = px[j] - px[i]
  var dy: float = py[j] - py[i]
  var len: float = li_rt_sqrt(dx * dx + dy * dy)
  if len == 0.0:
    return
  var corr: float = stiffness * (len - rest) / len
  px[i] = px[i] + 0.5 * corr * dx
  py[i] = py[i] + 0.5 * corr * dy
  px[j] = px[j] - 0.5 * corr * dx
  py[j] = py[j] - 0.5 * corr * dy

# WP-SCI-06 — lid-driven cavity tier-2 oracle (scalar Jacobi sweep; no dyn array index for @gpu).
def cfd_lid_cavity_checksum() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  var ux0: float = 0.0
  var ux1: float = 0.0
  var ux2: float = 0.0
  var ux3: float = 0.0
  var ux4: float = 1.0
  var ux5: float = 1.0
  var ux6: float = 1.0
  var ux7: float = 1.0
  var step: int = 0
  while step < 16
    var n1: float = 0.25 * (ux0 + ux2 + 0.5)
    var n2: float = 0.25 * (ux1 + ux3 + 0.5)
    var n3: float = 0.25 * (ux2 + ux4 + 0.5)
    var n4: float = 0.25 * (ux3 + ux5 + 0.5)
    var n5: float = 0.25 * (ux4 + ux6 + 0.5)
    var n6: float = 0.25 * (ux5 + ux7 + 0.5)
    ux1 = n1
    ux2 = n2
    ux3 = n3
    ux4 = n4
    ux5 = n5
    ux6 = n6
    step = step + 1
  return ux0 + ux1 + ux2 + ux3 + ux4 + ux5 + ux6 + ux7

def physics_fluids_gpu_progress() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var u: array[8, float]
  var lap: array[8, float]
  heat_step_explicit(u, lap, 0.1, 0.01)
  return 1

# WP-SCI-06 — mini lid-driven cavity: 8-cell u-velocity strip + diffusion (honest tier-2 stub).
def cfd_lid_cavity_step(u: var array[8, float], lid_v: float, nu: float, dt: float) -> unit
  requires lid_v >= 0.0
  requires nu >= 0.0
  requires dt > 0.0
  ensures true
  decreases 0
=
  u[0] = lid_v
  u[1] = u[1] + nu * dt * (u[2] + lid_v - 2.0 * u[1])
  u[2] = u[2] + nu * dt * (u[3] + u[1] - 2.0 * u[2])
  u[3] = u[3] + nu * dt * (u[4] + u[2] - 2.0 * u[3])
  u[4] = u[4] + nu * dt * (u[5] + u[3] - 2.0 * u[4])
  u[5] = u[5] + nu * dt * (u[6] + u[4] - 2.0 * u[5])
  u[6] = u[6] + nu * dt * (u[7] + u[5] - 2.0 * u[6])
  u[7] = u[7]

def cfd_lid_cavity_checksum() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  var u: array[8, float]
  var i: int = 0
  while i < 8
    u[i] = 0.0
    i = i + 1
  var step: int = 0
  while step < 16
    cfd_lid_cavity_step(u, 1.0, 0.05, 0.01)
    step = step + 1
  var sum: float = 0.0
  i = 0
  while i < 8
    sum = sum + u[i]
    i = i + 1
  if sum < 0.0:
    sum = -sum
  if sum < 1.0e-12:
    sum = 1.0e-12
  return sum
