# PH-SCI-GPU-12: @gpu sensor bus raycast session step.
import sim
import sim.sensors

@gpu
def sensors_gpu_bus_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var sess: SimSessionStub = sim_session_stub_default()
  sim_session_apply_studio_profile(4, sess)
  if sim_sensor_session_bus_step(sess, 0.01) != sim_status_ok():
    return 0
  if sess.sensor_rays_emitted != sensor_bus_size_default():
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if sensors_gpu_bus_smoke() != 1:
    return 1
  return 0
