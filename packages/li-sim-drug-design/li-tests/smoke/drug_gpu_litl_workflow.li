# PH-SCI-GPU-15: @gpu Lab-in-the-Loop workflow checksum path.
import sim.drug_design

@gpu
def drug_gpu_litl_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if run_drug_design_litl_workflow(0) != 0:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if drug_gpu_litl_smoke() != 1:
    return 1
  return 0
