import sim
import sim.scientific

def smoke_qm_dft_scf() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var chk: float = sim_scientific_oracle_checksum_qm_dft_scf()
  if chk >= 0.0:
    return 1
  if chk == 1.001:
    return 1
  var r: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(r) != 1:
    return 1
  if r.checksum != chk:
    return 1
  if r.checksum == 1.001:
    return 1
  return 0
