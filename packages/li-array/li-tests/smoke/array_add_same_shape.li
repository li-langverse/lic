import array

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[64, float]
  var b: array[64, float]
  var c: array[64, float]
  a[0] = 1.0
  a[1] = 2.0
  a[2] = 3.0
  a[3] = 4.0
  b[0] = 0.5
  b[1] = 1.5
  b[2] = 2.5
  b[3] = 3.5
  var desc: ArrayDesc = array_desc_1d(4, array_storage_flat())
  if array_add(desc, a, desc, b, c) != 1:
    return 1
  if c[0] < 1.4 or c[0] > 1.6:
    return 2
  if c[1] < 3.4 or c[1] > 3.6:
    return 3
  if c[3] < 7.4 or c[3] > 7.6:
    return 4
  return 0
