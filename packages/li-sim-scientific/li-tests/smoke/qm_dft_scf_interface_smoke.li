# sim-p2-qm-dft-scf (lic#478): algo_id=418 qm_dft_scf_energy — H₂ SCF oracle + summary metrics.
import sim
import sim.scientific
import physics.quantum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  if qm_scf_h2_bond_length_ang() != 0.74:
    return 2
  if qm_scf_h2_stub_smoke() != 1:
    return 3
  var oracle: float = sim_scientific_oracle_checksum_qm_dft_scf()
  if oracle >= 0.0:
    return 4
  if oracle == 1.001:
    return 5
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 1)
  if run_result_ok(qm418) != 1:
    return 6
  if qm418.algo_id != algo_qm_dft_scf_energy():
    return 7
  if qm418.vertical_id != vertical_qm_dft():
    return 8
  if qm418.checksum != oracle:
    return 9
  if qm418.checksum == 1.001:
    return 10
  if qm_dft_scf_stub_iterations() < 1:
    return 11
  var vert: SimRunResult = run_simulation(vertical_qm_dft(), 0)
  if run_result_ok(vert) != 1:
    return 12
  if vert.checksum != oracle:
    return 13
  return 0
