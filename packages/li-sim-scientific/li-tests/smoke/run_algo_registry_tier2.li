  requires true
  ensures result >= 0
  decreases 0
=
  if sim_scientific_oracle_checksum_echem_gc_aimd() <= 0.0:
    return 20
  if sim_scientific_oracle_checksum_echem_gc_aimd() >= 0.05:
    return 21
  var r: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_echem_gc_aimd():
    return 24
  if chk == 1.001:
    return 25
  if r.algo_id != 434:
    return 23
  if r.ok != 1:
