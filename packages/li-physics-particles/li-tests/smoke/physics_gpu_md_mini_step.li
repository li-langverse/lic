# PH-SCI-GPU-03: @gpu MD mini-step with LJ force accumulation (particles vertical).
import physics.particles

@gpu
def physics_gpu_md_mini_step_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return physics_particles_gpu_progress()

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if physics_gpu_md_mini_step_smoke() != 1:
    return 1
  return 0
