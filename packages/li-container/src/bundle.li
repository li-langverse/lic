# WP-CTN-020 — OCI bundle path helpers (seam FFI; no syscall code here).

import seam

def container_bundle_config_name_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_bundle_rootfs_name_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def container_bundle_read_config(bundle_path: var ptr, buf: var ptr, cap: int) raises IO -> int
  requires 0 < cap
  ensures result >= -1
  decreases 0
=
  return container_bundle_read_config_i(bundle_path, buf, cap)

def container_bundle_rootfs_exists(bundle_path: var ptr, config_json: var ptr) raises IO -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return container_bundle_rootfs_exists_i(bundle_path, config_json)

def container_bundle_validate_tags() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_bundle_config_name_tag() != 1:
    return 1
  if container_bundle_rootfs_name_tag() != 2:
    return 2
  return 0

def container_bundle_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return container_bundle_validate_tags()

def bundle_config_cap() -> int
  requires true
  ensures result == 65536
  decreases 0
=
  return 65536

def bundle_read_config(bundle_path: var ptr, buf: var ptr, cap: int) raises IO -> int
  requires 0 < cap
  ensures result >= 0
  decreases 0
=
  var n: int = container_bundle_read_config_i(bundle_path, buf, cap)
  if n < 0:
    return 1
  return 0

def bundle_validate_rootfs(bundle_path: var ptr, config_json: var ptr) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if container_bundle_rootfs_exists_i(bundle_path, config_json) != 1:
    return 1
  return 0

def bundle_oci_version(config_json: var ptr, out: var ptr, cap: int) -> int
  requires 0 < cap
  ensures result >= 0
  decreases 0
=
  if container_json_field_str_i(config_json, "ociVersion", out, cap) == 0:
    return 0
  return 1

def bundle_process_uid(config_json: var ptr) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return container_json_process_uid_i(config_json)

def bundle_process_gid(config_json: var ptr) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return container_json_process_gid_i(config_json)

def bundle_apply_cgroup_limits(cgroup_path: var ptr, config_json: var ptr) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  return container_cgroup_apply_limits_i(cgroup_path, config_json)
