type Item = object
  public tag: int
  public score: int

type Bundle = object
  public count: int
  public items: array[2, Item]

def bundle_ready() -> Bundle
  requires true
  ensures result.count == 2
  ensures result.items[0].tag == 1
  ensures result.items[1].score == 5
  decreases 0
=
  var b: Bundle
  b.count = 2
  b.items[0].tag = 1
  b.items[0].score = 2
  b.items[1].tag = 3
  b.items[1].score = 5
  return b

def item_points(it: Item) -> int
  requires true
  ensures result == it.tag + it.score
  decreases 0
=
  return it.tag + it.score

def bundle_points(b: Bundle) -> int
  requires true
  ensures result == item_points(b.items[0]) + item_points(b.items[1])
  decreases 0
=
  return item_points(b.items[0]) + item_points(b.items[1])

def main() -> int
  requires true
  ensures result == 11
  decreases 0
=
  var b: Bundle = bundle_ready()
  return bundle_points(b)
