# li-parallel dual-mode entry (WP-PAR-48).
# Harness runs this when LI_PARALLEL=1; runtime pool + C overrides apply parallel execution.

# Li md_lennard_jones — driver over shared C kernel (md_core.c via LI_EXTRA_C).
# Harness reads energy drift via li_rt_volatile_sink_f64 + LI_PRINT_SINK_F64.

extern def li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

extern def li_md_kernel()
  requires true
  ensures true

extern def li_md_checksum() -> float
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_md_kernel()
  li_rt_volatile_sink_f64(li_md_checksum())
  return 0
