# P-LM-BC-TH-028: Adiabatic ideal gas PV^gamma = const.

def ideal_gas_pressure(n: float, r: float, t: float, v: float) -> float
  requires v > 0.0 and n >= 0.0 and t > 0.0
  ensures result == n * r * t / v
  decreases 0
=
  return n * r * t / v

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
