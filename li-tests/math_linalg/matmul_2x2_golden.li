# 2×2 GEMM golden: A @ B with known numeric result (PH-2i / G-math shape slice).
# A = [[1,2],[3,4]], B = [[5,6],[7,8]] → C = [[19,22],[43,50]]

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true
  decreases 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var A: array[2, array[2, float]]
  var B: array[2, array[2, float]]
  A[0][0] = 1.0
  A[0][1] = 2.0
  A[1][0] = 3.0
  A[1][1] = 4.0
  B[0][0] = 5.0
  B[0][1] = 6.0
  B[1][0] = 7.0
  B[1][1] = 8.0
  var C: array[2, array[2, float]] = A @ B
  if C[0][0] != 19.0:
    return 1
  if C[0][1] != 22.0:
    return 2
  if C[1][0] != 43.0:
    return 3
  if C[1][1] != 50.0:
    return 4
  li_rt_volatile_sink_f64(C[1][1])
  return 0
