import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fea_run: SimRunResult = run_algo(214, 0)
  if run_result_ok(fea_run) != 1:
    return 1
  if fea_run.algo_id != 214:
    return 2
  if fea_run.checksum != sim_scientific_oracle_checksum_fea():
    return 3
  if fea_run.checksum == 1.001:
    return 4
  return 0
