type Particle = object
  public px: float
  public py: float
  public pz: float
  public vx: float
  public vy: float
  public vz: float
  public life: float

type Emitter = object
  public rate: float
  public burst: int
def li_std_physics_particles_version() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3
def emitter_tick(e: Emitter, dt: float) -> int
  requires dt >= 0.0
  ensures result >= 0
  decreases 0
=
  if e.burst > 0:
    return e.burst
  return 0
def nbody_pair_force(
    ax: float, ay: float, bx: float, by: float,
    g: float, mass: float, soft: float,
    fx: float, fy: float) -> unit
  requires g > 0.0
  requires mass > 0.0
  ensures result == 0
  decreases 0
=
  return

# Lennard-Jones force scalar (truncated at cutoff)
def lj_force_scalar(r: float, epsilon: float, sigma: float, rc: float) -> float
  requires r > 0.0
  requires sigma > 0.0
  requires rc > 0.0
  ensures result >= 0.0
  decreases 0
=
  if r >= rc:
    return 0.0
  var sr: float = sigma / r
  var sr6: float = sr * sr * sr * sr * sr * sr
  var sr12: float = sr6 * sr6
  return 24.0 * epsilon * (2.0 * sr12 - sr6) / r

# Babylonian sqrt for smoke kernels (avoids math.numerics import / duplicate extern).
def md_sqrt_smoke(x: float) -> float
  requires x >= 0.0
  ensures true
  decreases 0
=
  if x <= 0.0:
    return 0.0
  var guess: float = x
  if guess < 1.0:
    guess = 1.0
  var k: int = 0
  while k < 8
    guess = 0.5 * (guess + x / guess)
    k = k + 1
  return guess

# Minimum-image convention for cubic periodic box.
def md_mic(delta: float, box: float) -> float
  requires box > 0.0
  ensures true
  decreases 0
=
  var half: float = box * 0.5
  if delta > half:
    return delta - box
  if delta < -half:
    return delta + box
  return delta

# One-axis cell index (ncell=2 smoke grid).
def md_cell_index_1d(pos: float, box: float) -> int
  requires box > 0.0
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var half: float = box * 0.5
  if pos >= half:
    return 1
  return 0

def md_cells_neighbor(cxi: int, cyi: int, czi: int, cxj: int, cyj: int, czj: int) -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var dx: int = cxi - cxj
  if dx < 0:
    dx = -dx
  var dy: int = cyi - cyj
  if dy < 0:
    dy = -dy
  var dz: int = czi - czj
  if dz < 0:
    dz = -dz
  if dx <= 1:
    if dy <= 1:
      if dz <= 1:
        return 1
  return 0

# Sum LJ force scalars over pairs within 3×3×3 cell shell (half-shell i<j).
def md_neighbor_cell_list_force_sum(
    px: array[8, float], py: array[8, float], pz: array[8, float],
    box: float, rc: float) -> float
  requires box > 0.0
  requires rc > 0.0
  ensures true
  decreases 0
=
  var acc: float = 0.0
  var i: int = 0
  while i < 8
    var cxi: int = md_cell_index_1d(px[i], box)
    var cyi: int = md_cell_index_1d(py[i], box)
    var czi: int = md_cell_index_1d(pz[i], box)
    var j: int = i + 1
    while j < 8
      var cxj: int = md_cell_index_1d(px[j], box)
      var cyj: int = md_cell_index_1d(py[j], box)
      var czj: int = md_cell_index_1d(pz[j], box)
      var neigh: int = md_cells_neighbor(cxi, cyi, czi, cxj, cyj, czj)
      if neigh == 1:
        var dx: float = md_mic(px[j] - px[i], box)
        var dy: float = md_mic(py[j] - py[i], box)
        var dz: float = md_mic(pz[j] - pz[i], box)
        var r2: float = dx * dx + dy * dy + dz * dz
        if r2 > 1e-12:
          var r: float = md_sqrt_smoke(r2)
          acc = acc + lj_force_scalar(r, 1.0, 1.0, rc)
      j = j + 1
    i = i + 1
  return acc

# Smoke checksum: 8-particle FCC-like lattice in box=4.0, rc=2.5 (algo_id=105).
def md_neighbor_cell_list_smoke_checksum() -> float
  requires true
  ensures true
  decreases 0
=
  var px: array[8, float]
  var py: array[8, float]
  var pz: array[8, float]
  px[0] = 0.6
  py[0] = 0.6
  pz[0] = 0.6
  px[1] = 1.2
  py[1] = 1.2
  pz[1] = 1.2
  px[2] = 2.6
  py[2] = 0.6
  pz[2] = 0.6
  px[3] = 3.2
  py[3] = 1.2
  pz[3] = 1.2
  px[4] = 0.6
  py[4] = 2.6
  pz[4] = 0.6
  px[5] = 1.2
  py[5] = 3.2
  pz[5] = 1.2
  px[6] = 2.6
  py[6] = 2.6
  pz[6] = 0.6
  px[7] = 3.2
  py[7] = 3.2
  pz[7] = 1.2
  return md_neighbor_cell_list_force_sum(px, py, pz, 4.0, 2.5)

def md_mini_step(
    px: array[16, float], py: array[16, float], pz: array[16, float],
    vx: array[16, float], vy: array[16, float], vz: array[16, float],
    dt: float) -> unit
  requires dt > 0.0
  ensures result == 0
  decreases 0
=
  var i: int = 0
  while i < 16
    px[i] = px[i] + vx[i] * dt
    py[i] = py[i] + vy[i] * dt
    pz[i] = pz[i] + vz[i] * dt
    i = i + 1

# --- WP-ECHEM-10: classical MD solvent shell (LJ + Ewald stub) around echem slab ---

def echem_solvent_water_count() -> int
  requires true
  ensures result == 16
  decreases 0
=
  return 16

def echem_solvent_sphere_center_z_ang() -> float
  requires true
  ensures result > 4.0
  ensures result < 6.0
  decreases 0
=
  return 5.0

def echem_solvent_lj_epsilon_kcal() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.1521

def echem_solvent_lj_sigma_ang() -> float
  requires true
  ensures result > 3.0
  ensures result < 3.5
  decreases 0
=
  return 3.1507

def echem_solvent_lj_rc_ang() -> float
  requires true
  ensures result > 7.0
  decreases 0
=
  return 8.0

def echem_ewald_stub_kappa() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.4

def echem_ewald_stub_energy(r: float) -> float
  requires r > 0.0
  ensures result >= 0.0
  decreases 0
=
  var kappa: float = echem_ewald_stub_kappa()
  var damp: float = 1.0
  var kr: float = kappa * r
  if kr >= 6.0:
    damp = 0.0
  if kr > 0.0:
    if kr < 6.0:
      damp = 1.0 - kr / 6.0
  return damp / r

def echem_solvent_water_spacing_ang() -> float
  requires true
  ensures result > 2.5
  ensures result < 3.2
  decreases 0
=
  return 2.8

def echem_solvent_water_oxygen_x(idx: int) -> float
  requires idx >= 0
  requires idx < echem_solvent_water_count()
  ensures result >= -8.0
  ensures result <= 8.0
  decreases 0
=
  var i: int = idx
  var col: int = i % 4
  var spacing: float = echem_solvent_water_spacing_ang()
  if col == 0:
    return -1.5 * spacing
  if col == 1:
    return -0.5 * spacing
  if col == 2:
    return 0.5 * spacing
  return 1.5 * spacing

def echem_solvent_water_oxygen_y(idx: int) -> float
  requires idx >= 0
  requires idx < echem_solvent_water_count()
  ensures result >= -8.0
  ensures result <= 8.0
  decreases 0
=
  var i: int = idx
  var row: int = i / 4
  var spacing: float = echem_solvent_water_spacing_ang()
  if row == 0:
    return -1.5 * spacing
  if row == 1:
    return -0.5 * spacing
  if row == 2:
    return 0.5 * spacing
  return 1.5 * spacing

def echem_solvent_water_oxygen_z(idx: int) -> float
  requires idx >= 0
  requires idx < echem_solvent_water_count()
  ensures result > 3.0
  ensures result < 7.0
  decreases 0
=
  var i: int = idx
  var base: float = echem_solvent_sphere_center_z_ang()
  var layer: float = 0.0
  if i % 2 == 1:
    layer = 0.2
  if i >= echem_solvent_water_count() / 2:
    layer = layer + 0.4
  return base + layer

def echem_solvent_pair_distance_sq(idx_a: int, idx_b: int) -> float
  requires idx_a >= 0
  requires idx_b >= 0
  requires idx_a < echem_solvent_water_count()
  requires idx_b < echem_solvent_water_count()
  ensures result >= 0.0
  decreases 0
=
  var ia: int = idx_a
  var ib: int = idx_b
  var dx: float = echem_solvent_water_oxygen_x(ib) - echem_solvent_water_oxygen_x(ia)
  var dy: float = echem_solvent_water_oxygen_y(ib) - echem_solvent_water_oxygen_y(ia)
  var dz: float = echem_solvent_water_oxygen_z(ib) - echem_solvent_water_oxygen_z(ia)
  return dx * dx + dy * dy + dz * dz

def echem_solvent_sqrt_r2(r2: float) -> float
  requires r2 >= 0.0
  ensures result >= 0.0
  decreases 0
=
  if r2 < 1.0e-12:
    return 0.0
  var r: float = r2
  if r2 > 1.0:
    r = r2 * 0.5 + 0.5
  var k: int = 0
  while k < 8
    r = 0.5 * (r + r2 / r)
    k = k + 1
  return r

def echem_solvent_pair_lj_energy(idx_a: int, idx_b: int) -> float
  requires idx_a >= 0
  requires idx_b >= 0
  requires idx_a < echem_solvent_water_count()
  requires idx_b < echem_solvent_water_count()
  ensures result >= -100.0
  ensures result <= 100.0
  decreases 0
=
  var ia: int = idx_a
  var ib: int = idx_b
  var r2: float = echem_solvent_pair_distance_sq(ia, ib)
  if r2 < 1.0e-12:
    return 0.0
  var r: float = echem_solvent_sqrt_r2(r2)
  var rc: float = echem_solvent_lj_rc_ang()
  if r >= rc:
    return 0.0
  var eps: float = echem_solvent_lj_epsilon_kcal()
  var sig: float = echem_solvent_lj_sigma_ang()
  var sr: float = sig / r
  var sr6: float = sr * sr * sr * sr * sr * sr
  var sr12: float = sr6 * sr6
  return 4.0 * eps * (sr12 - sr6)

def echem_solvent_shell_energy_stub() -> float
  requires true
  ensures result != 0.0
  decreases 0
=
  var n: int = echem_solvent_water_count()
  var e_lj: float = 0.0
  var e_ew: float = 0.0
  var i: int = 0
  while i < n
    var j: int = i + 1
    while j < n
      e_lj = e_lj + echem_solvent_pair_lj_energy(i, j)
      var r2: float = echem_solvent_pair_distance_sq(i, j)
      if r2 > 1.0e-12:
        var r: float = echem_solvent_sqrt_r2(r2)
        e_ew = e_ew + echem_ewald_stub_energy(r)
      j = j + 1
    i = i + 1
  return e_lj + 0.01 * e_ew

def echem_solvent_gr_bin_count() -> int
  requires true
  ensures result == 16
  decreases 0
=
  return 16

def echem_solvent_gr_dr_ang() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.5

def echem_solvent_gr_bin_lo_ang(bin_idx: int) -> float
  requires bin_idx >= 0
  requires bin_idx < echem_solvent_gr_bin_count()
  ensures result >= 0.0
  decreases bin_idx
=
  if bin_idx == 0:
    return 0.0
  if bin_idx == 1:
    return 0.5
  if bin_idx == 2:
    return 1.0
  if bin_idx == 3:
    return 1.5
  if bin_idx == 4:
    return 2.0
  if bin_idx == 5:
    return 2.5
  if bin_idx == 6:
    return 3.0
  if bin_idx == 7:
    return 3.5
  if bin_idx == 8:
    return 4.0
  if bin_idx == 9:
    return 4.5
  if bin_idx == 10:
    return 5.0
  if bin_idx == 11:
    return 5.5
  if bin_idx == 12:
    return 6.0
  if bin_idx == 13:
    return 6.5
  if bin_idx == 14:
    return 7.0
  return 7.5

def echem_solvent_gr_bin_center_ang(bin_idx: int) -> float
  requires bin_idx >= 0
  requires bin_idx < echem_solvent_gr_bin_count()
  ensures result > 0.0
  decreases bin_idx
=
  var lo: float = echem_solvent_gr_bin_lo_ang(bin_idx)
  var dr: float = echem_solvent_gr_dr_ang()
  return lo + 0.5 * dr

def echem_solvent_gr_bin_hits(bin_idx: int) -> int
  requires bin_idx >= 0
  requires bin_idx < echem_solvent_gr_bin_count()
  ensures result >= 0
  decreases 0
=
  var n: int = echem_solvent_water_count()
  var dr: float = echem_solvent_gr_dr_ang()
  var hits: int = 0
  var i: int = 0
  while i < n
    var j: int = i + 1
    while j < n
      var r2: float = echem_solvent_pair_distance_sq(i, j)
      if r2 > 1.0e-12:
        var r: float = echem_solvent_sqrt_r2(r2)
        var b: int = 0
        while b < echem_solvent_gr_bin_count()
          var lo: float = echem_solvent_gr_bin_lo_ang(b)
          var hi: float = lo + dr
          if r >= lo:
            if r < hi:
              if b == bin_idx:
                hits = hits + 1
          b = b + 1
      j = j + 1
    i = i + 1
  return hits

def echem_solvent_gr_peak_r_ang() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  var best_bin: int = 0
  var best_hits: int = 0
  var b: int = 0
  while b < echem_solvent_gr_bin_count()
    var h: int = echem_solvent_gr_bin_hits(b)
    if h > best_hits:
      best_hits = h
      best_bin = b
    b = b + 1
  return echem_solvent_gr_bin_center_ang(best_bin)

def echem_solvent_gr_peak_reference_ang() -> float
  requires true
  ensures result > 2.0
  ensures result < 4.0
  decreases 0
=
  return 2.8

def echem_solvent_gr_peak_tolerance_ang() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.35

def echem_solvent_gr_peak_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var peak: float = echem_solvent_gr_peak_r_ang()
  var ref: float = echem_solvent_gr_peak_reference_ang()
  var tol: float = echem_solvent_gr_peak_tolerance_ang()
  var d: float = peak - ref
  if d < 0.0:
    d = -d
  if d > tol:
    return 0
  var e: float = echem_solvent_shell_energy_stub()
  if e == 0.0:
    return 0
  return 1
