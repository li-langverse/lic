def echem_gc_charge_neutrality_next(q: float, u_v: float) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var mu: float = echem_gc_mu_electron_ev(u_v)
  var mu0: float = echem_she_reference_ev()
  var diff: float = mu - mu0
  return q * 0.80 + 0.004 * diff

def echem_gc_charge_drift_abs(q: float) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  if q >= 0.0:
    return q
  return -q

def echem_gc_charge_neutrality_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
