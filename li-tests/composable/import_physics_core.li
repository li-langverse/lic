import physics.core

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var p: PhysicsProfile = profile_for_tier(physics_tier_simulation())
  var order: int = select_integrator_order(p)
  if order < 1:
    return 1
  if physics_core_units_smoke() != 1:
    return 2
  return 0
