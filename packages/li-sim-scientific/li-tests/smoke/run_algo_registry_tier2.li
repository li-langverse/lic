import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  var md_chk: float = md105.checksum
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md_chk != sim_scientific_oracle_checksum_md():
    return 3
  if md_chk == 1.001:
    return 4
  var heat201: SimRunResult = run_algo(201, 2)
  var heat_chk: float = heat201.checksum
  if run_result_ok(heat201) != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat_chk != sim_scientific_oracle_checksum_heat():
    return 7
  if heat_chk == 1.001:
    return 8
  var cfd205: SimRunResult = run_algo(205, 1)
  var cfd_chk: float = cfd205.checksum
  if run_result_ok(cfd205) != 1:
    return 9
  if cfd205.algo_id != 205:
    return 10
  if cfd_chk != sim_scientific_oracle_checksum_cfd():
    return 11
  if cfd_chk == 1.001:
    return 12
  var fea211: SimRunResult = run_algo(211, 1)
  var fea_chk: float = fea211.checksum
  if run_result_ok(fea211) != 1:
    return 13
  if fea211.algo_id != 211:
    return 14
  if fea_chk != sim_scientific_oracle_checksum_fea():
    return 15
  if fea_chk == 1.001:
    return 16
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  var qm_chk: float = qm418.checksum
  if run_result_ok(qm418) != 1:
    return 20
  if qm_chk != sim_scientific_oracle_checksum_qm():
    return 21
  if qm_chk == 1.001:
    return 22
  var rigid302: SimRunResult = run_algo(302, 0)
  var rigid_chk: float = rigid302.checksum
  if run_result_ok(rigid302) != 1:
    return 17
  if rigid302.algo_id != 302:
    return 18
  if rigid_chk == 1.001:
    return 19
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  var aimd_chk: float = aimd433.checksum
  if run_result_ok(aimd433) != 1:
    return 25
  if aimd433.algo_id != 433:
    return 26
  if aimd_chk != sim_scientific_oracle_checksum_echem_aimd():
    return 27
  if aimd_chk == 1.001:
    return 28
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  var gc_chk: float = gc434.checksum
  if run_result_ok(gc434) != 1:
    return 31
  if gc434.algo_id != 434:
    return 32
  if gc_chk != sim_scientific_oracle_checksum_echem_gc_aimd():
    return 33
  if gc_chk == 1.001:
    return 34
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  var sei_chk: float = sei435.checksum
  if run_result_ok(sei435) != 1:
    return 37
  if sei435.algo_id != 435:
    return 38
  if sei_chk != sim_scientific_oracle_checksum_echem_sei_kmc():
    return 39
  if sei_chk == 1.001:
    return 40
  return 0
