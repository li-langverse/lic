import lig

# PH-SCI-GPU-CHEM — mini STO-3G-style basis + DFT energy kernel (CPU lib; @gpu smokes call in).
def chem_dft_energy_stub_hartree() -> float
  requires true
  ensures result == -76.0
  decreases 0
=
  return -76.0

def chem_dft_sto3g_grid_n() -> int
  requires true
  ensures result == 8
  decreases 0
=
  return 8

def chem_dft_basis_n() -> int
  requires true
  ensures result == 4
  decreases 0
=
  return 4

def chem_dft_grid_dr() -> float
  requires true
  ensures result > 0.0
  decreases 0
=
  return 0.18

def chem_dft_grid_r_at(i: int) -> float
  requires i >= 0
  requires i < chem_dft_sto3g_grid_n()
  ensures result > 0.0
  decreases i
=
  if i == 0:
    return 0.12
  if i == 1:
    return 0.30
  if i == 2:
    return 0.48
  if i == 3:
    return 0.66
  if i == 4:
    return 0.84
  if i == 5:
    return 1.02
  if i == 6:
    return 1.20
  return 1.38

def chem_dft_basis_zeta_at(bi: int) -> float
  requires bi >= 0
  requires bi < chem_dft_basis_n()
  ensures result > 0.0
  decreases bi
=
  if bi == 0:
    return 3.42525091
  if bi == 1:
    return 0.62391373
  if bi == 2:
    return 0.16885540
  return 0.90000000

def chem_dft_basis_centroid_at(bi: int) -> float
  requires bi >= 0
  requires bi < chem_dft_basis_n()
  ensures result > 0.0
  decreases bi
=
  if bi == 0:
    return 0.30
  if bi == 1:
    return 0.60
  if bi == 2:
    return 0.90
  return 1.20

# Slater-like primitive (no libm exp): 1 / (1 + zeta * r^2).
def chem_dft_primitive_decay(r: float, zeta: float) -> float
  requires r >= 0.0
  requires zeta > 0.0
  ensures result > 0.0
  decreases 0
=
  var rr: float = r * r
  return 1.0 / (1.0 + zeta * rr)

def chem_dft_basis_eval_at(bi: int, r: float) -> float
  requires bi >= 0
  requires bi < chem_dft_basis_n()
  requires r >= 0.0
  ensures result >= 0.0
  decreases bi
=
  return chem_dft_primitive_decay(r, chem_dft_basis_zeta_at(bi))

# Contracted mini STO-3G s-type on radial grid (H-like exponents/coeffs, scaled).
def chem_dft_basis_eval_sto3g(r: float) -> float
  requires r >= 0.0
  ensures result >= 0.0
  decreases 0
=
  var p0: float = chem_dft_primitive_decay(r, 3.42525091)
  var p1: float = chem_dft_primitive_decay(r, 0.62391373)
  var p2: float = chem_dft_primitive_decay(r, 0.16885540)
  return 0.15432897 * p0 + 0.53532814 * p1 + 0.44463454 * p2

def chem_dft_cbrt_rho(rho: float) -> float
  requires rho >= 0.0
  ensures result >= 0.0
  decreases 0
=
  if rho <= 1.0e-12:
    return 0.0
  var x: float = rho
  if x < 1.0e-6:
    x = 1.0e-6
  var k: int = 0
  while k < 4
    var x2: float = x * x
    if x2 > 1.0e-18:
      x = (2.0 * x + rho / x2) / 3.0
    k = k + 1
  return x

# Slater LDA exchange on grid: -0.75 * (3/pi)^(1/3) * rho^(1/3).
def chem_dft_lda_xc_density(rho: float) -> float
  requires rho >= 0.0
  ensures result <= 0.0
  decreases 0
=
  if rho <= 1.0e-12:
    return 0.0
  var cbrt: float = chem_dft_cbrt_rho(rho)
  return -0.738558 * cbrt

def chem_dft_coulomb_2center(bi: int, bj: int) -> float
  requires bi >= 0
  requires bi < chem_dft_basis_n()
  requires bj >= 0
  requires bj < chem_dft_basis_n()
  ensures result > 0.0
  decreases bi + bj
=
  var ri: float = chem_dft_basis_centroid_at(bi)
  var rj: float = chem_dft_basis_centroid_at(bj)
  var d: float = ri - rj
  if d < 0.0:
    d = -d
  return 1.0 / (d + 0.20)

def chem_dft_overlap_build(S: var array[4, array[4, float]]) -> unit
  requires true
  ensures true
  decreases 0
=
  var dr: float = chem_dft_grid_dr()
  var i: int = 0
  while i < chem_dft_basis_n()
    var j: int = 0
    while j < chem_dft_basis_n()
      var s_ij: float = 0.0
      var k: int = 0
      while k < chem_dft_sto3g_grid_n()
        var r: float = chem_dft_grid_r_at(k)
        var phi_i: float = chem_dft_basis_eval_at(i, r)
        var phi_j: float = chem_dft_basis_eval_at(j, r)
        s_ij = s_ij + phi_i * phi_j * dr
        k = k + 1
      S[i][j] = s_ij
      j = j + 1
    i = i + 1

def chem_dft_core_hamiltonian_ii(bi: int) -> float
  requires bi >= 0
  requires bi < chem_dft_basis_n()
  ensures result == -1.0 / (chem_dft_basis_centroid_at(bi) + 0.05) + 0.25 * chem_dft_basis_zeta_at(bi)
  decreases bi
=
  var z_eff: float = 1.0
  var ri: float = chem_dft_basis_centroid_at(bi)
  return -z_eff / (ri + 0.05) + 0.25 * chem_dft_basis_zeta_at(bi)

def chem_dft_fock_diagonal_build(P: array[4, array[4, float]], F: var array[4, array[4, float]]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < chem_dft_basis_n()
    var j: int = 0
    while j < chem_dft_basis_n()
      F[i][j] = 0.0
      j = j + 1
    i = i + 1
  i = 0
  while i < chem_dft_basis_n()
    var h_ii: float = chem_dft_core_hamiltonian_ii(i)
    var coul: float = 0.0
    var exch: float = 0.0
    var j: int = 0
    while j < chem_dft_basis_n()
      var p_jj: float = P[j][j]
      coul = coul + p_jj * chem_dft_coulomb_2center(i, j)
      if i == j:
        exch = exch + 0.5 * p_jj * chem_dft_coulomb_2center(i, j)
      j = j + 1
    F[i][i] = h_ii + coul - exch
    i = i + 1

def chem_dft_copy4(src: var array[4, float], dst: var array[4, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < chem_dft_basis_n()
    dst[i] = src[i]
    i = i + 1

def chem_dft_matvec4(F: array[4, array[4, float]], v: var array[4, float], out: var array[4, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < chem_dft_basis_n()
    var sum: float = 0.0
    var j: int = 0
    while j < chem_dft_basis_n()
      sum = sum + F[i][j] * v[j]
      j = j + 1
    out[i] = sum
    i = i + 1

def chem_dft_vec_norm4(v: array[4, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var sum: float = 0.0
  var i: int = 0
  while i < chem_dft_basis_n()
    sum = sum + v[i] * v[i]
    i = i + 1
  if sum <= 0.0:
    return 1.0
  var n: int = 0
  var x: float = sum
  while n < 6
    x = 0.5 * (x + sum / x)
    n = n + 1
  return x

def chem_dft_vec_normalize4(v: var array[4, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var norm: float = chem_dft_vec_norm4(v)
  if norm <= 1.0e-12:
    return
  var i: int = 0
  while i < chem_dft_basis_n()
    v[i] = v[i] / norm
    i = i + 1

def chem_dft_rayleigh4(F: array[4, array[4, float]], v: var array[4, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var Fv: array[4, float]
  chem_dft_matvec4(F, v, Fv)
  var num: float = 0.0
  var i: int = 0
  while i < chem_dft_basis_n()
    num = num + v[i] * Fv[i]
    i = i + 1
  return num

def chem_dft_eigensolve_power4(F: array[4, array[4, float]], coeffs: var array[4, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var i: int = 0
  while i < chem_dft_basis_n()
    coeffs[i] = 1.0
    i = i + 1
  chem_dft_vec_normalize4(coeffs)
  var energy: float = chem_dft_rayleigh4(F, coeffs)
  var step: int = 0
  while step < 6
    var Fv: array[4, float]
    chem_dft_matvec4(F, coeffs, Fv)
    i = 0
    while i < chem_dft_basis_n()
      coeffs[i] = Fv[i]
      i = i + 1
    chem_dft_vec_normalize4(coeffs)
    energy = chem_dft_rayleigh4(F, coeffs)
    step = step + 1
  return energy

def chem_dft_density_matrix_from_coeffs(coeffs: var array[4, float], P: var array[4, array[4, float]]) -> unit
  requires true
  ensures true
  decreases 0
=
  var i: int = 0
  while i < chem_dft_basis_n()
    var j: int = 0
    while j < chem_dft_basis_n()
      P[i][j] = 2.0 * coeffs[i] * coeffs[j]
      j = j + 1
    i = i + 1

def chem_dft_fill_density_from_coeffs(coeffs: var array[4, float], dens: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var k: int = 0
  while k < chem_dft_sto3g_grid_n()
    var r: float = chem_dft_grid_r_at(k)
    var psi: float = 0.0
    var i: int = 0
    while i < chem_dft_basis_n()
      psi = psi + coeffs[i] * chem_dft_basis_eval_at(i, r)
      i = i + 1
    dens[k] = psi * psi
    k = k + 1

def chem_dft_fill_density_from_basis(dens: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  var coeffs: array[4, float]
  var i: int = 0
  while i < chem_dft_basis_n()
    coeffs[i] = 0.0
    i = i + 1
  coeffs[0] = 1.0
  chem_dft_fill_density_from_coeffs(coeffs, dens)

def chem_dft_hartree_grid(dens: array[8, float]) -> float
  requires true
  ensures result >= 0.0
  decreases 0
=
  var hartree: float = 0.0
  var dr: float = chem_dft_grid_dr()
  var i: int = 0
  while i < chem_dft_sto3g_grid_n()
    var ri: float = chem_dft_grid_r_at(i)
    var j: int = 0
    while j < chem_dft_sto3g_grid_n()
      var rj: float = chem_dft_grid_r_at(j)
      var d: float = ri - rj
      if d < 0.0:
        d = -d
      hartree = hartree + 0.5 * dens[i] * dens[j] * dr * dr / (d + 0.05)
      j = j + 1
    i = i + 1
  return hartree

def chem_dft_energy_from_density(dens: array[8, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var kin: float = 0.0
  var pot: float = 0.0
  var xc: float = 0.0
  var z_eff: float = 1.0
  var dr: float = chem_dft_grid_dr()
  var i: int = 0
  while i < chem_dft_sto3g_grid_n()
    var r: float = chem_dft_grid_r_at(i)
    var rho: float = dens[i]
    pot = pot - z_eff * rho * dr / (r + 0.05)
    xc = xc + chem_dft_lda_xc_density(rho) * dr
    if i < 7:
      var dphi: float = chem_dft_basis_eval_sto3g(chem_dft_grid_r_at(i + 1))
      dphi = dphi - chem_dft_basis_eval_sto3g(r)
      kin = kin + 0.5 * dphi * dphi / (dr * dr)
    i = i + 1
  var hartree: float = chem_dft_hartree_grid(dens)
  return kin + pot + xc + hartree

def chem_dft_energy_kernel_hartree() -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var dens: array[8, float]
  chem_dft_fill_density_from_basis(dens)
  return chem_dft_energy_from_density(dens)

def chem_dft_fock_density_mix_step(dens: var array[8, float], mix: float) -> unit
  requires mix > 0.0
  requires mix <= 1.0
  ensures true
  decreases 0
=
  var target: array[8, float]
  chem_dft_fill_density_from_basis(target)
  var i: int = 0
  while i < chem_dft_sto3g_grid_n()
    dens[i] = (1.0 - mix) * dens[i] + mix * target[i]
    i = i + 1

def chem_dft_scf_fock_step(dens: var array[8, float], mix: float) -> float
  requires mix > 0.0
  requires mix <= 1.0
  ensures result <= 0.0
  decreases 0
=
  return chem_dft_scf_fock_step_at_potential(dens, mix, 0.0)

# WP-ECHEM-06: scalar electrode potential shifts electron chemical potential in Fock diagonal.
def chem_dft_potential_shift_hartree(u_v: float) -> float
  requires true
  ensures result == -u_v / 27.211386246
  decreases 0
=
  return -u_v / 27.211386246

def chem_dft_fock_apply_potential_shift(F: var array[4, array[4, float]], u_v: float) -> unit
  requires true
  ensures true
  decreases 0
=
  var shift: float = chem_dft_potential_shift_hartree(u_v)
  var i: int = 0
  while i < chem_dft_basis_n()
    F[i][i] = F[i][i] + shift
    i = i + 1

def chem_dft_scf_fock_step_at_potential(dens: var array[8, float], mix: float, u_v: float) -> float
  requires mix > 0.0
  requires mix <= 1.0
  ensures result <= 0.0
  decreases 0
=
  var P: array[4, array[4, float]]
  var coeffs: array[4, float]
  var i: int = 0
  while i < chem_dft_basis_n()
    coeffs[i] = 0.0
    i = i + 1
  coeffs[0] = 1.0
  chem_dft_density_matrix_from_coeffs(coeffs, P)
  var F: array[4, array[4, float]]
  chem_dft_fock_diagonal_build(P, F)
  chem_dft_fock_apply_potential_shift(F, u_v)
  var orb_energy: float = chem_dft_eigensolve_power4(F, coeffs)
  var new_dens: array[8, float]
  chem_dft_fill_density_from_coeffs(coeffs, new_dens)
  i = 0
  while i < chem_dft_sto3g_grid_n()
    dens[i] = (1.0 - mix) * dens[i] + mix * new_dens[i]
    i = i + 1
  return orb_energy

# SCF: Fock build + power eigensolve + density mixing until energy delta below tol.
def chem_dft_scf_iteration_scaffold(max_iter: int) -> float
  requires max_iter >= 1
  requires max_iter <= 32
  ensures result <= 0.0
  decreases max_iter
=
  var dens: array[8, float]
  chem_dft_fill_density_from_basis(dens)
  var energy: float = chem_dft_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < max_iter
    var orb_e: float = chem_dft_scf_fock_step(dens, mix)
    var e_new: float = chem_dft_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

def chem_dft_scf_iteration_scaffold_at_potential(max_iter: int, u_v: float) -> float
  requires max_iter >= 1
  requires max_iter <= 32
  ensures result <= 0.0
  decreases max_iter
=
  var dens: array[8, float]
  chem_dft_fill_density_from_basis(dens)
  var energy: float = chem_dft_energy_from_density(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < max_iter
    var orb_e: float = chem_dft_scf_fock_step_at_potential(dens, mix, u_v)
    var e_new: float = chem_dft_energy_from_density(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

def chem_dft_h2_bond_length_ang() -> float
  requires true
  ensures result == 0.74
  decreases 0
=
  return 0.74

# H₂ diatomic nuclear potential on radial grid (midpoint gauge; WP-ECHEM-05 oracle geometry).
def chem_dft_energy_from_density_h2(dens: array[8, float]) -> float
  requires true
  ensures result <= 0.0
  decreases 0
=
  var kin: float = 0.0
  var pot: float = 0.0
  var xc: float = 0.0
  var dr: float = chem_dft_grid_dr()
  var half_bond: float = 0.5 * chem_dft_h2_bond_length_ang()
  var i: int = 0
  while i < chem_dft_sto3g_grid_n()
    var r: float = chem_dft_grid_r_at(i)
    var rho: float = dens[i]
    var d_nuc: float = r + half_bond
    var inv_r: float = 1.0 / (d_nuc + 0.05)
    pot = pot - rho * dr * (inv_r + inv_r)
    xc = xc + chem_dft_lda_xc_density(rho) * dr
    if i < 7:
      var dphi: float = chem_dft_basis_eval_sto3g(chem_dft_grid_r_at(i + 1))
      dphi = dphi - chem_dft_basis_eval_sto3g(r)
      kin = kin + 0.5 * dphi * dphi / (dr * dr)
    i = i + 1
  var hartree: float = chem_dft_hartree_grid(dens)
  return kin + pot + xc + hartree

def chem_dft_scf_h2_iteration_scaffold(max_iter: int) -> float
  requires max_iter >= 1
  requires max_iter <= 32
  ensures result <= 0.0
  decreases max_iter
=
  var dens: array[8, float]
  chem_dft_fill_density_from_basis(dens)
  var energy: float = chem_dft_energy_from_density_h2(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < max_iter
    var orb_e: float = chem_dft_scf_fock_step(dens, mix)
    var e_new: float = chem_dft_energy_from_density_h2(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

def chem_dft_scf_h2_iteration_scaffold_at_potential(max_iter: int, u_v: float) -> float
  requires max_iter >= 1
  requires max_iter <= 32
  ensures result <= 0.0
  decreases max_iter
=
  var dens: array[8, float]
  chem_dft_fill_density_from_basis(dens)
  var energy: float = chem_dft_energy_from_density_h2(dens)
  var iter: int = 0
  var tol: float = 1.0e-5
  var mix: float = 0.35
  while iter < max_iter
    var orb_e: float = chem_dft_scf_fock_step_at_potential(dens, mix, u_v)
    var e_new: float = chem_dft_energy_from_density_h2(dens)
    if orb_e < e_new:
      e_new = orb_e
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

def chem_dft_gpu_energy_checksum() -> float
  requires true
  ensures result >= 0.0
  ensures result <= 1.0
  decreases 0
=
  var e: float = chem_dft_scf_iteration_scaffold(6)
  var lo: float = -1.25
  var hi: float = -0.02
  var span: float = hi - lo
  if span < 1.0e-9:
    span = 1.0e-9
  var t: float = (e - lo) / span
  if t < 0.0:
    t = 0.0
  if t > 1.0:
    t = 1.0
  return t

def chem_dft_run_smoke() -> float
  requires true
  ensures result == chem_dft_energy_kernel_hartree()
  decreases 0
=
  return chem_dft_energy_kernel_hartree()

def chem_use_lkir() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return 1

def chem_lig_energy_kernel_id() -> int
  requires true
  ensures result == lig_kernel_matmul_f32()
  decreases 0
=
  return lig_kernel_matmul_f32()

def chem_dft_gpu_lkir_progress() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if chem_use_lkir() == 0:
    return 0
  if lig_kernel_run(chem_lig_energy_kernel_id(), lig_backend_select_auto()) != 0:
    return 0
  if lig_validity_gate_pass(0.999) != 1:
    return 0
  return 1

def chem_dft_gpu_lkir_launch_pipeline() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if chem_dft_gpu_lkir_progress() != 1:
    return 0
  if lig_gpu_launch_prologue_ok() != 1:
    return 0
  if lig_emit_vendor_progress() != 1:
    return 0
  if lig_gpu_device_buffer_ready() != 1:
    return 0
  return 1

# Studio/MCP queued GPU path: kernel energy + LKIR launch scaffold (CPU oracle when vendor absent).
def chem_dft_run_gpu_queue() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var e: float = chem_dft_energy_kernel_hartree()
  if e >= 0.0:
    return 0
  if chem_dft_gpu_lkir_launch_pipeline() != 1:
    return 0
  return 1

# --- WP-ECHEM-01: easy electrochemistry stubs (CHE / SHE / EDL / static NEB) ---

def echem_she_reference_ev() -> float
  requires true
  ensures result == 4.44
  decreases 0
=
  return 4.44

def echem_hartree_to_ev_factor() -> float
  requires true
  ensures result == 27.211386246
  decreases 0
=
  return 27.211386246

def echem_hartree_to_ev(hartree: float) -> float
  requires true
  ensures result == hartree * echem_hartree_to_ev_factor()
  decreases 0
=
  return hartree * echem_hartree_to_ev_factor()

