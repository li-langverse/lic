  ensures result.color == color
  ensures result.face_id == face_id
  ensures result.codepoint == codepoint
  ensures result.glyph_count == 1
  decreases codepoint
=
  var c: PaintCmd
  c.kind = paint_op_draw_glyphs()
  c.rect = dest
  c.color = color
  c.stroke_px = 0.0
  c.radius_px = 0.0
  c.color_b = color_rgb(0.0, 0.0, 0.0, 0.0)
  c.face_id = face_id
  c.codepoint = codepoint
  c.glyph_count = 1
  c.image_id = 0
  c.src_rect = rect_make(0.0, 0.0, 0.0, 0.0)
  return c

