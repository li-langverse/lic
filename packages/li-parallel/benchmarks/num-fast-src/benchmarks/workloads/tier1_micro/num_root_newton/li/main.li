# Pure-Li num_root_newton — hoist inner Newton; outer acc matches C fp accumulation.

extern proc li_rt_volatile_sink_f64(v: float) -> unit
  requires true
  ensures true

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var x: float = 1.0
  var i: int = 0
  while i < 12
    x = x - (x * x - 2.0) / (2.0 * x)
    i = i + 1
  var acc: float = 0.0
  var r: int = 0
  while r < 500000
    acc = acc + x
    r = r + 1
  li_rt_volatile_sink_f64(acc)
  return 0
