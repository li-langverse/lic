# PH-SCI-GPU-01: @gpu numerics three-body Verlet reference kernel.
import math.numerics

@gpu
def numerics_gpu_three_body_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return numerics_three_body_gpu_progress()

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if numerics_gpu_three_body_smoke() != 1:
    return 1
  return 0
