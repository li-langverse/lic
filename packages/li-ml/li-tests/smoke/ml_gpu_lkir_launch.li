# PH-ML Wave 12: @gpu → LKIR launch pipeline (requires LIG_EMIT_CUDA=1 at build/run).
import ml

@gpu
def ml_gpu_launch_smoke() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if ml_gpu_matmul_lkir_progress() != 1:
    return 0
  return ml_gpu_lkir_launch_pipeline()

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if ml_gpu_launch_smoke() != 1:
    return 1
  return 0
