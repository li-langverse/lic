# D-AX-BC-LOG-025: De Morgan: not (P and Q) equivalent to (not P or not Q).

extern proc d_ax_bc_log_025_axiom_witness() -> int
  requires true
  ensures result == 0
  decreases 0

def d_ax_bc_log_025_tautology(p: bool, q: bool) -> bool
  requires true
  ensures result == (p and q) or (not p) or (not q)
  decreases 0
=
  return (p and q) or (not p) or (not q)

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
