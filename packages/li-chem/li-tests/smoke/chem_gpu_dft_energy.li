# PH-SCI-GPU-16: @gpu DFT energy kernel (STO-3G grid + SCF scaffold via chem lib).
import chem

@gpu
def chem_gpu_dft_energy_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var e: float = chem_dft_energy_kernel_hartree()
  var chk: float = chem_dft_gpu_energy_checksum()
  if e >= 0.0:
    return 0
  if chk <= 0.0:
    return 0
  if chk >= 1.0:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if chem_gpu_dft_energy_smoke() != 1:
    return 1
  return 0
