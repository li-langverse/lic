=
  var e_is: float = echem_neb_image_energy_ev_at(0)
  var e_fs: float = echem_neb_image_energy_ev_at(4)
  var e_lo: float = e_is
  if e_fs < e_lo:
    e_lo = e_fs
  return e_lo

def echem_static_barrier_neb() -> float
  requires true
