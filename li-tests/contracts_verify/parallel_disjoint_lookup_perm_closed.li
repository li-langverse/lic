def par_disjoint_lookup_perm(buf: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  parallel for j in 0..<8
    requires disjoint_lookup(j, 7 - j, buf)
    decreases 8 - j
  =
    buf[7 - j] = 0.0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var buf: array[8, float]
  par_disjoint_lookup_perm(buf)
  return 0
