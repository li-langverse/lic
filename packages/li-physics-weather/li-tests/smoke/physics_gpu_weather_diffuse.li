import std.physics.weather

@gpu
def physics_gpu_weather_diffuse_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if physics_weather_std_tag() != 1:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if physics_gpu_weather_diffuse_smoke() != 1:
    return 1
  return 0
