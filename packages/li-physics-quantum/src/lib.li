def qm_scf_h2_ref_energy_hartree() -> float
  requires true
  ensures result <= 0.0
  ensures result >= -1.5
  decreases 0
=
  return -1.117658

def qm_scf_h2_stub_mix(energy: float, step: int) -> float
  requires step >= 0
  requires step <= 32
  requires energy <= 0.0
  ensures result <= 0.0
  decreases 0
=
  var target: float = qm_scf_h2_ref_energy_hartree()
  var mix: float = 0.35
  var next: float = energy + mix * (target - energy)
  if next > 0.0:
    next = 0.0
  return next

def qm_scf_h2_stub_energy() -> float
  requires true
  ensures result <= 0.0
  ensures result >= -1.5
  decreases 0
=
  var energy: float = -0.6
  var iter: int = 0
  var tol: float = 1.0e-5
  while iter < 8
    var e_new: float = qm_scf_h2_stub_mix(energy, iter)
    var de: float = e_new - energy
    if de < 0.0:
      de = -de
    energy = e_new
    if de < tol:
      return energy
    iter = iter + 1
  return energy

