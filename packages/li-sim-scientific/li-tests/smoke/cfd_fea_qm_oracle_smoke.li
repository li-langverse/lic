import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  if cfd <= 0.0:
    return 1
  var fea: float = sim_scientific_oracle_checksum_fea()
  if fea <= 0.0:
    return 2
  var qm: float = sim_scientific_oracle_checksum_qm()
  if qm <= 0.0:
    return 3
  return 0
