import std.execution.decorators
import std.execution.memory_spaces

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var host: int = memory_space_for_cpu_decorator()
  var device: int = memory_space_for_gpu_decorator()
  if host != 0:
    return 1
  if device != 1:
    return 1
  return __execution_decorators_doc() + __execution_memory_spaces_doc()
