  var u_v: float = 0.25
  var step: int = 0
  while step < 10
    q = echem_gc_charge_neutrality_next(q, u_v)
    step = step + 1
  var drift: float = echem_gc_charge_drift_abs(q)
  if drift >= 0.05:
