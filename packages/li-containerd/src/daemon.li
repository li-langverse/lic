# WP-CTN-060 — containerd daemon scaffold (backend-aware lifecycle wiring).

import container
import container.run
import cri
import oci

def containerd_serve_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def containerd_runtime_wiring_selftest() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  if containerd_serve_tag() != 1:
    return 1
  if li_oci_version() != 1:
    return 2
  if li_container_version() != 3:
    return 3
  if li_container_run_version() != 3:
    return 4
  if li_container_cri_version() != 1:
    return 5
  var r: int = li_container_selftest()
  if r != 0:
    return r + 10
  r = li_container_run_selftest()
  if r != 0:
    return r + 20
  r = li_container_cri_selftest()
  if r != 0:
    return r + 30
  return 0
