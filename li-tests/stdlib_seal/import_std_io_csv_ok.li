import std.csv
import std.io

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var tag: int = csv_tag() + io_tag()
  if tag != 10:
    return 1
  var f: FileHandle
  f.open = 0
  file_close(f)
  var nbytes: int = file_read_all_stub()
  if nbytes != 0:
    return 2
  return 0
