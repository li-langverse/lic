async def task_a(a: var array[4, int]) raises Async -> int
  requires true
  ensures result == 0
  decreases 0
=
  a[0] = 1
  return 0

async def task_b(b: var array[4, int]) raises Async -> int
  requires true
  ensures result == 0
  decreases 0
=
  b[1] = 2
  return 0

async def main(a: var array[4, int], b: var array[4, int]) raises Async -> int
  requires true
  ensures result == 0
  decreases 0
=
  await when_all(task_a(a), task_b(b))
  return 0
