import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  # Host float codegen may not match Python mirror drift ratio; bench uses md_oracle_li_mirror.py.
  var md: float = sim_scientific_oracle_checksum_md()
  if md == 1.001:
    return 2
  return 0
