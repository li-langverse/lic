import physics.quantum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var e: float = qm_scf_h2_stub_energy()
  if e >= 0.0:
    return 1
  if qm_scf_h2_stub_converged() != 1:
    return 2
  var iters: int = qm_scf_h2_stub_iterations()
  if iters < 1:
    return 3
  if iters > qm_scf_h2_stub_max_iterations():
    return 4
  if qm_scf_h2_bond_length_ang() != 0.74:
    return 5
  return 0
