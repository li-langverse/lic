def par_disjoint_lookup_const(buf: var array[8, float]) -> unit
  requires true
  ensures true
  decreases 0
=
  parallel for j in 0..<8
    requires disjoint_lookup(j, lookup_const(j, 3, 7, 1, 0, 5, 2, 4, 6), buf)
    decreases 8 - j
  =
    buf[lookup_const(j, 3, 7, 1, 0, 5, 2, 4, 6)] = 0.0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var buf: array[8, float]
  par_disjoint_lookup_const(buf)
  return 0
