# PH-SCI-GPU-02: @gpu MD + heat oracle checksums (simulation science vertical).
import sim.scientific

@gpu
def scientific_gpu_md_oracle_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var md: float = sim_scientific_oracle_checksum_md()
  if md < 0.0:
    return 0
  if md >= 1.0e-3:
    return 0
  return 1

@gpu
def scientific_gpu_heat_oracle_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var heat: float = sim_scientific_oracle_checksum_heat()
  if heat <= 1.0:
    return 0
  if heat >= 10.0:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if scientific_gpu_md_oracle_smoke() != 1:
    return 1
  if scientific_gpu_heat_oracle_smoke() != 1:
    return 2
  return 0
