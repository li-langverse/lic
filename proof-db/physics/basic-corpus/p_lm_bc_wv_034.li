# P-LM-BC-WV-034: Bernoulli equation: p + (1/2) rho v^2 + rho g h = const along a streamline (steady, inviscid flow).

def bernoulli_variance(p: float) -> float
  requires 0.0 <= p and p <= 1.0
  ensures result == p * (1.0 - p)
  decreases 0
=
  return p * (1.0 - p)

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
