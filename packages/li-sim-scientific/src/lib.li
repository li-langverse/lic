    return run_fea_smoke(d1c)
  if vertical_id == vertical_gaming_rigid():
    var d2: int = detail
    return run_rigid_smoke(d2)
  if vertical_id == vertical_qm_dft():
    var d3: int = detail
    return run_qm_smoke(d3)
  var bad: SimRunResult
  var d4: int = detail
  bad.ok = 0
  bad.algo_id = 0
  bad.vertical_id = vertical_id
  bad.checksum = 0.0
  bad.detail_emitted = d4
  return bad

# WP-SCI-GPU-VENDOR-01 — MD oracle + lig.kernel.md_force_short LKIR launch pilot (PH-ML Wave 12 pattern).
def sim_scientific_use_lkir() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return 1

def sim_scientific_lig_md_kernel_id() -> int
  requires true
  ensures result == lig_kernel_md_force_short()
  decreases 0
=
  return lig_kernel_md_force_short()

def sim_scientific_md_lkir_progress() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if sim_scientific_use_lkir() == 0:
    return 0
  var _md_witness: float = sim_scientific_oracle_checksum_md()
  if lig_kernel_run(sim_scientific_lig_md_kernel_id(), lig_backend_select_auto()) != 0:
    return 0
  if lig_validity_gate_pass(0.999) != 1:
    return 0
  return 1

def sim_scientific_gpu_lkir_launch_pipeline() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if sim_scientific_md_lkir_progress() != 1:
    return 0
  if lig_emit_vendor_progress() != 1:
    return 0
  if lig_emit_vendor_lowering_ready() != 1:
    return 0
  return 1

# WP-SCI-GPU-VENDOR-02 — MD grid device buffer bind + readback parity (tolerance 0.1% via runtime).
def sim_scientific_md_device_buffer_bind_ok() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if lig_md_device_buffer_bind_ok() != 1:
    return 0
  if lig_md_gpu_device_buffer_ready() != 1:
    return 0
  return 1

def sim_scientific_md_device_buffer_parity_ok() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if sim_scientific_md_device_buffer_bind_ok() != 1:
    return 0
  if lig_md_device_buffer_parity_ok() != 1:
    return 0
  return 1

def sim_scientific_gpu_md_device_buffer_pipeline() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if sim_scientific_md_lkir_progress() != 1:
    return 0
  if sim_scientific_md_device_buffer_parity_ok() != 1:
    return 0
  if lig_gpu_device_buffer_ready() != 1:
    return 0
  if lig_emit_vendor_lowering_ready() != 1:
    return 0
  return 1
