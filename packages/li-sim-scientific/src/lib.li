      return run_heat_tier2_registry(algo_id, d1)
  if algo_id >= 205:
    if algo_id <= 210:
      var d1b: int = detail
      return run_cfd_tier2_registry(algo_id, d1b)
  if algo_id >= 211:
    if algo_id <= 216:
      var d1c: int = detail
      return run_fea_tier2_registry(algo_id, d1c)
  if algo_id >= 301:
    if algo_id <= 305:
