extern proc li_rt_volatile_sink_f64(v: float) raises IO -> unit
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var hits: array[64, float]
  var i: int = 0
  while i < 64
    hits[i] = 0.0
    i = i + 1
  distributed for j in 0..<64
    requires disjoint_elem(j, hits)
    ensures true
    decreases 64 - j
  =
    hits[j] = 1.0
  li_rt_volatile_sink_f64(hits[0])
  return 0
