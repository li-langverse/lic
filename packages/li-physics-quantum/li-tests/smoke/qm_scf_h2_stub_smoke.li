# WP-SIM-P2 / lic#478: H2 STO-3G-class SCF stub kernel smoke.
import physics.quantum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_std_physics_quantum_version() != 3:
    return 1
  var e: float = qm_scf_h2_stub_energy()
  if e >= 0.0:
    return 2
  if qm_scf_h2_stub_converged() != 1:
    return 3
  var iters: int = qm_scf_h2_stub_scf_iterations()
  if iters < 1:
    return 4
  if iters > qm_scf_h2_stub_max_iter():
    return 5
  return 0
