# li-container-run public surface — lirun OCI lifecycle (import container.run).

import runtime

def li_container_run_version() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def li_container_run_selftest() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  return lirun_selftest()
