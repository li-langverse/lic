extern proc li_dpar_rank() -> int
  requires true
  ensures result >= 0

extern proc li_dpar_world_size() -> int
  requires true
  ensures result >= 1

extern proc li_dpar_barrier() -> unit
  requires true
  ensures true

def rank() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return li_dpar_rank()

def world_size() -> int
  requires true
  ensures result >= 1
  decreases 0
=
  return li_dpar_world_size()

def barrier() -> unit
  requires true
  ensures true
  decreases 0
=
  li_dpar_barrier()
