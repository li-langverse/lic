import physics.quantum

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var e: float = qm_scf_h2_stub_energy()
  if e >= 0.0:
    return 1
  if qm_scf_h2_stub_converged() != 1:
    return 2
  if qm_scf_h2_stub_iterations() < 1:
    return 3
  if qm_scf_h2_stub_iterations() > 8:
    return 4
  return 0
