def llm_path_bytes_eq(p: bytes, expect: str) -> int raises IO, Alloc
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var right: bytes = expect
  var ln: int = bytes_len(p)
  var rn: int = bytes_len(right)
  if ln != rn:
    return 0
  var i: int = 0
  while i < ln:
    if bytes_byte_at(p, i) != bytes_byte_at(right, i):
      return 0
    i = i + 1
  return 1

def llm_weight_format_from_path(path: str) -> int raises IO, Alloc
  requires true
  ensures result >= 0
  ensures result <= 2
  decreases 0
=
  var p: bytes = path
  var ln: int = bytes_len(p)
  var safetensors: bytes = "fixtures/model.safetensors"
  if ln == bytes_len(safetensors):
    var eq: int = 1
    var i: int = 0
    while i < ln:
      if bytes_byte_at(p, i) != bytes_byte_at(safetensors, i):
        eq = 0
        break
      i = i + 1
    if eq == 1:
      return llm_format_safetensors()
  var safetensors2: bytes = "fixtures/ph-ml-weights/model.safetensors"
  if ln == bytes_len(safetensors2):
    var eq_st2: int = 1
    var i_st2: int = 0
    while i_st2 < ln:
      if bytes_byte_at(p, i_st2) != bytes_byte_at(safetensors2, i_st2):
        eq_st2 = 0
        break
      i_st2 = i_st2 + 1
    if eq_st2 == 1:
      return llm_format_safetensors()
  var gguf: bytes = "fixtures/model.gguf"
  if ln == bytes_len(gguf):
    var eq2: int = 1
    var j: int = 0
    while j < ln:
      if bytes_byte_at(p, j) != bytes_byte_at(gguf, j):
        eq2 = 0
        break
      j = j + 1
    if eq2 == 1:
      return llm_format_gguf()
  var gguf2: bytes = "fixtures/ph-ml-weights/model.gguf"
  if ln == bytes_len(gguf2):
    var eq_g2: int = 1
    var j_g2: int = 0
    while j_g2 < ln:
      if bytes_byte_at(p, j_g2) != bytes_byte_at(gguf2, j_g2):
        eq_g2 = 0
        break
      j_g2 = j_g2 + 1
    if eq_g2 == 1:
      return llm_format_gguf()
  return llm_format_none()

def llm_bytes_eq(a: str, b: str) -> int raises IO, Alloc
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  var left: bytes = a
  var right: bytes = b
  var ln: int = bytes_len(left)
  var rn: int = bytes_len(right)
  if ln != rn:
    return 0
  var i: int = 0
  while i < ln:
    if bytes_byte_at(left, i) != bytes_byte_at(right, i):
      return 0
    i = i + 1
  return 1

def llm_path_is_safetensors_fixture(path: str) -> int raises IO, Alloc
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if llm_weight_format_from_path(path) == llm_format_safetensors():
    return 1
  return 0

