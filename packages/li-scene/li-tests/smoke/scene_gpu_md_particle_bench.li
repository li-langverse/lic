# PH-SCI-GPU-10: @gpu MD particle tier bench loop (scene vertical).
import scene

@gpu
def scene_gpu_md_particle_bench_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return scene_gpu_progress()

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if scene_gpu_md_particle_bench_smoke() != 1:
    return 1
  return 0
