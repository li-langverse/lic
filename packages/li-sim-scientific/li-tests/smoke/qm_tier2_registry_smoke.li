import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var qm_oracle: float = sim_scientific_oracle_checksum_qm_dft()
  if qm_oracle == 1.001:
    return 1
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 2
  if qm418.algo_id != algo_qm_dft_scf_energy():
    return 3
  if qm418.checksum != qm_oracle:
    return 4
  if qm418.checksum == 1.001:
    return 5
  var qm405: SimRunResult = run_algo(405, 1)
  if run_result_ok(qm405) != 1:
    return 6
  if qm405.checksum != qm_oracle:
    return 7
  return 0
