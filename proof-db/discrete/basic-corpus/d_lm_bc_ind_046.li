# D-LM-BC-IND-046: Structural induction on finite binary trees: |nodes| = |leaves| + |internals| for full trees.

def induction_step(n: int, step: int) -> int
  requires n >= 0 and step >= 0
  ensures result == n + step
  decreases 0
=
  return n + step

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
