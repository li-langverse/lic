extern proc li_rt_volatile_sink_f64(v: float) raises IO -> unit
  requires true
  ensures true

def main() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var vmax: float = -100.0
  parallel for i in 0..<64
    reduce(max: vmax)
    requires true
    decreases 64 - i
  =
    if 99.0 > vmax:
      vmax = 99.0
  li_rt_volatile_sink_f64(vmax)
  return 0
