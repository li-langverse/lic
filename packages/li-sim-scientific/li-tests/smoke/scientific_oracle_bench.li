import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var md105: SimRunResult = run_algo(105, 1)
  var md: float = sim_scientific_oracle_checksum_md()
  if run_result_ok(md105) != 1:
    return 2
  if md105.checksum != md:
    return 3
  var cfd210: SimRunResult = run_algo(210, 1)
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  if run_result_ok(cfd210) != 1:
    return 4
  if cfd210.checksum != cfd:
    return 5
  var heat204: SimRunResult = run_algo(204, 1)
  var heat: float = sim_scientific_oracle_checksum_heat()
  if run_result_ok(heat204) != 1:
    return 6
  if heat204.checksum != heat:
    return 7
  return 0
