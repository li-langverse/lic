import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var md_expected: float = sim_scientific_oracle_checksum_md()
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != md_expected:
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat_expected: float = sim_scientific_oracle_checksum_heat()
  var heat201: SimRunResult = run_algo(201, 2)
  if run_result_ok(heat201) != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat201.checksum != heat_expected:
    return 7
  if heat201.checksum == 1.001:
    return 8
  var cfd_expected: float = sim_scientific_oracle_checksum_cfd()
  var cfd206: SimRunResult = run_algo(algo_cfd_simple(), 1)
  if run_result_ok(cfd206) != 1:
    return 9
  if cfd206.algo_id != 206:
    return 10
  if cfd206.checksum != cfd_expected:
    return 11
  if cfd206.checksum == 1.001:
    return 12
  var fea_expected: float = sim_scientific_oracle_checksum_fea()
  var fea214: SimRunResult = run_algo(algo_fea_linear_elasticity(), 0)
  if run_result_ok(fea214) != 1:
    return 13
  if fea214.algo_id != 214:
    return 14
  if fea214.checksum != fea_expected:
    return 15
  if fea214.checksum == 1.001:
    return 16
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 17
  if rigid302.algo_id != 302:
    return 18
  if rigid302.checksum == 1.001:
    return 19
  var echem_expected: float = sim_scientific_oracle_checksum_echem_aimd()
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 20
  if aimd433.algo_id != 433:
    return 21
  if aimd433.checksum == 1.001:
    return 22
  if echem_expected > 0.0:
    if aimd433.checksum != echem_expected:
      return 23
  var gc_expected: float = sim_scientific_oracle_checksum_echem_gc_aimd()
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 24
  if gc434.algo_id != 434:
    return 25
  if gc434.checksum == 1.001:
    return 26
  if gc_expected > 0.0:
    if gc434.checksum != gc_expected:
      return 27
  var sei_expected: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 28
  if sei435.algo_id != 435:
    return 29
  if sei435.checksum == 1.001:
    return 30
  if sei_expected > 0.0:
    if sei435.checksum != sei_expected:
      return 31
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 32
  if qm418.algo_id != 418:
    return 33
  if qm418.checksum == 1.001:
    return 34
  if qm418.vertical_id != vertical_qm_dft():
    return 35
  return 0
