import sim
import sim.scientific

def tier2_check_md() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var md105: SimRunResult = run_algo(105, 1)
  var md_oracle: float = sim_scientific_oracle_checksum_md()
  if md105.checksum != md_oracle:
    return 3
  if md105.ok != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum == 1.001:
    return 4
  return 0

def tier2_check_heat() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var heat201: SimRunResult = run_algo(201, 2)
  var heat_oracle: float = sim_scientific_oracle_checksum_heat()
  if heat201.checksum != heat_oracle:
    return 7
  if heat201.ok != 1:
    return 5
  if heat201.algo_id != 201:
    return 6
  if heat201.checksum == 1.001:
    return 8
  return 0

def tier2_check_rigid() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rigid302: SimRunResult = run_algo(302, 0)
  if rigid302.ok != 1:
    return 9
  if rigid302.algo_id != 302:
    return 10
  if rigid302.checksum == 1.001:
    return 11
  return 0

def tier2_check_cfd() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var cfd206: SimRunResult = run_algo(206, 0)
  var cfd_oracle: float = sim_scientific_oracle_checksum_cfd()
  if cfd206.checksum != cfd_oracle:
    return 34
  if cfd206.ok != 1:
    return 32
  if cfd206.algo_id != 206:
