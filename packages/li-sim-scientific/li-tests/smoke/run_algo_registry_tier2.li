import sim
import sim.scientific

def tier2_check_qm() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var r: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if r.checksum != sim_scientific_oracle_checksum_qm():
    return 1
  if r.algo_id != 418:
    return 2
  return 0

def tier2_check_cfd() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var r: SimRunResult = run_algo(206, 1)
  if r.checksum != sim_scientific_oracle_checksum_cfd():
    return 1
  if r.algo_id != 206:
    return 2
  return 0

def tier2_check_fea() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var r: SimRunResult = run_algo(214, 2)
  if r.checksum != sim_scientific_oracle_checksum_fea():
    return 1
  if r.algo_id != 214:
    return 2
  return 0

# WP-SCI-03 Phase 2: QM (401–432), CFD (205–210), FEA (211–216) tier-2 dispatch.
# MD/heat/rigid/echem covered by scientific_oracle_bench.li and echem_*_smoke.li.
def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if tier2_check_qm() != 0:
    return 41
  if tier2_check_cfd() != 0:
    return 51
  if tier2_check_fea() != 0:
    return 61
  return 0
