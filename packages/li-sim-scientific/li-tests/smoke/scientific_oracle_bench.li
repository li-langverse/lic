import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if run_result_ok(md_run) != 1:
    return 6
  if md_run.checksum == 1.001:
    return 2
  var heat_run: SimRunResult = run_heat_smoke(0)
  if run_result_ok(heat_run) != 1:
    return 8
  if heat_run.checksum == 1.001:
    return 4
  var cfd_run: SimRunResult = run_algo(210, 0)
  if run_result_ok(cfd_run) != 1:
    return 10
  if cfd_run.checksum == 1.001:
    return 11
  var fea_run: SimRunResult = run_algo(215, 0)
  if run_result_ok(fea_run) != 1:
    return 12
  if fea_run.checksum == 1.001:
    return 13
  return 0
