  var r_mid: float = echem_marcus_rate_stub(0.05)
  var r_hi: float = echem_marcus_rate_stub(0.10)
  if r_lo <= 0.0:
    return 0
  if r_mid <= r_lo:
    return 0
  if r_hi <= r_mid:
    return 0
  return 1

