# WP-CTN-100 — OCI registry pull → runtime bundle (trusted script backend; any OCI v2 registry).

import seam

def container_registry_pull_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_registry_pull(ref: var ptr, bundle_path: var ptr) raises IO -> int
  requires true
  ensures result >= -2
  decreases 0
=
  return container_registry_pull_i(ref, bundle_path)

def container_registry_pull_store(ref: var ptr, container_id: var ptr) raises IO -> int
  requires true
  ensures result >= -2
  decreases 0
=
  return container_registry_pull_to_store_i(ref, container_id)

def container_registry_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_registry_pull_tag() != 1:
    return 1
  return 0
