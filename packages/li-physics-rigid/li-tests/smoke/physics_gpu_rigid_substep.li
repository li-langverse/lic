# PH-SCI-GPU-08: @gpu rigid integrate + overlap smoke.
import physics.rigid

@gpu
def physics_gpu_rigid_substep_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return physics_rigid_gpu_progress()

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if physics_gpu_rigid_substep_smoke() != 1:
    return 1
  return 0
