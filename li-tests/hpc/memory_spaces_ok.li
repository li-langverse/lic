import std.execution.memory_spaces

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if memory_space_host() != 0:
    return 1
  if memory_space_device() != 1:
    return 2
  if memory_space_unified() != 2:
    return 3
  if execution_space_default_tier2() != execution_space_openmp():
    return 4
  if not memory_space_is_valid(memory_space_host()):
    return 5
  if not execution_space_is_valid(execution_space_sycl()):
    return 6
  if memory_space_for_execution(execution_space_cuda()) != memory_space_device():
