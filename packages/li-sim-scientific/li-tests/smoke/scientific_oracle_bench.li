import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if li_sim_scientific_version() != 7:
    return 1
  var cfd: float = sim_scientific_oracle_checksum_cfd()
  if cfd <= 0.0:
    return 2
  var fea: float = sim_scientific_oracle_checksum_fea()
  if fea <= 0.0:
    return 3
  var qm: float = sim_scientific_oracle_checksum_qm_dft()
  if qm == 1.001:
    return 4
  var md_run: SimRunResult = run_md_lj_smoke(0)
  if run_result_ok(md_run) != 1:
    return 5
  if md_run.checksum == 1.001:
    return 6
  var heat_run: SimRunResult = run_heat_smoke(0)
  if run_result_ok(heat_run) != 1:
    return 7
  if heat_run.checksum == 1.001:
    return 8
  return 0
