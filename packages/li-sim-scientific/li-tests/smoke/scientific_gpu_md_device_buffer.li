# PH-SCI-GPU-20: @gpu MD grid device-buffer bind (WP-SCI-GPU-VENDOR-02).
import sim.scientific
import ml

@gpu
def scientific_gpu_md_device_buffer_smoke() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if sim_scientific_md_gpu_device_buffer_pipeline() != 1:
    return 0
  if ml_gpu_device_buffer_pipeline() != 1:
    return 0
  return 1

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if scientific_gpu_md_device_buffer_smoke() != 1:
    return 1
  return 0
