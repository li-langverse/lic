# GT-LM-BC-CON-028: Adding an edge to a connected graph preserves connectivity or creates a cycle.

def connected_edge_lower_bound(v: int) -> int
  requires v >= 1
  ensures result == v - 1
  decreases 0
=
  return v - 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
