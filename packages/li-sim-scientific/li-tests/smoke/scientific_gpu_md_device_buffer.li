# WP-SCI-GPU-VENDOR-02: MD grid device buffer bind + CPU readback parity (0.1% tolerance).
import sim.scientific

def scientific_gpu_md_device_buffer_host_smoke() -> int raises IO
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return sim_scientific_gpu_md_device_buffer_pipeline()

@gpu
def scientific_gpu_md_device_buffer_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  return scientific_gpu_md_device_buffer_host_smoke()

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  if scientific_gpu_md_device_buffer_host_smoke() != 1:
    return 1
  if scientific_gpu_md_device_buffer_smoke() != 1:
    return 2
  return 0
