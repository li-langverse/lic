# M-AX-PEANO-ZERO-NOT-SUCC: Peano — zero is not a successor (∀ n, succ n ≠ 0).

def proof_db_peano_zero_not_succ(n: int)-> int
  requires n >= 0
  ensures not (n == 0) or (result == 0)
  ensures not (n > 0) or (result == 1)
  decreases 0
=
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
