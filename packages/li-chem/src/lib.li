  return echem_neb_reaction_lambda_at(i - 1) + 0.25

def echem_neb_sin_pi_lambda(lam: float) -> float
  requires lam >= 0.0
  requires lam <= 1.0
  ensures result >= 0.0
  ensures result <= 1.0
  decreases 0
=
  return 4.0 * lam * (1.0 - lam)

def echem_neb_climbing_bump_ev(lam: float) -> float
  requires lam >= 0.0
  requires lam <= 1.0
  ensures result >= 0.0
  decreases 0
=
  return 0.73 * echem_neb_sin_pi_lambda(lam)

def echem_neb_image_energy_ev_at(i: int) -> float
  requires i >= 0
  requires i < echem_neb_image_count()
  ensures result == (1.0 - echem_neb_reaction_lambda_at(i)) * echem_dft_energy_at_potential(0.0) + echem_neb_climbing_bump_ev(echem_neb_reaction_lambda_at(i))
  decreases i
=
  var e_is: float = echem_dft_energy_at_potential(0.0)
  var lam: float = echem_neb_reaction_lambda_at(i)
  var e_lin: float = (1.0 - lam) * e_is
  return e_lin + echem_neb_climbing_bump_ev(lam)

def echem_neb_image_energy_at(i: int) -> float
  requires i >= 0
  requires i < echem_neb_image_count()
  ensures result == echem_neb_image_energy_ev_at(i)
  decreases i
=
