# WP-CTN-022 — container runtime error codes (pure Li).

def container_err_ok() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def container_err_io() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_err_bundle_missing() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def container_err_bundle_invalid() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return 3

def container_err_state_missing() -> int
  requires true
  ensures result == 4
  decreases 0
=
  return 4

def container_err_state_invalid() -> int
  requires true
  ensures result == 5
  decreases 0
=
  return 5

def container_err_backend_unsupported() -> int
  requires true
  ensures result == 6
  decreases 0
=
  return 6

def container_err_runtime() -> int
  requires true
  ensures result == 7
  decreases 0
=
  return 7

def container_runerr_from_seam(rc: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if rc == 0:
    return container_err_ok()
  if rc < 0:
    return container_err_io()
  return container_err_runtime()

def container_runerr_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_err_ok() != 0:
    return 1
  if container_err_io() != 1:
    return 2
  if container_err_bundle_missing() != 2:
    return 3
  if container_err_state_missing() != 4:
    return 4
  if container_err_backend_unsupported() != 6:
    return 5
  if container_runerr_from_seam(0) != 0:
    return 6
  if container_runerr_from_seam(-1) != 1:
    return 7
  if container_runerr_from_seam(9) != 7:
    return 8
  return 0
