type Item = object
  public tag: int
  public score: int

type Bundle = object
  public count: int
  public items: array[2, Item]

def sum_item(it: Item) -> int
  requires true
  ensures result == it.tag + it.score
  decreases 0
=
  return it.tag + it.score

def sum_bundle(b: Bundle) -> int
  requires true
  ensures result == sum_item(b.items[0]) + sum_item(b.items[1])
  decreases 0
=
  return sum_item(b.items[0]) + sum_item(b.items[1])

def main() -> int
  requires true
  ensures result == 11
  decreases 0
=
  var b: Bundle
  b.count = 2
  b.items[0].tag = 1
  b.items[0].score = 2
  b.items[1].tag = 3
  b.items[1].score = 5
  return sum_bundle(b)
