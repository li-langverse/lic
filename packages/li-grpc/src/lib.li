def grpc_stub() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0

def grpc_service_tag_cri() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def grpc_service_tag_webhook() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def grpc_unary_call(service_tag: int, method_len: int) -> int
  requires service_tag >= 1
  requires method_len >= 0
  ensures result == 0
  decreases service_tag + method_len
=
  return 0
