# WP-CTN-050 — LiOS container backend (jail + cgroup isolation tags).

def container_lios_backend_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def container_lios_jail_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_lios_cgroup_tag() -> int
  requires true
  ensures result == 2
  decreases 0
=
  return 2

def container_lios_capability_jail() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_lios_capability_cgroup() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_lios_capability_namespaces() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_lios_scheduling_label_tag() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def container_lios_isolation_score() -> int
  requires true
  ensures result == 3
  decreases 0
=
  return container_lios_capability_jail() + container_lios_capability_cgroup() + container_lios_capability_namespaces()

def container_lios_backend_selftest() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if container_lios_backend_tag() != 2:
    return 1
  if container_lios_jail_tag() != 1:
    return 2
  if container_lios_cgroup_tag() != 2:
    return 3
  if container_lios_capability_jail() != 1:
    return 4
  if container_lios_capability_cgroup() != 1:
    return 5
  if container_lios_capability_namespaces() != 1:
    return 6
  if container_lios_scheduling_label_tag() != 1:
    return 7
  if container_lios_isolation_score() != 3:
    return 8
  return 0
