import math.numerics

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var y: float = 1.0
  var y_prev: float = 1.0
  var dt: float = 0.01
  bdf1_step_scalar(y, dt)
  if y <= 0.0:
    return 1
  y_prev = y
  bdf2_step_scalar(y, y_prev, dt)
  if y <= 0.0:
    return 1
  var state: array[2, float]
  var hist: array[2, float]
  state[0] = 1.0
  state[1] = 0.5
  hist[0] = 1.0
  hist[1] = 0.5
  bdf2_step_vec2(state, hist, dt)
  var y_new: float = state[0]
  newton_implicit_step_scalar(y_new, state[0], -1.0, dt)
  if numerics_stiff_ode_bdf_smoke() != 1:
    return 1
  return 0
