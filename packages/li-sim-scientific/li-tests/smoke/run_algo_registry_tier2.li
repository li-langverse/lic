def tier2_check_echem_sei() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if sim_scientific_oracle_checksum_echem_sei_kmc() <= 0.0:
    return 26
  if sim_scientific_oracle_checksum_echem_sei_kmc() >= 0.35:
    return 27
  var r: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  var chk: float = r.checksum
  if chk != sim_scientific_oracle_checksum_echem_sei_kmc():
    return 30
  if chk == 1.001:
    return 31
  if r.algo_id != 435:
    return 29
  if r.ok != 1:
    return 28
  return 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var e: int = tier2_check_md()
  if e != 0:
    return e
  e = tier2_check_heat()
  if e != 0:
    return e
  e = tier2_check_cfd()
  if e != 0:
    return e
  e = tier2_check_fea()
  if e != 0:
    return e
  e = tier2_check_rigid()
  if e != 0:
    return e
  e = tier2_check_qm()
  if e != 0:
    return e
  e = tier2_check_echem_aimd()
  if e != 0:
    return e
  e = tier2_check_echem_gc()
  if e != 0:
    return e
  e = tier2_check_echem_sei()
  if e != 0:
    return e
  return 0
