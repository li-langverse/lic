import sim.automotive

def main() -> int raises IO
  requires true
  ensures result == 0
  decreases 0
=
  var pose: AutomotivePose
  automotive_pose_init(pose)
  pose.speed_mps = 8.0
  sim_automotive_pose_integrate(pose, 0.1, sim_automotive_bicycle_wheelbase_default(), 0.05)
  var tile: AutomotiveMapTile = automotive_map_tile_at(pose, 10.0)
  var odom: float = sim_automotive_odom_checksum(pose, tile)
  if odom <= 0.0:
    return 1
  return 0
