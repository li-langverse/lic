# D-AX-BC-LOG-020: Propositional tautology schema (variant 20).

extern proc d_ax_bc_log_020_axiom_witness() -> int
  requires true
  ensures result == 0
  decreases 0

def d_ax_bc_log_020_tautology(p: bool, q: bool) -> bool
  requires true
  ensures result == (p and q) or (not p) or (not q)
  decreases 0
=
  return (p and q) or (not p) or (not q)

def main() -> int
  requires true
  ensures result == 0
