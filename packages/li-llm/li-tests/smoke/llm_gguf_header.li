import llm

def main() -> int raises IO, Alloc
  requires true
  ensures result == 0
  decreases 0
=
  var w: LlmModelWeights = llm_load_weights("fixtures/ph-ml-weights/model.gguf")
  if w.header_parsed != 1:
    return 1
  if w.tensor_count != 2:
    return 2
  if w.format_tag != llm_format_gguf():
    return 3
  return 0
