# PH-SCI-GPU-14: @gpu additive slicer workflow.
import sim.additive

@gpu
def additive_gpu_slicer_smoke() -> int
  requires true
  ensures result >= 0
  ensures result <= 1
  decreases 0
=
  if run_additive_slicer_workflow(1, 1) != 0:
    return 0
  return 1

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  if additive_gpu_slicer_smoke() != 1:
    return 1
  return 0
