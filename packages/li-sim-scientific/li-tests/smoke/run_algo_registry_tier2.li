import sim
import sim.scientific

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  # WP-SCI-03 oracles before run_result_ok (codegen: object pass + float call ordering).
  var md_oracle: float = sim_scientific_oracle_checksum_md()
  var heat_oracle: float = sim_scientific_oracle_checksum_heat()
  var cfd_oracle: float = sim_scientific_oracle_checksum_cfd()
  var fea_oracle: float = sim_scientific_oracle_checksum_fea()
  var qm_oracle: float = sim_scientific_oracle_checksum_qm_overlap()
  if cfd_oracle <= 0.0:
    return 32
  if fea_oracle <= 0.0:
    return 38
  if qm_oracle <= 0.0:
    return 44
  var md105: SimRunResult = run_algo(105, 1)
  if run_result_ok(md105) != 1:
    return 1
  if md105.algo_id != 105:
    return 2
  if md105.checksum != md_oracle:
    return 3
  if md105.checksum == 1.001:
    return 4
  var heat203: SimRunResult = run_algo(203, 2)
  if run_result_ok(heat203) != 1:
    return 5
  if heat203.algo_id != 203:
    return 6
  if heat203.checksum != heat_oracle:
    return 7
  if heat203.checksum == 1.001:
    return 8
  var cfd206: SimRunResult = run_algo(206, 1)
  if run_result_ok(cfd206) != 1:
    return 33
  if cfd206.algo_id != 206:
    return 34
  if cfd206.checksum != cfd_oracle:
    return 35
  if cfd206.checksum == 1.001:
    return 36
  if cfd206.checksum == heat_oracle:
    return 37
  var fea214: SimRunResult = run_algo(214, 1)
  if run_result_ok(fea214) != 1:
    return 39
  if fea214.algo_id != 214:
    return 40
  if fea214.checksum != fea_oracle:
    return 41
  if fea214.checksum == 1.001:
    return 42
  if fea214.checksum == heat_oracle:
    return 43
  var qm402: SimRunResult = run_algo(402, 0)
  if run_result_ok(qm402) != 1:
    return 45
  if qm402.algo_id != 402:
    return 46
  if qm402.checksum != qm_oracle:
    return 47
  if qm402.checksum == 1.001:
    return 48
  var rigid302: SimRunResult = run_algo(302, 0)
  if run_result_ok(rigid302) != 1:
    return 9
  if rigid302.algo_id != 302:
    return 10
  if rigid302.checksum == 1.001:
    return 11
  var qm418: SimRunResult = run_algo(algo_qm_dft_scf_energy(), 0)
  if run_result_ok(qm418) != 1:
    return 12
  if qm418.checksum != 1.001:
    return 13
  var echem_oracle: float = sim_scientific_oracle_checksum_echem_aimd()
  if echem_oracle <= 0.0:
    return 14
  if echem_oracle >= 1.0e-2:
    return 15
  var aimd433: SimRunResult = run_algo(algo_echem_aimd_interface(), 1)
  if run_result_ok(aimd433) != 1:
    return 16
  if aimd433.algo_id != 433:
    return 17
  if aimd433.checksum != echem_oracle:
    return 18
  if aimd433.checksum == 1.001:
    return 19
  var gc_oracle: float = sim_scientific_oracle_checksum_echem_gc_aimd()
  if gc_oracle <= 0.0:
    return 20
  if gc_oracle >= 0.05:
    return 21
  var gc434: SimRunResult = run_algo(algo_echem_gc_aimd_interface(), 1)
  if run_result_ok(gc434) != 1:
    return 22
  if gc434.algo_id != 434:
    return 23
  if gc434.checksum != gc_oracle:
    return 24
  if gc434.checksum == 1.001:
    return 25
  var sei_oracle: float = sim_scientific_oracle_checksum_echem_sei_kmc()
  if sei_oracle <= 0.0:
    return 26
  if sei_oracle >= 0.35:
    return 27
  var sei435: SimRunResult = run_algo(algo_echem_sei_kmc(), 1)
  if run_result_ok(sei435) != 1:
    return 28
  if sei435.algo_id != 435:
    return 29
  if sei435.checksum != sei_oracle:
    return 30
  if sei435.checksum == 1.001:
    return 31
  return 0
