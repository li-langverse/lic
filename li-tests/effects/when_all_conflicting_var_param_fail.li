async def write_head(buf: var array[2, int]) raises Async -> int
  requires true
  ensures result == 0
  decreases 0
=
  buf[0] = 1
  return 0

async def write_tail(buf: var array[2, int]) raises Async -> int
  requires true
  ensures result == 0
  decreases 0
=
  buf[1] = 2
  return 0

async def merge_same(buf: var array[2, int]) raises Async -> int
  requires true
  ensures result == 0
  decreases 0
=
  await when_all(write_head(buf), write_tail(buf))
  return 0
