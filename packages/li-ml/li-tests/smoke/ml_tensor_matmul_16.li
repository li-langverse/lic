import ml

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[8, array[8, float]]
  var b: array[8, array[8, float]]
  var c: array[8, array[8, float]]
  a[0][0] = 1.0
  b[0][0] = 1.0
  var ad: MlTensorDesc = ml_tensor_desc_2d(8, 8, 8)
  var bd: MlTensorDesc = ml_tensor_desc_2d(8, 8, 8)
  if ml_tensor_matmul_nested(ad, a, bd, b, c) != 1:
    return 1
  if c[0][0] < 0.9 or c[0][0] > 1.1:
    return 2
  return 0
