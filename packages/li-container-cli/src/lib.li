# li-container-cli public surface — CLI scaffold (import container.cli).

import cli

def li_container_cli_version() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def li_container_cli_selftest() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  return container_cli_selftest()
